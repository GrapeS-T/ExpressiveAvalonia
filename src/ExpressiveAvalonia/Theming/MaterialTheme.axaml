<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:theming="clr-namespace:ExpressiveAvalonia.Theming"
        x:Class="ExpressiveAvalonia.Theming.MaterialTheme">
  <Styles.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceInclude Source="avares://ExpressiveAvalonia/Themes/Infrastructure.axaml" />
        <ResourceInclude Source="avares://ExpressiveAvalonia/Themes/Buttons.axaml" />
        <ResourceInclude Source="avares://ExpressiveAvalonia/Themes/TextFields.axaml" />
        <ResourceInclude Source="avares://ExpressiveAvalonia/Themes/Selection.axaml" />
        <ResourceInclude Source="avares://ExpressiveAvalonia/Themes/Sliders.axaml" />
        <ResourceInclude Source="avares://ExpressiveAvalonia/Themes/Progress.axaml" />
        <ResourceInclude Source="avares://ExpressiveAvalonia/Themes/Collections.axaml" />
        <ResourceInclude Source="avares://ExpressiveAvalonia/Themes/Menus.axaml" />
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </Styles.Resources>
  <!-- Keyboard activation is attached only to interactive controls that can carry a tooltip;
       a blanket :is(Control) selector would subscribe every Border and presenter. -->
  <Style Selector=":is(Button), :is(ToggleButton), :is(CheckBox), :is(RadioButton), :is(ToggleSwitch), :is(TextBox), :is(ComboBox), :is(ComboBoxItem), :is(ListBoxItem), :is(MenuItem), :is(TabItem), :is(Slider)">
    <Setter Property="theming:MaterialToolTip.KeyboardEnabled" Value="True" />
  </Style>
  <Style Selector="Window">
    <Setter Property="Background" Value="{DynamicResource MaterialSurfaceBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource MaterialOnSurfaceBrush}" />
    <Setter Property="FontFamily" Value="{DynamicResource MaterialFontFamily}" />
    <Setter Property="FontSize" Value="{DynamicResource MaterialBodyLargeFontSize}" />
    <Setter Property="theming:MaterialMotion.IsReduced" Value="{DynamicResource MaterialReducedMotion}" />
  </Style>
</Styles>
