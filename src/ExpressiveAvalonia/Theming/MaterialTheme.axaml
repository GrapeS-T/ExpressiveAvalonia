<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:theming="clr-namespace:ExpressiveAvalonia.Theming"
        xmlns:controls="using:ExpressiveAvalonia.Controls"
        x:Class="ExpressiveAvalonia.Theming.MaterialTheme">
  <Styles.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceInclude Source="avares://ExpressiveAvalonia/Themes/Infrastructure.axaml" />
        <ResourceInclude Source="avares://ExpressiveAvalonia/Themes/Buttons.axaml" />
        <ResourceInclude Source="avares://ExpressiveAvalonia/Themes/TextFields.axaml" />
        <ResourceInclude Source="avares://ExpressiveAvalonia/Themes/Selection.axaml" />
        <ResourceInclude Source="avares://ExpressiveAvalonia/Themes/Sliders.axaml" />
        <ResourceInclude Source="avares://ExpressiveAvalonia/Themes/Progress.axaml" />
        <ResourceInclude Source="avares://ExpressiveAvalonia/Themes/Collections.axaml" />
        <ResourceInclude Source="avares://ExpressiveAvalonia/Themes/Menus.axaml" />
        <ResourceInclude Source="avares://ExpressiveAvalonia/Themes/AppBars.axaml" />
        <ResourceInclude Source="avares://ExpressiveAvalonia/Themes/NavigationDrawer.axaml" />
        <ResourceInclude Source="avares://ExpressiveAvalonia/Themes/DesignNavigationRail.axaml" />
        <ResourceInclude Source="avares://ExpressiveAvalonia/Themes/DesignDialogs.axaml" />
        <ResourceInclude Source="avares://ExpressiveAvalonia/Themes/DesignTabs.axaml" />
        <ResourceInclude Source="avares://ExpressiveAvalonia/Themes/DesignSheets.axaml" />
        <ResourceInclude Source="avares://ExpressiveAvalonia/Themes/ButtonGroups.axaml" />
        <ResourceInclude Source="avares://ExpressiveAvalonia/Themes/Snackbar.axaml" />
        <ResourceInclude Source="avares://ExpressiveAvalonia/Themes/DesignXR.axaml" />
        <ResourceInclude Source="avares://ExpressiveAvalonia/Themes/DesignFab.axaml" />
        <ResourceInclude Source="avares://ExpressiveAvalonia/Themes/Search.axaml" />
        <ResourceInclude Source="avares://ExpressiveAvalonia/Themes/DesignShapes.axaml" />
        <ResourceInclude Source="avares://ExpressiveAvalonia/Themes/DesignDatePickers.axaml" />
        <ResourceInclude Source="avares://ExpressiveAvalonia/Themes/DesignNavigationBar.axaml" />
        <ResourceInclude Source="avares://ExpressiveAvalonia/Themes/DesignAvatars.axaml" />
        <ResourceInclude Source="avares://ExpressiveAvalonia/Themes/Chips.axaml" />
        <ResourceInclude Source="avares://ExpressiveAvalonia/Themes/DesignTooltips.axaml" />
        <ResourceInclude Source="avares://ExpressiveAvalonia/Themes/DesignCards.axaml" />
        <ResourceInclude Source="avares://ExpressiveAvalonia/Themes/DesignAssets.axaml" />
        <ResourceInclude Source="avares://ExpressiveAvalonia/Themes/DesignCarousel.axaml" />
        <ResourceInclude Source="avares://ExpressiveAvalonia/Themes/DesignTimePickers.axaml" />
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </Styles.Resources>
  <!-- Keyboard activation is attached only to interactive controls that can carry a tooltip;
       a blanket :is(Control) selector would subscribe every Border and presenter. -->
  <Style Selector=":is(Button), :is(ToggleButton), :is(CheckBox), :is(RadioButton), :is(ToggleSwitch), :is(TextBox), :is(ComboBox), :is(ComboBoxItem), :is(ListBoxItem), :is(MenuItem), :is(TabItem), :is(Slider)">
    <Setter Property="theming:MaterialToolTip.KeyboardEnabled" Value="True" />
  </Style>
  <Style Selector="controls|MaterialScrollField">
    <Setter Property="Height" Value="120" />
    <Setter Property="ContainerBrush" Value="{DynamicResource MaterialSurfaceContainerLowestBrush}" />
    <Setter Property="ContentBrush" Value="{DynamicResource MaterialOutlineBrush}" />
    <Setter Property="SelectedContentBrush" Value="{DynamicResource MaterialOnSurfaceBrush}" />
    <Setter Property="FocusRingBrush" Value="{DynamicResource MaterialPrimaryBrush}" />
    <Setter Property="CornerRadius" Value="{DynamicResource MaterialShapeLargeCornerRadius}" />
    <Setter Property="FontFamily" Value="{DynamicResource MaterialFontFamily}" />
  </Style>
  <Style Selector="Window">
    <Setter Property="Background" Value="{DynamicResource MaterialSurfaceBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource MaterialOnSurfaceBrush}" />
    <Setter Property="FontFamily" Value="{DynamicResource MaterialFontFamily}" />
    <Setter Property="FontSize" Value="{DynamicResource MaterialBodyLargeFontSize}" />
    <Setter Property="theming:MaterialMotion.IsReduced" Value="{DynamicResource MaterialReducedMotion}" />
    <Setter Property="theming:MaterialMotion.Scheme" Value="{DynamicResource MaterialMotionScheme}" />
  </Style>
</Styles>
