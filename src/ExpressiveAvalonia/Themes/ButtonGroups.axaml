<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:controls="using:ExpressiveAvalonia.Controls"
                    xmlns:theming="using:ExpressiveAvalonia.Theming"
                    xmlns:data="using:Avalonia.Data.Converters">
  <!-- Button group family: standard (separated action buttons), connected (2-DIP joined segments),
       segmented (overlapping 1-DIP outline with the animated check mark) and split buttons.
       Geometry comes from the pinned source: standard 12 DIP gap (ButtonGroupSmallTokens), 2 DIP
       connected gap, segmented -1 DIP overlap, 40 DIP containers inside 48 DIP targets,
       connected inner corners 8 DIP resting / 4 DIP pressed / full when selected, and 5 split
       button sizes with a 2-DIP seam.
       State layers and the press ripple are the shared MaterialRipple (source RippleNode), so no
       finite pressed overlay doubles the alpha.
       Corner morphs are frame-driven springs in the controls (FastSpatial for buttons, DefaultEffects
       for split buttons), so the template only renders the current CornerRadius.
       Disabled composition uses the pinned per-component tokens: OnSurface container at 10/12
       percent, OnSurfaceVariant content at 38 percent, OutlineVariant outline for outlined
       variants. -->

  <ControlTheme x:Key="MaterialButtonGroupItemTheme" TargetType="controls:MaterialButtonGroupItem">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{DynamicResource MaterialOnSurfaceBrush}" />
    <Setter Property="BorderBrush" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="CornerRadius" Value="{DynamicResource MaterialShapeFullCornerRadius}" />
    <Setter Property="FontFamily" Value="{DynamicResource MaterialFontFamily}" />
    <Setter Property="FontSize" Value="{DynamicResource MaterialLabelLargeFontSize}" />
    <Setter Property="FontWeight" Value="{DynamicResource MaterialLabelLargeFontWeight}" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="Focusable" Value="True" />
    <Setter Property="Template">
      <ControlTemplate>
        <Panel Background="Transparent">
          <Panel Name="ContainerHost" Margin="{TemplateBinding ContainerInset}">
            <Border Name="Surface"
                    Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="{TemplateBinding CornerRadius}" />
          </Panel>

          <!-- One presenter owns each caller-provided visual across all group kinds. -->
          <StackPanel Name="ContentHost" Orientation="Horizontal"
                      HorizontalAlignment="Center" VerticalAlignment="Center"
                      Margin="{TemplateBinding Padding}">
            <Panel Name="IconSlot" Height="{TemplateBinding IconSize}">
              <Viewbox Name="IconView" Width="{TemplateBinding IconSize}" Height="{TemplateBinding IconSize}"
                       Stretch="Uniform" HorizontalAlignment="Left">
                <ContentPresenter Content="{TemplateBinding Icon}" />
              </Viewbox>
              <Path Name="PART_SegmentedCheckMark" Width="{TemplateBinding IconSize}"
                    Height="{TemplateBinding IconSize}" Data="M2,9 L7,14 L16,3"
                    Stroke="{TemplateBinding Foreground}" StrokeThickness="2"
                    StrokeLineCap="Round" StrokeJoin="Round" Stretch="Uniform"
                    HorizontalAlignment="Left" RenderTransformOrigin="0%,100%" />
            </Panel>
            <Path Name="PART_CheckMark" Width="{TemplateBinding IconSize}" Height="{TemplateBinding IconSize}"
                  Data="M2,9 L7,14 L16,3" Stroke="{TemplateBinding Foreground}" StrokeThickness="2"
                  StrokeLineCap="Round" StrokeJoin="Round" Stretch="Uniform"
                  RenderTransformOrigin="0%,100%" />
            <ContentPresenter Name="PART_ContentPresenter" Content="{TemplateBinding Content}"
                              ContentTemplate="{TemplateBinding ContentTemplate}"
                              IsVisible="{Binding Content, RelativeSource={RelativeSource TemplatedParent}, Converter={x:Static data:ObjectConverters.IsNotNull}}"
                              VerticalAlignment="Center" RecognizesAccessKey="True">
              <ContentPresenter.RenderTransform>
                <TranslateTransform X="{Binding SegmentedContentOffset, RelativeSource={RelativeSource TemplatedParent}}" />
              </ContentPresenter.RenderTransform>
            </ContentPresenter>
          </StackPanel>

          <!-- Source RippleNode: the shared MaterialRipple draws the hover/focus state layer and
               the bounded press ripple above the content. It is clipped to the container inset so
               the 48 DIP target of a compact item does not become part of the visual shape. -->
          <theming:MaterialRipple Name="StateLayer"
                                  Margin="{TemplateBinding ContainerInset}"
                                  Fill="{TemplateBinding Foreground}"
                                  CornerRadius="{TemplateBinding CornerRadius}"
                                  PressOpacity="{DynamicResource MaterialPressedStateLayerOpacity}"
                                  HoverOpacity="{DynamicResource MaterialHoverStateLayerOpacity}"
                                  FocusOpacity="{DynamicResource MaterialFocusStateLayerOpacity}"
                                  EnableDrag="False"
                                  IsHitTestVisible="False" />

          <Border Name="FocusRing" Margin="-4"
                  CornerRadius="{TemplateBinding CornerRadius}"
                  BorderBrush="{DynamicResource MaterialSecondaryBrush}"
                  BorderThickness="3" IsVisible="False" IsHitTestVisible="False" />
        </Panel>
      </ControlTemplate>
    </Setter>
    <Style Selector="^ /template/ StackPanel#ContentHost">
      <Setter Property="Spacing" Value="{Binding ContentSpacing, RelativeSource={RelativeSource TemplatedParent}}" />
    </Style>
    <Style Selector="^ /template/ Panel#IconSlot">
      <Setter Property="Width" Value="{Binding IconSize, RelativeSource={RelativeSource TemplatedParent}}" />
      <Setter Property="IsVisible" Value="{Binding ShowIconContent, RelativeSource={RelativeSource TemplatedParent}}" />
    </Style>
    <Style Selector="^ /template/ Path#PART_CheckMark">
      <Setter Property="IsVisible" Value="{Binding ShowCheckIcon, RelativeSource={RelativeSource TemplatedParent}}" />
    </Style>
    <Style Selector="^ /template/ Path#PART_SegmentedCheckMark">
      <Setter Property="IsVisible" Value="False" />
    </Style>

    <!-- Labels never wrap in the source button group: the item grows to its intrinsic width and
         the group moves items into the overflow menu when they no longer fit. -->
    <Style Selector="^ /template/ ContentPresenter TextBlock">
      <Setter Property="TextWrapping" Value="NoWrap" />
      <Setter Property="TextTrimming" Value="None" />
    </Style>

    <!-- Standard group: separated action buttons. Filled uses the surface-container container. -->
    <Style Selector="^[Kind=Standard][Variant=Filled]">
      <Setter Property="Background" Value="{DynamicResource MaterialSurfaceContainerBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource MaterialOnSurfaceVariantBrush}" />
    </Style>
    <Style Selector="^[Kind=Standard][Variant=Tonal]">
      <Setter Property="Background" Value="{DynamicResource MaterialSecondaryContainerBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource MaterialOnSecondaryContainerBrush}" />
    </Style>
    <Style Selector="^[Kind=Standard][Variant=Outlined]">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Foreground" Value="{DynamicResource MaterialOnSurfaceVariantBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource MaterialOutlineVariantBrush}" />
      <Setter Property="BorderThickness" Value="1" />
    </Style>
    <Style Selector="^[Kind=Standard][Variant=Elevated]">
      <Setter Property="Background" Value="{DynamicResource MaterialSurfaceContainerLowBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource MaterialPrimaryBrush}" />
    </Style>
    <Style Selector="^[Kind=Standard][Variant=Elevated] /template/ Border#Surface">
      <Setter Property="BoxShadow" Value="{DynamicResource MaterialElevationLevel1Shadow}" />
    </Style>
    <Style Selector="^[Kind=Standard][Variant=Text], ^[Kind=Standard][Variant=Standard]">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Foreground" Value="{DynamicResource MaterialOnSurfaceVariantBrush}" />
    </Style>

    <!-- Connected group: secondary container at rest; secondary with on-secondary when checked.
         The seam corners morph on press (8 -> 4 DIP inner radius). -->
    <Style Selector="^[Kind=Connected]">
      <Setter Property="Background" Value="{DynamicResource MaterialSecondaryContainerBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource MaterialOnSecondaryContainerBrush}" />
    </Style>
    <Style Selector="^[Kind=Connected]:checked">
      <Setter Property="Background" Value="{DynamicResource MaterialSecondaryBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource MaterialOnSecondaryBrush}" />
    </Style>

    <!-- Segmented: outlined container of the size's minimum, secondary container when selected.
         Each segment owns its 1-DIP outline; the -1-DIP row spacing makes adjacent strokes
         coincide, and the group raises the checked/pressed segment above its neighbours. -->
    <Style Selector="^[Kind=Segmented]">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Foreground" Value="{DynamicResource MaterialOnSurfaceBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource MaterialOutlineBrush}" />
      <Setter Property="BorderThickness" Value="1" />
    </Style>
    <Style Selector="^[Kind=Segmented]:checked">
      <Setter Property="Background" Value="{DynamicResource MaterialSecondaryContainerBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource MaterialOnSecondaryContainerBrush}" />
    </Style>
    <Style Selector="^[Kind=Segmented] /template/ StackPanel#ContentHost">
      <Setter Property="Spacing" Value="0" />
    </Style>
    <Style Selector="^[Kind=Segmented] /template/ Panel#IconSlot">
      <Setter Property="Width" Value="{Binding SegmentedIconSlotWidth, RelativeSource={RelativeSource TemplatedParent}}" />
      <Setter Property="IsVisible" Value="True" />
    </Style>
    <Style Selector="^[Kind=Segmented] /template/ Viewbox#IconView">
      <Setter Property="IsVisible" Value="{Binding ShowIconSlot, RelativeSource={RelativeSource TemplatedParent}}" />
      <Setter Property="Opacity" Value="{Binding ContentIconOpacity, RelativeSource={RelativeSource TemplatedParent}}" />
    </Style>
    <Style Selector="^[Kind=Segmented] /template/ Path#PART_CheckMark">
      <Setter Property="IsVisible" Value="False" />
    </Style>
    <Style Selector="^[Kind=Segmented] /template/ Path#PART_SegmentedCheckMark">
      <Setter Property="IsVisible" Value="{Binding ShowCheckIcon, RelativeSource={RelativeSource TemplatedParent}}" />
    </Style>
    <Style Selector="^[Kind=Segmented] /template/ Border#FocusRing">
      <Setter Property="IsVisible" Value="False" />
    </Style>

    <!-- Standard sizes: 48/48/56/96/136 DIP targets with 32/40/56/96/136 DIP containers. -->
    <Style Selector="^[Kind=Standard]">
      <Setter Property="MinWidth" Value="48" />
    </Style>
    <Style Selector="^[Kind=Standard][ControlSize=ExtraSmall]">
      <Setter Property="Padding" Value="12,6" />
      <Setter Property="IconSize" Value="20" />
      <Setter Property="ContentSpacing" Value="8" />
      <Setter Property="FontSize" Value="{DynamicResource MaterialLabelLargeFontSize}" />
      <Setter Property="FontWeight" Value="{DynamicResource MaterialLabelLargeFontWeight}" />
    </Style>
    <Style Selector="^[Kind=Standard][ControlSize=Small]">
      <Setter Property="Padding" Value="16,10" />
      <Setter Property="IconSize" Value="20" />
      <Setter Property="ContentSpacing" Value="8" />
      <Setter Property="FontSize" Value="{DynamicResource MaterialLabelLargeFontSize}" />
      <Setter Property="FontWeight" Value="{DynamicResource MaterialLabelLargeFontWeight}" />
    </Style>
    <Style Selector="^[Kind=Standard][ControlSize=Medium]">
      <Setter Property="Padding" Value="24,16" />
      <Setter Property="IconSize" Value="24" />
      <Setter Property="ContentSpacing" Value="8" />
      <Setter Property="FontSize" Value="{DynamicResource MaterialTitleMediumFontSize}" />
      <Setter Property="FontWeight" Value="{DynamicResource MaterialTitleMediumFontWeight}" />
    </Style>
    <Style Selector="^[Kind=Standard][ControlSize=Medium] /template/ ContentPresenter#PART_ContentPresenter">
    </Style>
    <Style Selector="^[Kind=Standard][ControlSize=Large]">
      <Setter Property="Padding" Value="48,32" />
      <Setter Property="IconSize" Value="32" />
      <Setter Property="ContentSpacing" Value="12" />
      <Setter Property="FontSize" Value="{DynamicResource MaterialHeadlineSmallFontSize}" />
      <Setter Property="FontWeight" Value="{DynamicResource MaterialHeadlineSmallFontWeight}" />
    </Style>
    <Style Selector="^[Kind=Standard][ControlSize=Large] /template/ ContentPresenter#PART_ContentPresenter">
    </Style>
    <Style Selector="^[Kind=Standard][ControlSize=ExtraLarge]">
      <Setter Property="Padding" Value="64,48" />
      <Setter Property="IconSize" Value="40" />
      <Setter Property="ContentSpacing" Value="16" />
      <Setter Property="FontSize" Value="{DynamicResource MaterialHeadlineLargeFontSize}" />
      <Setter Property="FontWeight" Value="{DynamicResource MaterialHeadlineLargeFontWeight}" />
    </Style>
    <Style Selector="^[Kind=Standard][ControlSize=ExtraLarge] /template/ ContentPresenter#PART_ContentPresenter">
    </Style>
    <!-- Icon-only standard items are icon buttons: 40/52/72/128/184 DIP square targets. -->
    <Style Selector="^[Kind=Standard][IsIconOnly=True]">
      <Setter Property="Padding" Value="0" />
    </Style>
    <Style Selector="^[Kind=Standard][IsIconOnly=True][ControlSize=ExtraSmall]">
      <Setter Property="MinWidth" Value="40" />
    </Style>
    <Style Selector="^[Kind=Standard][IsIconOnly=True][ControlSize=Small]">
      <Setter Property="MinWidth" Value="52" />
    </Style>
    <Style Selector="^[Kind=Standard][IsIconOnly=True][ControlSize=Medium]">
      <Setter Property="MinWidth" Value="72" />
    </Style>
    <Style Selector="^[Kind=Standard][IsIconOnly=True][ControlSize=Large]">
      <Setter Property="MinWidth" Value="128" />
    </Style>
    <Style Selector="^[Kind=Standard][IsIconOnly=True][ControlSize=ExtraLarge]">
      <Setter Property="MinWidth" Value="184" />
    </Style>

    <!-- Connected sizes: segment heights 32/40/56/96/136 with the size's label padding. -->
    <Style Selector="^[Kind=Connected]">
      <Setter Property="MinWidth" Value="48" />
    </Style>
    <Style Selector="^[Kind=Connected][ControlSize=ExtraSmall]">
      <Setter Property="Padding" Value="12,0" />
      <Setter Property="IconSize" Value="20" />
      <Setter Property="ContentSpacing" Value="8" />
      <Setter Property="FontSize" Value="{DynamicResource MaterialLabelLargeFontSize}" />
      <Setter Property="FontWeight" Value="{DynamicResource MaterialLabelLargeFontWeight}" />
    </Style>
    <Style Selector="^[Kind=Connected][ControlSize=Small]">
      <Setter Property="Padding" Value="16,0" />
      <Setter Property="IconSize" Value="20" />
      <Setter Property="ContentSpacing" Value="8" />
      <Setter Property="FontSize" Value="{DynamicResource MaterialLabelLargeFontSize}" />
      <Setter Property="FontWeight" Value="{DynamicResource MaterialLabelLargeFontWeight}" />
    </Style>
    <Style Selector="^[Kind=Connected][ControlSize=Medium]">
      <Setter Property="Padding" Value="20,0" />
      <Setter Property="IconSize" Value="24" />
      <Setter Property="ContentSpacing" Value="8" />
      <Setter Property="FontSize" Value="{DynamicResource MaterialTitleMediumFontSize}" />
      <Setter Property="FontWeight" Value="{DynamicResource MaterialTitleMediumFontWeight}" />
    </Style>
    <Style Selector="^[Kind=Connected][ControlSize=Medium] /template/ ContentPresenter#PART_ContentPresenter">
    </Style>
    <Style Selector="^[Kind=Connected][ControlSize=Large]">
      <Setter Property="Padding" Value="32,0" />
      <Setter Property="IconSize" Value="32" />
      <Setter Property="ContentSpacing" Value="12" />
      <Setter Property="FontSize" Value="{DynamicResource MaterialHeadlineSmallFontSize}" />
      <Setter Property="FontWeight" Value="{DynamicResource MaterialHeadlineSmallFontWeight}" />
    </Style>
    <Style Selector="^[Kind=Connected][ControlSize=Large] /template/ ContentPresenter#PART_ContentPresenter">
    </Style>
    <Style Selector="^[Kind=Connected][ControlSize=ExtraLarge]">
      <Setter Property="Padding" Value="48,0" />
      <Setter Property="IconSize" Value="40" />
      <Setter Property="ContentSpacing" Value="16" />
      <Setter Property="FontSize" Value="{DynamicResource MaterialHeadlineLargeFontSize}" />
      <Setter Property="FontWeight" Value="{DynamicResource MaterialHeadlineLargeFontWeight}" />
    </Style>
    <Style Selector="^[Kind=Connected][ControlSize=ExtraLarge] /template/ ContentPresenter#PART_ContentPresenter">
    </Style>

    <!-- Segmented: ButtonDefaults.MinWidth 58, 18 DIP icon, 12 DIP horizontal content padding,
         40 DIP container; the density axis (Avalonia extension) lowers it by 4 DIP per step. -->
    <Style Selector="^[Kind=Segmented]">
      <Setter Property="MinWidth" Value="58" />
      <Setter Property="Padding" Value="12,0" />
      <Setter Property="IconSize" Value="18" />
      <Setter Property="ContentSpacing" Value="8" />
      <Setter Property="FontSize" Value="{DynamicResource MaterialLabelLargeFontSize}" />
      <Setter Property="FontWeight" Value="{DynamicResource MaterialLabelLargeFontWeight}" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
    </Style>

    <Style Selector="^:focus-visible /template/ Border#FocusRing">
      <Setter Property="IsVisible" Value="True" />
    </Style>

    <!-- Disabled: OnSurface container at the component opacity, OnSurfaceVariant content at 38%,
         outlined variants keep a full-opacity OutlineVariant stroke and no container. -->
    <Style Selector="^:disabled">
      <Setter Property="Foreground" Value="{DynamicResource MaterialOnSurfaceVariantBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource MaterialOutlineVariantBrush}" />
    </Style>
    <Style Selector="^:disabled /template/ Border#Surface">
      <Setter Property="Background" Value="{DynamicResource MaterialOnSurfaceBrush}" />
      <Setter Property="Opacity" Value="0.10" />
      <Setter Property="BoxShadow" Value="{DynamicResource MaterialElevationLevel0Shadow}" />
    </Style>
    <Style Selector="^[Kind=Standard][Variant=Tonal]:disabled /template/ Border#Surface">
      <Setter Property="Opacity" Value="0.12" />
    </Style>
    <Style Selector="^:disabled /template/ StackPanel#ContentHost">
      <Setter Property="Opacity" Value="0.38" />
    </Style>
    <Style Selector="^:disabled /template/ StackPanel#SegmentedContentHost">
      <Setter Property="Opacity" Value="0.38" />
    </Style>
    <Style Selector="^:disabled /template/ theming|MaterialRipple#StateLayer">
      <Setter Property="Opacity" Value="0" />
    </Style>
    <Style Selector="^:disabled /template/ Border#FocusRing">
      <Setter Property="IsVisible" Value="False" />
    </Style>
    <Style Selector="^[Kind=Standard][Variant=Outlined]:disabled">
      <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style Selector="^[Kind=Standard][Variant=Outlined]:disabled /template/ Border#Surface">
      <Setter Property="Opacity" Value="0" />
    </Style>
    <Style Selector="^[Kind=Standard][Variant=Outlined]:disabled /template/ Border#Surface">
      <Setter Property="BorderBrush" Value="Transparent" />
    </Style>
    <Style Selector="^[Kind=Segmented]:disabled">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="{DynamicResource MaterialOnSurfaceBrush}" />
      <Setter Property="BorderThickness" Value="1" />
    </Style>
    <Style Selector="^[Kind=Segmented]:disabled /template/ Border#Surface">
      <Setter Property="Opacity" Value="0" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="Transparent" />
    </Style>
  </ControlTheme>

  <ControlTheme x:Key="{x:Type controls:MaterialButtonGroupItem}" TargetType="controls:MaterialButtonGroupItem"
                BasedOn="{StaticResource MaterialButtonGroupItemTheme}" />

  <!-- The overflow indicator is the source's filled icon button: 48 DIP target, 40 DIP full-round
       container in the primary color, 24 DIP glyph. -->
  <ControlTheme x:Key="MaterialButtonGroupOverflowButton" TargetType="Button">
    <Setter Property="Width" Value="48" />
    <Setter Property="Height" Value="48" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{DynamicResource MaterialOnPrimaryBrush}" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="Template">
      <ControlTemplate>
        <Panel Background="Transparent">
          <Border Name="OverflowSurface" Margin="4" CornerRadius="9999"
                  Background="{DynamicResource MaterialPrimaryBrush}" />
          <Path Width="18" Height="4" Stretch="Fill"
                Data="M0,0 L3.6,0 L3.6,3.6 L0,3.6 Z M7.2,0 L10.8,0 L10.8,3.6 L7.2,3.6 Z M14.4,0 L18,0 L18,3.6 L14.4,3.6 Z"
                Fill="{DynamicResource MaterialOnPrimaryBrush}"
                HorizontalAlignment="Center" VerticalAlignment="Center" />
          <!-- The overflow indicator is a FilledIconButton upstream: the shared ripple replaces
               the finite overlay so hover/focus/press all use RippleNode. -->
          <theming:MaterialRipple Name="OverflowStateLayer"
                                  Margin="4" CornerRadius="9999"
                                  Fill="{DynamicResource MaterialOnPrimaryBrush}"
                                  PressOpacity="{DynamicResource MaterialPressedStateLayerOpacity}"
                                  HoverOpacity="{DynamicResource MaterialHoverStateLayerOpacity}"
                                  FocusOpacity="{DynamicResource MaterialFocusStateLayerOpacity}"
                                  EnableDrag="False"
                                  IsHitTestVisible="False" />
          <Border Name="OverflowFocusRing" Margin="2" CornerRadius="9999"
                  BorderBrush="{DynamicResource MaterialSecondaryBrush}" BorderThickness="3"
                  IsVisible="False" />
        </Panel>
      </ControlTemplate>
    </Setter>
    <Style Selector="^:focus-visible /template/ Border#OverflowFocusRing">
      <Setter Property="IsVisible" Value="True" />
    </Style>
  </ControlTheme>

  <ControlTheme x:Key="MaterialButtonGroupBase" TargetType="controls:MaterialButtonGroup">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Focusable" Value="False" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="Template">
      <ControlTemplate>
        <Panel Background="{TemplateBinding Background}">
          <Grid ColumnDefinitions="Auto,Auto" RowDefinitions="Auto">
            <ItemsPresenter Name="PART_ItemsPresenter" Grid.Column="0"
                            ItemsPanel="{TemplateBinding ItemsPanel}"
                            Margin="{TemplateBinding Padding}" />
            <Button Name="PART_OverflowButton" Grid.Column="1"
                    Theme="{StaticResource MaterialButtonGroupOverflowButton}"
                    Margin="12,0,0,0" IsVisible="False"
                    VerticalAlignment="Center" />
          </Grid>
        </Panel>
      </ControlTemplate>
    </Setter>
    <!-- The segmented row reserves 4 DIP above and below its 40-DIP container so the row keeps
         the 48-DIP interactive target; the density extension lowers the container. -->
    <Style Selector="^[Kind=Segmented]">
      <Setter Property="Padding" Value="0,4" />
    </Style>
  </ControlTheme>

  <ControlTheme x:Key="{x:Type controls:MaterialButtonGroup}" TargetType="controls:MaterialButtonGroup"
                BasedOn="{StaticResource MaterialButtonGroupBase}" />

  <ControlTheme x:Key="{x:Type controls:MaterialSegmentedButton}" TargetType="controls:MaterialSegmentedButton"
                BasedOn="{StaticResource MaterialButtonGroupBase}" />

  <!-- The two halves of a split button. Each half is a real Button, so it keeps native focus,
       Space/Enter activation and automation; the parent supplies colors and corner radii. The
       theme is also applied to the trailing ToggleButton subclass, whose checked state paints the
       same 10% content layer. -->
  <ControlTheme x:Key="MaterialSplitButtonSegment" TargetType="Button">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{DynamicResource MaterialOnSurfaceBrush}" />
    <Setter Property="BorderBrush" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="Template">
      <ControlTemplate>
        <Panel Background="Transparent">
          <Border Name="SegmentSurface"
                  Background="{TemplateBinding Background}"
                  BorderBrush="{TemplateBinding BorderBrush}"
                  BorderThickness="{TemplateBinding BorderThickness}"
                  CornerRadius="{TemplateBinding CornerRadius}" />
          <theming:MaterialRipple Name="SegmentStateLayer"
                                  Fill="{TemplateBinding Foreground}"
                                  CornerRadius="{TemplateBinding CornerRadius}"
                                  EnableDrag="False" IsHitTestVisible="False" />
          <ContentPresenter Name="PART_ContentPresenter"
                            Content="{TemplateBinding Content}"
                            ContentTemplate="{TemplateBinding ContentTemplate}"
                            HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                            VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"
                            Margin="{TemplateBinding Padding}"
                            RecognizesAccessKey="True" />
          <!-- SplitButton.TrailingButton draws its checked layer after Surface content;
               it is selected paint, independent of the press ripple. The checked variant
               (no flyout) and the open menu both use the same 10% content-colored layer. -->
          <Border Name="SegmentCheckedLayer" Background="{TemplateBinding Foreground}"
                  CornerRadius="{TemplateBinding CornerRadius}" Opacity="0" IsHitTestVisible="False" />
          <Border Name="SegmentFocusRing" Margin="-4"
                  CornerRadius="{TemplateBinding CornerRadius}"
                  BorderBrush="{DynamicResource MaterialSecondaryBrush}"
                  BorderThickness="3" IsVisible="False" IsHitTestVisible="False" />
        </Panel>
      </ControlTemplate>
    </Setter>
    <Style Selector="^:focus-visible /template/ Border#SegmentFocusRing">
      <Setter Property="IsVisible" Value="True" />
    </Style>
    <!-- The checked (independent trailing state) half keeps the source's 10% content-colored layer. -->
    <Style Selector="^.checked /template/ Border#SegmentCheckedLayer">
      <Setter Property="Opacity" Value="0.10" />
    </Style>
    <!-- The open menu keeps the same checked paint and rotates the chevron. -->
    <Style Selector="^.menuopen /template/ Border#SegmentCheckedLayer">
      <Setter Property="Opacity" Value="0.10" />
    </Style>
    <Style Selector="^ /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="RenderTransform" Value="rotate(0deg)" />
      <Setter Property="RenderTransformOrigin" Value="50%,50%" />
      <Setter Property="Transitions">
        <Transitions>
          <TransformOperationsTransition Property="RenderTransform" Duration="{DynamicResource MaterialDurationShort3}" Easing="0.2,0,0,1" />
        </Transitions>
      </Setter>
    </Style>
    <Style Selector="^.menuopen /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="RenderTransform" Value="rotate(180deg)" />
    </Style>
    <!-- Button disabled composition: OnSurface container at 10%, content at 38%, outlined keeps
         its full-opacity OutlineVariant stroke. -->
    <Style Selector="^:disabled /template/ Border#SegmentCheckedLayer">
      <Setter Property="Opacity" Value="0" />
    </Style>
    <Style Selector="^:disabled /template/ ContentPresenter">
      <Setter Property="Opacity" Value="0.38" />
    </Style>
    <Style Selector="^:disabled /template/ Border#SegmentFocusRing">
      <Setter Property="IsVisible" Value="False" />
    </Style>
    <Style Selector="^.dimmed:disabled /template/ Border#SegmentSurface">
      <Setter Property="Background" Value="{DynamicResource MaterialOnSurfaceBrush}" />
      <Setter Property="Opacity" Value="0.10" />
    </Style>
  </ControlTheme>

  <ControlTheme x:Key="{x:Type controls:MaterialSplitButton}" TargetType="controls:MaterialSplitButton">
    <Setter Property="Background" Value="{DynamicResource MaterialPrimaryBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource MaterialOnPrimaryBrush}" />
    <Setter Property="BorderBrush" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="FontFamily" Value="{DynamicResource MaterialFontFamily}" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="Template">
      <ControlTemplate>
        <Panel Background="Transparent">
          <Border Name="Container" Background="Transparent"
                  CornerRadius="{TemplateBinding CornerRadius}"
                  Margin="{TemplateBinding Padding}">
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="2">
              <Button Name="PART_PrimaryButton" Grid.Column="0"
                      Theme="{StaticResource MaterialSplitButtonSegment}"
                      Background="{TemplateBinding Background}"
                      Foreground="{TemplateBinding Foreground}"
                      BorderBrush="{TemplateBinding BorderBrush}"
                      BorderThickness="{TemplateBinding BorderThickness}"
                      HorizontalAlignment="Stretch">
                <Button.Content>
                  <StackPanel Orientation="Horizontal" VerticalAlignment="Center"
                              Spacing="{Binding ContentSpacing, RelativeSource={RelativeSource AncestorType=controls:MaterialSplitButton}}">
                    <Viewbox Width="{Binding IconSize, RelativeSource={RelativeSource AncestorType=controls:MaterialSplitButton}}"
                             Height="{Binding IconSize, RelativeSource={RelativeSource AncestorType=controls:MaterialSplitButton}}"
                             Stretch="Uniform"
                             IsVisible="{Binding Icon, RelativeSource={RelativeSource AncestorType=controls:MaterialSplitButton}, Converter={x:Static data:ObjectConverters.IsNotNull}}">
                      <ContentPresenter Content="{Binding Icon, RelativeSource={RelativeSource AncestorType=controls:MaterialSplitButton}}" />
                    </Viewbox>
                    <ContentPresenter
                        Content="{Binding Content, RelativeSource={RelativeSource AncestorType=controls:MaterialSplitButton}}"
                        ContentTemplate="{Binding ContentTemplate, RelativeSource={RelativeSource AncestorType=controls:MaterialSplitButton}}"
                        VerticalAlignment="Center" RecognizesAccessKey="True" />
                  </StackPanel>
                </Button.Content>
              </Button>
              <controls:MaterialSplitButtonTrailingButton Name="PART_TrailingButton" Grid.Column="1"
                      Theme="{StaticResource MaterialSplitButtonSegment}"
                      Background="{TemplateBinding Background}"
                      Foreground="{TemplateBinding Foreground}"
                      BorderBrush="{TemplateBinding BorderBrush}"
                      BorderThickness="{TemplateBinding BorderThickness}">
                <Button.Content>
                  <!-- The trailing half is optically centered: its inner start corners are smaller
                       than its outer end corners, so the source shifts the content by
                       0.11 * (averageStartRadius - averageEndRadius), clamped by the trailing
                       content padding. -->
                  <theming:MaterialOpticalCenterDecorator
                      CornerRadius="{Binding #PART_TrailingButton.CornerRadius}"
                      MaxStartOffset="{Binding TrailingContentPaddingStart, RelativeSource={RelativeSource AncestorType=controls:MaterialSplitButton}}"
                      MaxEndOffset="{Binding TrailingContentPaddingEnd, RelativeSource={RelativeSource AncestorType=controls:MaterialSplitButton}}">
                    <Viewbox Width="{Binding TrailingIconSize, RelativeSource={RelativeSource AncestorType=controls:MaterialSplitButton}}"
                             Height="{Binding TrailingIconSize, RelativeSource={RelativeSource AncestorType=controls:MaterialSplitButton}}"
                             Stretch="Uniform">
                      <Path Width="11" Height="7"
                            Data="M5.5,6.7866 L0,1.2866 L1.283,0.0033 L5.5,4.22 L9.717,0.0033 L11,1.2866 Z"
                            Stretch="Fill"
                            Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=controls:MaterialSplitButton}}" />
                    </Viewbox>
                  </theming:MaterialOpticalCenterDecorator>
                </Button.Content>
              </controls:MaterialSplitButtonTrailingButton>
            </Grid>
          </Border>
        </Panel>
      </ControlTemplate>
    </Setter>

    <Style Selector="^[Variant=Filled]">
      <Setter Property="Background" Value="{DynamicResource MaterialPrimaryBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource MaterialOnPrimaryBrush}" />
      <Setter Property="BorderBrush" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
    </Style>
    <Style Selector="^[Variant=Tonal]">
      <Setter Property="Background" Value="{DynamicResource MaterialSecondaryContainerBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource MaterialOnSecondaryContainerBrush}" />
      <Setter Property="BorderBrush" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
    </Style>
    <Style Selector="^[Variant=Elevated]">
      <Setter Property="Background" Value="{DynamicResource MaterialSurfaceContainerLowBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource MaterialPrimaryBrush}" />
      <Setter Property="BorderBrush" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
    </Style>
    <Style Selector="^[Variant=Elevated] /template/ Border#Container">
      <Setter Property="BoxShadow" Value="{DynamicResource MaterialElevationLevel1Shadow}" />
    </Style>
    <Style Selector="^[Variant=Outlined]">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Foreground" Value="{DynamicResource MaterialOnSurfaceVariantBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource MaterialOutlineVariantBrush}" />
      <Setter Property="BorderThickness" Value="1" />
    </Style>

    <Style Selector="^:disabled">
      <Setter Property="Background" Value="{DynamicResource MaterialOnSurfaceBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource MaterialOnSurfaceVariantBrush}" />
      <Setter Property="BorderBrush" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
    </Style>
    <Style Selector="^[Variant=Outlined]:disabled">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="{DynamicResource MaterialOutlineVariantBrush}" />
      <Setter Property="BorderThickness" Value="1" />
    </Style>
    <Style Selector="^[Variant=Elevated]:disabled /template/ Border#Container">
      <Setter Property="BoxShadow" Value="{DynamicResource MaterialElevationLevel0Shadow}" />
    </Style>
  </ControlTheme>
</ResourceDictionary>