<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:controls="using:ExpressiveAvalonia.Controls"
                    xmlns:theming="using:ExpressiveAvalonia.Theming">
  <!-- Material 3 cards.

       Container, shape, colors and interaction states are ported from AndroidX Material3 at
       77b2199d6f056c2fe829ce25523c34a905e769c1: Card.kt (CardDefaults/CardColors), Surface.kt and
       internal/Elevation.kt. Filled = surface-container-highest, elevated =
       surface-container-low + level 1, outlined = surface + 1 DIP outline-variant border;
       container shape = corner-medium (12). Elevation by state (source CardDefaults):
         filled   0 default/pressed/focus, 1 hover, 3 dragged, 0 disabled
         elevated 1 default/pressed/focus, 2 hover, 4 dragged, 1 disabled
         outlined 0 default/pressed/focus/hover, 3 dragged, 0 disabled
       MaterialCard animates the elevation in code with the source tween specs, so no BoxShadow
       setter or transition lives here.

       Disabled: content = on-surface at 38% (source contentColor.copy(DisabledAlpha), the same
       value as MaterialDisabledContentBrush). Filled keeps surface-container-highest and
       composites surface-variant at 38% over it (source disabledContainerColor =
       surfaceVariant@0.38 compositeOver surfaceContainerHighest); elevated and outlined use the
       surface token. The outlined disabled stroke is the source composite
       outline@0.12 over surface-container-low (Card.kt outlinedCardBorder(enabled = false)
       composites OutlinedCardTokens.DisabledOutlineColor over ElevatedCardTokens.ContainerColor);
       MaterialTheme generates that opaque brush, so the stroke is not a translucent layer over
       the outlined card's own surface container.

       Interaction feedback is the shared theming:MaterialRipple (source RippleNode): a bounded
       press ripple from the pointer origin plus the hover/focus/drag state layer at 0.08/0.10/0.16
       on-surface alpha, clipped to the animated silhouette. Only a card with onClick emits
       interactions upstream, so the noninteractive surface never ripples. Keyboard-focused
       interactive cards also show a ring, as required by current Material accessibility guidance;
       ShowFocusIndicator can force the same ring for previews.

       The stacked and horizontal anatomies, the typed slots, pointer drag support and the
       ShowFocusIndicator switch are library extensions from the card design packages
       (Stacked card local-004836, Horizontal card local-001649, Card states local-000197/
       local-000203/local-000209). They are not upstream Compose API.
  -->
  <ControlTemplate x:Key="MaterialCardStackedTemplate" TargetType="controls:MaterialCard">
    <Panel Name="PART_Root">
      <Border Name="PART_Card"
              Background="{TemplateBinding Background}"
              BorderBrush="{TemplateBinding BorderBrush}"
              BorderThickness="{TemplateBinding BorderThickness}"
              CornerRadius="{TemplateBinding CornerRadius}"
              ClipToBounds="True">
        <Panel>
          <!-- Disabled container composition (filled only). -->
          <Border Name="PART_DisabledOverlay" IsVisible="False" Opacity="0.38"
                  Background="{DynamicResource MaterialSurfaceVariantBrush}"
                  IsHitTestVisible="False" />
          <Grid Name="PART_Anatomy" RowDefinitions="Auto,Auto,Auto" ColumnDefinitions="*">
            <!-- Extensions: source card design anatomy. 40 DIP avatar, 16 DIP gap. -->
            <Border Name="PART_Header" Grid.Row="0" Padding="16,12,4,12"
                    IsVisible="{TemplateBinding HasHeader}">
              <Grid ColumnDefinitions="Auto,*,Auto">
                <Border Name="PART_Avatar" Width="40" Height="40" CornerRadius="999"
                        Background="{DynamicResource MaterialPrimaryContainerBrush}"
                        VerticalAlignment="Center"
                        IsVisible="{TemplateBinding HasAvatar}">
                  <Panel>
                    <TextBlock Text="{TemplateBinding AvatarInitial}"
                               IsVisible="{TemplateBinding HasAvatarInitial}"
                               FontSize="{DynamicResource MaterialTitleMediumFontSize}"
                               FontWeight="{DynamicResource MaterialTitleMediumFontWeight}"
                               LineHeight="{DynamicResource MaterialTitleMediumLineHeight}"
                               LetterSpacing="{DynamicResource MaterialTitleMediumLetterSpacing}"
                               Foreground="{DynamicResource MaterialOnPrimaryContainerBrush}"
                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                    <ContentPresenter Content="{TemplateBinding Avatar}"
                                      HorizontalContentAlignment="Center"
                                      VerticalContentAlignment="Center" />
                  </Panel>
                </Border>
                <StackPanel Grid.Column="1" Margin="16,0,0,0" VerticalAlignment="Center">
                  <TextBlock Text="{TemplateBinding Header}"
                             Foreground="{TemplateBinding Foreground}"
                             FontSize="{DynamicResource MaterialTitleMediumFontSize}"
                             FontWeight="{DynamicResource MaterialTitleMediumFontWeight}"
                             LineHeight="{DynamicResource MaterialTitleMediumLineHeight}"
                             LetterSpacing="{DynamicResource MaterialTitleMediumLetterSpacing}"
                             TextTrimming="CharacterEllipsis" />
                  <TextBlock Text="{TemplateBinding Subhead}"
                             Foreground="{TemplateBinding Foreground}"
                             FontSize="{DynamicResource MaterialBodyMediumFontSize}"
                             FontWeight="{DynamicResource MaterialBodyMediumFontWeight}"
                             LineHeight="{DynamicResource MaterialBodyMediumLineHeight}"
                             LetterSpacing="{DynamicResource MaterialBodyMediumLetterSpacing}"
                             TextTrimming="CharacterEllipsis" />
                </StackPanel>
                <ContentPresenter Name="PART_HeaderAction" Grid.Column="2" Margin="8,0,0,0"
                                  Content="{TemplateBinding HeaderAction}"
                                  HorizontalAlignment="Center" VerticalAlignment="Center"
                                  IsVisible="{TemplateBinding HasHeaderAction}" />
              </Grid>
            </Border>
            <!-- Extension: source media band. -->
            <Border Name="PART_Media" Grid.Row="1" Height="188" ClipToBounds="True"
                    Background="{DynamicResource MaterialSurfaceContainerHighBrush}"
                    IsVisible="{TemplateBinding HasMedia}">
              <ContentPresenter Content="{TemplateBinding Media}"
                                HorizontalContentAlignment="Stretch"
                                VerticalContentAlignment="Stretch" />
            </Border>
            <!-- Extension: source text block. Upstream renders whatever content the caller passes. -->
            <StackPanel Name="PART_TextContent" Grid.Row="2" Margin="16" Spacing="32">
              <StackPanel Name="PART_Headline" IsVisible="{TemplateBinding HasHeadline}">
                <TextBlock Text="{TemplateBinding Title}"
                           Foreground="{TemplateBinding Foreground}"
                           FontSize="{DynamicResource MaterialBodyLargeFontSize}"
                           FontWeight="{DynamicResource MaterialBodyLargeFontWeight}"
                           LineHeight="{DynamicResource MaterialBodyLargeLineHeight}"
                           LetterSpacing="{DynamicResource MaterialBodyLargeLetterSpacing}"
                           TextWrapping="Wrap" />
                <TextBlock Text="{TemplateBinding Subtitle}"
                           Foreground="{DynamicResource MaterialOnSurfaceVariantBrush}"
                           FontSize="{DynamicResource MaterialBodyMediumFontSize}"
                           FontWeight="{DynamicResource MaterialBodyMediumFontWeight}"
                           LineHeight="{DynamicResource MaterialBodyMediumLineHeight}"
                           LetterSpacing="{DynamicResource MaterialBodyMediumLetterSpacing}"
                           TextWrapping="Wrap" />
              </StackPanel>
              <TextBlock Text="{TemplateBinding SupportingText}"
                         Foreground="{DynamicResource MaterialOnSurfaceVariantBrush}"
                         FontSize="{DynamicResource MaterialBodyMediumFontSize}"
                         FontWeight="{DynamicResource MaterialBodyMediumFontWeight}"
                         LineHeight="{DynamicResource MaterialBodyMediumLineHeight}"
                         LetterSpacing="{DynamicResource MaterialBodyMediumLetterSpacing}"
                         TextWrapping="Wrap"
                         IsVisible="{TemplateBinding HasSupportingText}" />
              <StackPanel Name="PART_Actions" Orientation="Horizontal" Spacing="8"
                          IsVisible="{TemplateBinding HasActions}">
                <Button Name="PART_SecondaryAction"
                        theming:MaterialAssist.ButtonVariant="Outlined"
                        theming:MaterialAssist.ControlSize="Small"
                        Content="{TemplateBinding SecondaryAction}"
                        Command="{TemplateBinding SecondaryActionCommand}"
                        CommandParameter="{TemplateBinding SecondaryActionCommandParameter}"
                        IsVisible="{TemplateBinding HasSecondaryAction}" />
                <Button Name="PART_PrimaryAction"
                        theming:MaterialAssist.ButtonVariant="Filled"
                        theming:MaterialAssist.ControlSize="Small"
                        Content="{TemplateBinding PrimaryAction}"
                        Command="{TemplateBinding PrimaryActionCommand}"
                        CommandParameter="{TemplateBinding PrimaryActionCommandParameter}"
                        IsVisible="{TemplateBinding HasPrimaryAction}" />
              </StackPanel>
            </StackPanel>
          </Grid>
          <ContentPresenter Name="PART_ContentPresenter"
                            Content="{TemplateBinding Content}"
                            ContentTemplate="{TemplateBinding ContentTemplate}"
                            Padding="{TemplateBinding Padding}"
                            HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                            VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}" />
          <!-- Source RippleNode: the shared MaterialRipple draws the hover/focus/drag state layer
               and the bounded press ripple above the card content. Fill is the on-surface content
               color, matching CardDefaults contentColor; the node clips itself to the card
               silhouette, so the surface needs no extra clip and there is no second press alpha. -->
          <theming:MaterialRipple Name="StateLayer"
                                  Fill="{DynamicResource MaterialOnSurfaceBrush}"
                                  CornerRadius="{TemplateBinding CornerRadius}"
                                  PressOpacity="{DynamicResource MaterialPressedStateLayerOpacity}"
                                  HoverOpacity="{DynamicResource MaterialHoverStateLayerOpacity}"
                                  FocusOpacity="{DynamicResource MaterialFocusStateLayerOpacity}"
                                  DraggedOpacity="{DynamicResource MaterialDraggedStateLayerOpacity}"
                                  IsDragging="{TemplateBinding IsDragging}"
                                  IsHitTestVisible="False" />
          <Border Name="PART_DisabledOutline" IsVisible="False"
                  BorderBrush="{DynamicResource MaterialCardOutlinedDisabledOutlineBrush}" BorderThickness="1"
                  CornerRadius="{TemplateBinding CornerRadius}" IsHitTestVisible="False" />
        </Panel>
      </Border>
      <Border Name="FocusRing" Margin="-2" IsHitTestVisible="False"
              CornerRadius="{TemplateBinding FocusRingCornerRadius}"
              BorderBrush="{DynamicResource MaterialSecondaryBrush}"
              BorderThickness="3" />
    </Panel>
  </ControlTemplate>

  <ControlTemplate x:Key="MaterialCardHorizontalTemplate" TargetType="controls:MaterialCard">
    <Panel Name="PART_Root">
      <Border Name="PART_Card"
              Background="{TemplateBinding Background}"
              BorderBrush="{TemplateBinding BorderBrush}"
              BorderThickness="{TemplateBinding BorderThickness}"
              CornerRadius="{TemplateBinding CornerRadius}"
              ClipToBounds="True">
        <Panel>
          <Border Name="PART_DisabledOverlay" IsVisible="False" Opacity="0.38"
                  Background="{DynamicResource MaterialSurfaceVariantBrush}"
                  IsHitTestVisible="False" />
          <!-- Extension: source horizontal anatomy, 280 header + 80 media square. -->
          <Grid Name="PART_Anatomy" ColumnDefinitions="*,Auto">
            <Border Name="PART_Header" Grid.Column="0" Padding="16"
                    IsVisible="{TemplateBinding HasHeader}">
              <Grid ColumnDefinitions="Auto,*">
                <Border Name="PART_Avatar" Width="40" Height="40" CornerRadius="999"
                        Background="{DynamicResource MaterialPrimaryContainerBrush}"
                        VerticalAlignment="Center"
                        IsVisible="{TemplateBinding HasAvatar}">
                  <Panel>
                    <TextBlock Text="{TemplateBinding AvatarInitial}"
                               IsVisible="{TemplateBinding HasAvatarInitial}"
                               FontSize="{DynamicResource MaterialTitleMediumFontSize}"
                               FontWeight="{DynamicResource MaterialTitleMediumFontWeight}"
                               LineHeight="{DynamicResource MaterialTitleMediumLineHeight}"
                               LetterSpacing="{DynamicResource MaterialTitleMediumLetterSpacing}"
                               Foreground="{DynamicResource MaterialOnPrimaryContainerBrush}"
                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                    <ContentPresenter Content="{TemplateBinding Avatar}"
                                      HorizontalContentAlignment="Center"
                                      VerticalContentAlignment="Center" />
                  </Panel>
                </Border>
                <StackPanel Grid.Column="1" Margin="16,0,0,0" VerticalAlignment="Center">
                  <TextBlock Text="{TemplateBinding Header}"
                             Foreground="{TemplateBinding Foreground}"
                             FontSize="{DynamicResource MaterialTitleMediumFontSize}"
                             FontWeight="{DynamicResource MaterialTitleMediumFontWeight}"
                             LineHeight="{DynamicResource MaterialTitleMediumLineHeight}"
                             LetterSpacing="{DynamicResource MaterialTitleMediumLetterSpacing}"
                             TextTrimming="CharacterEllipsis" />
                  <TextBlock Text="{TemplateBinding Subhead}"
                             Foreground="{TemplateBinding Foreground}"
                             FontSize="{DynamicResource MaterialBodyMediumFontSize}"
                             FontWeight="{DynamicResource MaterialBodyMediumFontWeight}"
                             LineHeight="{DynamicResource MaterialBodyMediumLineHeight}"
                             LetterSpacing="{DynamicResource MaterialBodyMediumLetterSpacing}"
                             TextTrimming="CharacterEllipsis" />
                </StackPanel>
              </Grid>
            </Border>
            <Border Name="PART_Media" Grid.Column="1" Width="80" Height="80"
                    VerticalAlignment="Center" ClipToBounds="True"
                    Background="{DynamicResource MaterialSurfaceContainerHighBrush}"
                    BorderBrush="{DynamicResource MaterialOutlineBrush}"
                    BorderThickness="1"
                    IsVisible="{TemplateBinding HasMedia}">
              <ContentPresenter Content="{TemplateBinding Media}"
                                HorizontalContentAlignment="Stretch"
                                VerticalContentAlignment="Stretch" />
            </Border>
          </Grid>
          <ContentPresenter Name="PART_ContentPresenter"
                            Content="{TemplateBinding Content}"
                            ContentTemplate="{TemplateBinding ContentTemplate}"
                            Padding="{TemplateBinding Padding}"
                            HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                            VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}" />
          <!-- Source RippleNode: the shared MaterialRipple draws the hover/focus/drag state layer
               and the bounded press ripple above the card content. Fill is the on-surface content
               color, matching CardDefaults contentColor; the node clips itself to the card
               silhouette, so the surface needs no extra clip and there is no second press alpha. -->
          <theming:MaterialRipple Name="StateLayer"
                                  Fill="{DynamicResource MaterialOnSurfaceBrush}"
                                  CornerRadius="{TemplateBinding CornerRadius}"
                                  PressOpacity="{DynamicResource MaterialPressedStateLayerOpacity}"
                                  HoverOpacity="{DynamicResource MaterialHoverStateLayerOpacity}"
                                  FocusOpacity="{DynamicResource MaterialFocusStateLayerOpacity}"
                                  DraggedOpacity="{DynamicResource MaterialDraggedStateLayerOpacity}"
                                  IsDragging="{TemplateBinding IsDragging}"
                                  IsHitTestVisible="False" />
          <Border Name="PART_DisabledOutline" IsVisible="False"
                  BorderBrush="{DynamicResource MaterialCardOutlinedDisabledOutlineBrush}" BorderThickness="1"
                  CornerRadius="{TemplateBinding CornerRadius}" IsHitTestVisible="False" />
        </Panel>
      </Border>
      <Border Name="FocusRing" Margin="-2" IsHitTestVisible="False"
              CornerRadius="{TemplateBinding FocusRingCornerRadius}"
              BorderBrush="{DynamicResource MaterialSecondaryBrush}"
              BorderThickness="3" />
    </Panel>
  </ControlTemplate>

  <ControlTheme x:Key="{x:Type controls:MaterialCard}" TargetType="controls:MaterialCard">
    <Setter Property="Background" Value="{DynamicResource MaterialSurfaceContainerHighestBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource MaterialOnSurfaceBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource MaterialOutlineVariantBrush}" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="CornerRadius" Value="{DynamicResource MaterialShapeMediumCornerRadius}" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="FontFamily" Value="{DynamicResource MaterialFontFamily}" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    <Setter Property="VerticalContentAlignment" Value="Stretch" />
    <Setter Property="Template" Value="{StaticResource MaterialCardStackedTemplate}" />

    <!-- Extension: the source design orientation selects the anatomy template. -->
    <Style Selector="^[Orientation=Horizontal]">
      <Setter Property="Template" Value="{StaticResource MaterialCardHorizontalTemplate}" />
    </Style>

    <!-- Source container roles. -->
    <Style Selector="^[Variant=Elevated]">
      <Setter Property="Background" Value="{DynamicResource MaterialSurfaceContainerLowBrush}" />
    </Style>
    <Style Selector="^[Variant=Filled]">
      <Setter Property="Background" Value="{DynamicResource MaterialSurfaceContainerHighestBrush}" />
    </Style>
    <Style Selector="^[Variant=Outlined]">
      <Setter Property="Background" Value="{DynamicResource MaterialSurfaceBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource MaterialOutlineVariantBrush}" />
      <Setter Property="BorderThickness" Value="1" />
    </Style>

    <!-- Source disabled container colors (see file header). -->
    <Style Selector="^[Variant=Filled]:disabled /template/ Border#PART_DisabledOverlay">
      <Setter Property="IsVisible" Value="True" />
    </Style>
    <Style Selector="^[Variant=Elevated]:disabled">
      <Setter Property="Background" Value="{DynamicResource MaterialSurfaceBrush}" />
    </Style>
    <Style Selector="^[Variant=Outlined]:disabled">
      <Setter Property="Background" Value="{DynamicResource MaterialSurfaceBrush}" />
      <Setter Property="BorderThickness" Value="0" />
    </Style>
    <Style Selector="^[Variant=Outlined]:disabled /template/ Border#PART_DisabledOutline">
      <Setter Property="IsVisible" Value="True" />
    </Style>

    <!-- Source disabled content color: contentColor.copy(DisabledAlpha) = on-surface @ 38%. -->
    <Style Selector="^:disabled">
      <Setter Property="Foreground" Value="{DynamicResource MaterialDisabledContentBrush}" />
      <Setter Property="Cursor" Value="Arrow" />
    </Style>

    <!-- Interactive cards get the 48 DIP minimum interactive size and focus reachability. -->
    <Style Selector="^[IsInteractive=True]">
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Focusable" Value="True" />
      <Setter Property="KeyboardNavigation.IsTabStop" Value="True" />
      <Setter Property="MinWidth" Value="48" />
      <Setter Property="MinHeight" Value="48" />
    </Style>

    <!-- Source interaction: only a card with onClick emits indication, so a noninteractive
         surface never ripples and never paints a hover/focus/drag layer. The shared ripple reads
         pointer, keyboard and drag input itself; the card's elevation still follows the same
         fine-grained interaction state in code. -->
    <Style Selector="^ /template/ theming|MaterialRipple#StateLayer">
      <Setter Property="EnablePress" Value="False" />
      <Setter Property="EnableHover" Value="False" />
      <Setter Property="EnableFocus" Value="False" />
      <Setter Property="EnableDrag" Value="False" />
    </Style>
    <Style Selector="^[IsInteractive=True] /template/ theming|MaterialRipple#StateLayer">
      <Setter Property="EnablePress" Value="True" />
      <Setter Property="EnableHover" Value="True" />
      <Setter Property="EnableFocus" Value="True" />
      <Setter Property="EnableDrag" Value="True" />
    </Style>

    <!-- Keyboard focus needs a visible indicator; ShowFocusIndicator also permits previews. -->
    <Style Selector="^ /template/ Border#FocusRing">
      <Setter Property="IsVisible" Value="False" />
    </Style>
    <Style Selector="^[IsInteractive=True]:focus-visible /template/ Border#FocusRing">
      <Setter Property="IsVisible" Value="True" />
    </Style>
    <Style Selector="^[ShowFocusIndicator=True] /template/ Border#FocusRing">
      <Setter Property="IsVisible" Value="True" />
    </Style>
    <Style Selector="^:disabled /template/ Border#FocusRing">
      <Setter Property="IsVisible" Value="False" />
    </Style>

    <!-- Extension: Layout=Slot replaces the fixed anatomy with the content slot. -->
    <Style Selector="^ /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="IsVisible" Value="False" />
    </Style>
    <Style Selector="^[Layout=Slot] /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="IsVisible" Value="True" />
    </Style>
    <Style Selector="^[Layout=Slot] /template/ Grid#PART_Anatomy">
      <Setter Property="IsVisible" Value="False" />
    </Style>
  </ControlTheme>

  <!-- Source BadgedBox: badge over anchor content. The panel implements the upstream measure
       policy (dot 6/6 offsets, labeled content 12/14 offsets, end/top clamped, RTL mirrored). -->
  <ControlTheme x:Key="{x:Type controls:MaterialBadgedBox}" TargetType="controls:MaterialBadgedBox">
    <Setter Property="HorizontalContentAlignment" Value="Left" />
    <Setter Property="VerticalContentAlignment" Value="Top" />
    <Setter Property="ClipToBounds" Value="False" />
    <Setter Property="Template">
      <ControlTemplate>
        <controls:MaterialBadgeAnchorPanel>
          <ContentPresenter Name="PART_Anchor"
                            Content="{TemplateBinding Content}"
                            ContentTemplate="{TemplateBinding ContentTemplate}" />
          <ContentPresenter Name="PART_Badge"
                            Content="{TemplateBinding Badge}"
                            ContentTemplate="{TemplateBinding BadgeTemplate}" />
        </controls:MaterialBadgeAnchorPanel>
      </ControlTemplate>
    </Setter>
  </ControlTheme>
</ResourceDictionary>