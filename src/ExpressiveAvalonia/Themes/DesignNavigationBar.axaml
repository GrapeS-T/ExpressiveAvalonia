<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:controls="clr-namespace:ExpressiveAvalonia.Controls"
                    xmlns:theming="clr-namespace:ExpressiveAvalonia.Theming">
  <!-- Material 3 navigation bar and badges.
       Geometry follows the assigned source packages:
       Navigation Bar: Horizontal items (local-004370), Navigation Bar: Vertical items (local-004375),
       Horizontal nav item (local-000403), Vertical nav item (local-000428) and Badges (local-000108).

       Bar: 64 high, surface-container background, destinations share the width equally.
       Horizontal item: 40 high full-radius pill, 16/8 padding, 4 gap, 24 icon, 12/16 label.
       Vertical item: 56x32 icon pill (16 radius), 4 gap, 12/16 centered label, 6/6 vertical padding.
       Badge: 6x6 dot, or 16 high pill with 4/0 padding and an 11/16 label.

       Item geometry and motion live in MaterialNavigationItemLayout: the item control drives the
       indicator size/alpha, the alwaysShowLabel icon shift and the icon crossfade from
       frame-based Material springs, so this theme only supplies brushes, typography and states.
       Content tint and the indicator ripple are owned by the item control: NavigationBar.kt
       185-208 animates icon/label with animateColorAsState(DefaultEffects) independently of the
       indicator, and the indicator Box clip/indication pair (NavigationBar.kt 247-292) is the
       shared MaterialRipple child at indicator bounds. Theme styles therefore no longer set part
       fills/foregrounds or finite brush transitions. -->
  <x:String x:Key="MaterialNavigationBarName">Navigation bar</x:String>
  <x:String x:Key="MaterialNavigationBarBadgeHelpText">{0} new items</x:String>
  <x:String x:Key="MaterialNavigationBarBadgeDotText">New items</x:String>

  <ControlTheme x:Key="{x:Type controls:MaterialBadge}" TargetType="controls:MaterialBadge">
    <Setter Property="Background" Value="{DynamicResource MaterialErrorBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource MaterialOnErrorBrush}" />
    <Setter Property="Focusable" Value="False" />
    <Setter Property="IsHitTestVisible" Value="False" />
    <Setter Property="HorizontalAlignment" Value="Right" />
    <Setter Property="VerticalAlignment" Value="Top" />
    <Setter Property="Template">
      <ControlTemplate>
        <Panel Background="Transparent">
          <Border Name="PART_Dot" Width="6" Height="6" CornerRadius="3"
                  Background="{TemplateBinding Background}"
                  HorizontalAlignment="Right" VerticalAlignment="Top" IsVisible="False" />
          <Border Name="PART_Pill" MinWidth="16" Height="16" CornerRadius="8" Padding="4,0"
                  Background="{TemplateBinding Background}"
                  HorizontalAlignment="Right" VerticalAlignment="Top" IsVisible="False">
            <TextBlock Name="PART_Text" Text="{TemplateBinding Text}"
                       Foreground="{TemplateBinding Foreground}"
                       FontFamily="{DynamicResource MaterialFontFamily}"
                       FontSize="{DynamicResource MaterialLabelSmallFontSize}"
                       FontWeight="{DynamicResource MaterialLabelSmallFontWeight}"
                       LetterSpacing="{DynamicResource MaterialLabelSmallLetterSpacing}"
                       LineHeight="{DynamicResource MaterialLabelSmallLineHeight}"
                       TextAlignment="Center" VerticalAlignment="Center" />
          </Border>
        </Panel>
      </ControlTemplate>
    </Setter>
    <Style Selector="^:dot /template/ Border#PART_Dot">
      <Setter Property="IsVisible" Value="True" />
    </Style>
    <Style Selector="^:labeled /template/ Border#PART_Pill">
      <Setter Property="IsVisible" Value="True" />
    </Style>
  </ControlTheme>

  <!-- Bar destination. Child order is the source layout contract used by the panel:
       0 indicator, 1 state layer/ripple, 2 icon slot (with badge), 3 label slot, 4 focus ring.
       The item control resolves Top versus Start from the bar and from alwaysShowLabel. -->
  <ControlTemplate x:Key="MaterialNavigationBarItemTemplate" TargetType="controls:MaterialNavigationBarItem">
    <Panel Name="PART_ItemRoot" Background="Transparent" ClipToBounds="True">
      <controls:MaterialNavigationItemLayout Name="PART_Layout"
                                            HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
        <Border Name="PART_Indicator" CornerRadius="16"
                Background="{DynamicResource MaterialSecondaryContainerBrush}" />
        <!-- Source ripple: the indicator-sized Box clips the bounded press and paints hover/focus
             state layers in the Surface content colour. Child 1 of the layout panel is arranged to
             the full indicator pill, so press coordinates stay indicator-relative. -->
        <theming:MaterialRipple Name="PART_StateLayer" CornerRadius="16"
                                Fill="{DynamicResource MaterialOnSurfaceBrush}"
                                PressOpacity="{DynamicResource MaterialPressedStateLayerOpacity}"
                                HoverOpacity="{DynamicResource MaterialHoverStateLayerOpacity}"
                                FocusOpacity="{DynamicResource MaterialFocusStateLayerOpacity}"
                                EnableDrag="False" IsHitTestVisible="False" />
        <Grid Name="PART_IconHost" Width="24" Height="24"
              HorizontalAlignment="Center" VerticalAlignment="Center">
          <Path Name="PART_Icon" Data="{TemplateBinding Icon}" Width="20" Height="20" Stretch="Uniform"
                HorizontalAlignment="Center" VerticalAlignment="Center" />
          <Path Name="PART_SelectedIcon" Data="{TemplateBinding EffectiveSelectedIcon}" Width="20" Height="20"
                Stretch="Uniform"
                HorizontalAlignment="Center" VerticalAlignment="Center" />
          <controls:MaterialBadge Name="PART_BadgeSmall" Size="Small" IsVisible="False"
                                  HorizontalAlignment="Right" VerticalAlignment="Top" />
          <controls:MaterialBadge Name="PART_BadgeLarge" Size="Large" Text="{TemplateBinding BadgeText}"
                                  IsVisible="False"
                                  HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-2,-4,0" />
        </Grid>
        <!-- The destination name already carries the label; the text itself is not a
             separate content element for a screen reader. The panel fades this slot. -->
        <Panel Name="PART_LabelHost" HorizontalAlignment="Center" VerticalAlignment="Center">
          <TextBlock Name="PART_Label" Text="{TemplateBinding LabelText}"
                     AutomationProperties.AccessibilityView="Raw" AutomationProperties.IsControlElementOverride="False"
                     FontSize="{DynamicResource MaterialLabelMediumFontSize}"
                     FontWeight="{DynamicResource MaterialLabelMediumFontWeight}"
                     LetterSpacing="{DynamicResource MaterialLabelMediumLetterSpacing}"
                     LineHeight="{DynamicResource MaterialLabelMediumLineHeight}"
                     MaxLines="1" TextTrimming="CharacterEllipsis"
                     HorizontalAlignment="Center" VerticalAlignment="Center" />
          <!-- Rich or bound content keeps its template; text content uses the label above. -->
          <ContentPresenter Name="PART_Content" Content="{TemplateBinding Content}"
                            AutomationProperties.AccessibilityView="Raw" AutomationProperties.IsControlElementOverride="False"
                            ContentTemplate="{TemplateBinding ContentTemplate}"
                            HorizontalAlignment="Center" VerticalAlignment="Center"
                            TextElement.FontSize="{DynamicResource MaterialLabelMediumFontSize}"
                            TextElement.FontWeight="{DynamicResource MaterialLabelMediumFontWeight}"
                            IsVisible="{TemplateBinding IsContentVisible}" />
        </Panel>
        <Border Name="PART_FocusRing" Margin="-2" CornerRadius="16" BorderThickness="3"
                BorderBrush="{DynamicResource MaterialSecondaryBrush}" IsVisible="False" />
      </controls:MaterialNavigationItemLayout>
    </Panel>
  </ControlTemplate>

  <ControlTheme x:Key="MaterialNavigationBarItemTheme" TargetType="controls:MaterialNavigationBarItem">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{DynamicResource MaterialOnSurfaceVariantBrush}" />
    <Setter Property="FontFamily" Value="{DynamicResource MaterialFontFamily}" />
    <Setter Property="FontSize" Value="{DynamicResource MaterialLabelMediumFontSize}" />
    <Setter Property="FontWeight" Value="{DynamicResource MaterialLabelMediumFontWeight}" />
    <Setter Property="Focusable" Value="True" />
    <!-- The bar is one tab stop; arrow keys move focus between destinations. -->
    <Setter Property="IsTabStop" Value="False" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="MinHeight" Value="64" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="VerticalAlignment" Value="Stretch" />
    <Setter Property="Template" Value="{StaticResource MaterialNavigationBarItemTemplate}" />

    <!-- Source icon positions: Vertical item uses a 16 radius icon pill, Horizontal item a
         20 radius row pill. The panel arranges the shapes; these styles only shape them.
         The indicator-relative ripple shares each indicator silhouette (NavigationBar.kt
         ripple(focusRingShape = ItemActiveIndicatorShape)). -->
    <Style Selector="^:top /template/ Border#PART_Indicator">
      <Setter Property="CornerRadius" Value="16" />
    </Style>
    <Style Selector="^:top /template/ theming|MaterialRipple#PART_StateLayer">
      <Setter Property="CornerRadius" Value="16" />
    </Style>
    <Style Selector="^:top /template/ Border#PART_FocusRing">
      <Setter Property="CornerRadius" Value="16" />
    </Style>
    <Style Selector="^:start /template/ Border#PART_Indicator">
      <Setter Property="CornerRadius" Value="20" />
    </Style>
    <Style Selector="^:start /template/ theming|MaterialRipple#PART_StateLayer">
      <Setter Property="CornerRadius" Value="20" />
    </Style>
    <Style Selector="^:start /template/ Border#PART_FocusRing">
      <Setter Property="CornerRadius" Value="20" />
    </Style>

    <!-- Focus ring: the source ripple(focusRingShape) ring, kept as a border so the item
         template can draw it without a second interaction target. The state layer itself is
         painted by the shared MaterialRipple. -->
    <Style Selector="^:focus-visible /template/ Border#PART_FocusRing">
      <Setter Property="IsVisible" Value="True" />
    </Style>

    <Style Selector="^:badge-small /template/ controls|MaterialBadge#PART_BadgeSmall">
      <Setter Property="IsVisible" Value="True" />
    </Style>
    <Style Selector="^:badge-large /template/ controls|MaterialBadge#PART_BadgeLarge">
      <Setter Property="IsVisible" Value="True" />
    </Style>
    <!-- Without a label the vertical destination keeps only its 56x56 icon pill. -->
    <Style Selector="^:top:no-label /template/ controls|MaterialBadge#PART_BadgeSmall">
      <Setter Property="Margin" Value="-2,-2,0,0" />
    </Style>
    <Style Selector="^:top:no-label /template/ controls|MaterialBadge#PART_BadgeLarge">
      <Setter Property="Margin" Value="0,-4,-4,0" />
    </Style>

    <Style Selector="^:disabled">
      <Setter Property="Foreground" Value="{DynamicResource MaterialDisabledContentBrush}" />
      <Setter Property="Cursor" Value="Arrow" />
    </Style>
  </ControlTheme>

  <ControlTheme x:Key="{x:Type controls:MaterialNavigationBarItem}" TargetType="controls:MaterialNavigationBarItem"
                BasedOn="{StaticResource MaterialNavigationBarItemTheme}" />

  <ControlTheme x:Key="MaterialNavigationBarTheme" TargetType="controls:MaterialNavigationBar">
    <Setter Property="Background" Value="{DynamicResource MaterialSurfaceContainerBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource MaterialOnSurfaceBrush}" />
    <Setter Property="SelectionMode" Value="Single" />
    <Setter Property="Focusable" Value="True" />
    <Setter Property="KeyboardNavigation.TabNavigation" Value="Once" />
    <!-- Navigation bars wrap at the ends, as in the Material specification. -->
    <Setter Property="WrapSelection" Value="True" />
    <Setter Property="MinHeight" Value="64" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="ItemContainerTheme" Value="{StaticResource MaterialNavigationBarItemTheme}" />
    <Setter Property="AutomationProperties.Name" Value="{DynamicResource MaterialNavigationBarName}" />
    <Setter Property="Template">
      <ControlTemplate>
        <Border Name="PART_Root" Background="{TemplateBinding Background}"
                BorderBrush="{TemplateBinding BorderBrush}"
                BorderThickness="{TemplateBinding BorderThickness}"
                CornerRadius="{TemplateBinding CornerRadius}"
                Padding="{TemplateBinding Padding}"
                ClipToBounds="True">
          <ItemsPresenter Name="PART_ItemsPresenter" ItemsPanel="{TemplateBinding ItemsPanel}" />
        </Border>
      </ControlTemplate>
    </Setter>

    <!-- The panel is created in code so switching Orientation rebuilds it. -->
    <Style Selector="^:vertical">
      <Setter Property="MinHeight" Value="0" />
    </Style>
    <Style Selector="^:classic:horizontal">
      <Setter Property="MinHeight" Value="80" />
    </Style>
    <Style Selector="^:short:horizontal">
      <Setter Property="MinHeight" Value="64" />
    </Style>
  </ControlTheme>

  <ControlTheme x:Key="{x:Type controls:MaterialNavigationBar}" TargetType="controls:MaterialNavigationBar"
                BasedOn="{StaticResource MaterialNavigationBarTheme}" />
</ResourceDictionary>