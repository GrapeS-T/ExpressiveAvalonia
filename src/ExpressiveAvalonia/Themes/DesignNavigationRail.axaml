<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:controls="clr-namespace:ExpressiveAvalonia.Controls">
  <!-- Material 3 navigation rail: compact (96) and expanded (220) layouts, docked/floating,
       top/middle item alignment, vertical/horizontal items, badges, menu button, and FAB.
       Geometry follows the assigned source packages:
       Navigation Rail (local-004380), Navigation Rail: Expanded (local-004389),
       Vertical nav item (local-000478) and Horizontal nav item (local-000453). -->
  <x:String x:Key="MaterialNavigationRailMenuText">Open navigation menu</x:String>
  <x:String x:Key="MaterialNavigationRailFabText">Create</x:String>

  <!-- Vertical item: 64 high, icon pill 56x32 (56x56 without a label), 4 gap, 12/16 label. -->
  <ControlTemplate x:Key="MaterialNavigationRailItemVerticalTemplate" TargetType="controls:MaterialNavigationRailItem">
    <Panel Name="PART_ItemRoot" Background="Transparent">
      <Grid Name="PART_ItemLayout" RowDefinitions="Auto,Auto" RowSpacing="4" Margin="0,6,0,6"
            HorizontalAlignment="Center" VerticalAlignment="Center">
        <Grid Name="PART_IconHost" Grid.Row="0" Width="56" Height="32" HorizontalAlignment="Center">
          <Border Name="PART_Indicator" CornerRadius="16"
                  Background="{DynamicResource MaterialSecondaryContainerBrush}" IsVisible="False" />
          <Border Name="PART_StateLayer" CornerRadius="16"
                  Background="{DynamicResource MaterialOnSurfaceBrush}" Opacity="0" />
          <Path Name="PART_Icon" Data="{TemplateBinding Icon}" Width="20" Height="20" Stretch="Uniform"
                Fill="{DynamicResource MaterialOnSurfaceVariantBrush}"
                HorizontalAlignment="Center" VerticalAlignment="Center" />
          <Path Name="PART_SelectedIcon" Data="{TemplateBinding EffectiveSelectedIcon}" Width="20" Height="20" Stretch="Uniform"
                Fill="{DynamicResource MaterialOnSecondaryContainerBrush}"
                HorizontalAlignment="Center" VerticalAlignment="Center" IsVisible="False" />
          <Border Name="PART_BadgeSmall" Width="6" Height="6" CornerRadius="3"
                  Background="{DynamicResource MaterialErrorBrush}"
                  HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,4,16,0" IsVisible="False" />
          <Border Name="PART_BadgeLarge" MinWidth="16" Height="16" CornerRadius="8" Padding="4,0"
                  Background="{DynamicResource MaterialErrorBrush}"
                  HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,2,12,0" IsVisible="False">
            <TextBlock Name="PART_BadgeText" Text="{TemplateBinding BadgeText}"
                       Foreground="{DynamicResource MaterialOnErrorBrush}"
                       FontSize="{DynamicResource MaterialLabelSmallFontSize}"
                       FontWeight="Medium"
                       LetterSpacing="{DynamicResource MaterialLabelSmallLetterSpacing}"
                       LineHeight="{DynamicResource MaterialLabelSmallLineHeight}"
                       HorizontalAlignment="Center" VerticalAlignment="Center" />
          </Border>
        </Grid>
        <TextBlock Grid.Row="1" Name="PART_Label" Text="{TemplateBinding EffectiveLabel}"
                   Foreground="{TemplateBinding Foreground}"
                   FontSize="{DynamicResource MaterialLabelMediumFontSize}"
                   FontWeight="Medium"
                   LetterSpacing="{DynamicResource MaterialLabelMediumLetterSpacing}"
                   LineHeight="{DynamicResource MaterialLabelMediumLineHeight}"
                   TextAlignment="Center" HorizontalAlignment="Center" />
        <ContentPresenter Grid.Row="1" Name="PART_Content"
                          Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}"
                          HorizontalAlignment="Center" IsVisible="False" />
      </Grid>
      <Border Name="PART_FocusRing" Margin="3" CornerRadius="12" BorderThickness="3"
              BorderBrush="{DynamicResource MaterialSecondaryBrush}" IsVisible="False" />
    </Panel>
  </ControlTemplate>

  <!-- Horizontal item: 56 high pill, 16 padding, 8 gap, 24 icon, 14/20 label, badge after the label. -->
  <ControlTemplate x:Key="MaterialNavigationRailItemHorizontalTemplate" TargetType="controls:MaterialNavigationRailItem">
    <Border Name="PART_Pill" Background="Transparent" CornerRadius="999">
      <Panel>
        <Border Name="PART_Indicator" CornerRadius="999"
                Background="{DynamicResource MaterialSecondaryContainerBrush}" IsVisible="False" />
        <Border Name="PART_StateLayer" CornerRadius="999"
                Background="{DynamicResource MaterialOnSurfaceBrush}" Opacity="0" />
        <StackPanel Orientation="Horizontal" Spacing="8" Margin="16,0" VerticalAlignment="Center">
          <Grid Name="PART_IconHost" Width="24" Height="24" VerticalAlignment="Center">
            <Path Name="PART_Icon" Data="{TemplateBinding Icon}" Width="20" Height="20" Stretch="Uniform"
                  Fill="{DynamicResource MaterialOnSurfaceVariantBrush}"
                  HorizontalAlignment="Center" VerticalAlignment="Center" />
            <Path Name="PART_SelectedIcon" Data="{TemplateBinding EffectiveSelectedIcon}" Width="20" Height="20" Stretch="Uniform"
                  Fill="{DynamicResource MaterialOnSecondaryContainerBrush}"
                  HorizontalAlignment="Center" VerticalAlignment="Center" IsVisible="False" />
            <Border Name="PART_BadgeSmall" Width="6" Height="6" CornerRadius="3"
                    Background="{DynamicResource MaterialErrorBrush}"
                    HorizontalAlignment="Right" VerticalAlignment="Top" IsVisible="False" />
          </Grid>
          <TextBlock Name="PART_Label" Text="{TemplateBinding EffectiveLabel}"
                     Foreground="{TemplateBinding Foreground}"
                     FontSize="{DynamicResource MaterialLabelLargeFontSize}"
                     FontWeight="Medium"
                     LetterSpacing="{DynamicResource MaterialLabelLargeLetterSpacing}"
                     LineHeight="{DynamicResource MaterialLabelLargeLineHeight}"
                     VerticalAlignment="Center" />
          <ContentPresenter Name="PART_Content"
                            Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}"
                            VerticalAlignment="Center" IsVisible="False" />
          <Border Name="PART_BadgeLarge" MinWidth="16" Height="16" CornerRadius="8" Padding="4,0"
                  Background="{DynamicResource MaterialErrorBrush}"
                  VerticalAlignment="Center" IsVisible="False">
            <TextBlock Name="PART_BadgeText" Text="{TemplateBinding BadgeText}"
                       Foreground="{DynamicResource MaterialOnErrorBrush}"
                       FontSize="{DynamicResource MaterialLabelSmallFontSize}"
                       FontWeight="Medium"
                       LetterSpacing="{DynamicResource MaterialLabelSmallLetterSpacing}"
                       LineHeight="{DynamicResource MaterialLabelSmallLineHeight}"
                       HorizontalAlignment="Center" VerticalAlignment="Center" />
          </Border>
        </StackPanel>
        <Border Name="PART_FocusRing" Margin="-2" CornerRadius="999" BorderThickness="3"
                BorderBrush="{DynamicResource MaterialSecondaryBrush}" IsVisible="False" />
      </Panel>
    </Border>
  </ControlTemplate>

  <ControlTheme x:Key="MaterialNavigationRailItemTheme" TargetType="controls:MaterialNavigationRailItem">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{DynamicResource MaterialOnSurfaceVariantBrush}" />
    <Setter Property="FontFamily" Value="{DynamicResource MaterialFontFamily}" />
    <Setter Property="Focusable" Value="True" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="Template" Value="{StaticResource MaterialNavigationRailItemVerticalTemplate}" />
    <Setter Property="Height" Value="64" />

    <Style Selector="^:vertical">
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="Height" Value="64" />
    </Style>
    <Style Selector="^:horizontal">
      <Setter Property="HorizontalAlignment" Value="Left" />
      <Setter Property="Template" Value="{StaticResource MaterialNavigationRailItemHorizontalTemplate}" />
      <Setter Property="Height" Value="56" />
    </Style>

    <Style Selector="^ /template/ Border#PART_StateLayer">
      <Setter Property="Transitions">
        <Transitions>
          <DoubleTransition Property="Opacity" Duration="{DynamicResource MaterialDurationShort4}" Easing="0.2,0,0,1" />
          <BrushTransition Property="Background" Duration="{DynamicResource MaterialDurationShort4}" Easing="0.2,0,0,1" />
        </Transitions>
      </Setter>
    </Style>
    <Style Selector="^ /template/ TextBlock#PART_Label">
      <Setter Property="Transitions">
        <Transitions>
          <BrushTransition Property="Foreground" Duration="{DynamicResource MaterialDurationShort4}" Easing="0.2,0,0,1" />
        </Transitions>
      </Setter>
    </Style>
    <Style Selector="^ /template/ Path#PART_Icon">
      <Setter Property="Transitions">
        <Transitions>
          <BrushTransition Property="Fill" Duration="{DynamicResource MaterialDurationShort4}" Easing="0.2,0,0,1" />
        </Transitions>
      </Setter>
    </Style>
    <Style Selector="^ /template/ Path#PART_SelectedIcon">
      <Setter Property="Transitions">
        <Transitions>
          <BrushTransition Property="Fill" Duration="{DynamicResource MaterialDurationShort4}" Easing="0.2,0,0,1" />
        </Transitions>
      </Setter>
    </Style>

    <Style Selector="^:selected /template/ Border#PART_Indicator">
      <Setter Property="IsVisible" Value="True" />
    </Style>
    <Style Selector="^:selected /template/ Path#PART_Icon">
      <Setter Property="IsVisible" Value="False" />
    </Style>
    <Style Selector="^:selected /template/ Path#PART_SelectedIcon">
      <Setter Property="IsVisible" Value="True" />
    </Style>
    <Style Selector="^:vertical:selected /template/ TextBlock#PART_Label">
      <Setter Property="Foreground" Value="{DynamicResource MaterialSecondaryBrush}" />
    </Style>
    <Style Selector="^:horizontal:selected /template/ TextBlock#PART_Label">
      <Setter Property="Foreground" Value="{DynamicResource MaterialOnSecondaryContainerBrush}" />
    </Style>

    <Style Selector="^:pointerover /template/ Border#PART_StateLayer">
      <Setter Property="Opacity" Value="{DynamicResource MaterialHoverStateLayerOpacity}" />
    </Style>
    <Style Selector="^:pointerover:selected /template/ Border#PART_StateLayer">
      <Setter Property="Background" Value="{DynamicResource MaterialOnSecondaryContainerBrush}" />
    </Style>
    <Style Selector="^:focus-visible /template/ Border#PART_StateLayer">
      <Setter Property="Opacity" Value="{DynamicResource MaterialFocusStateLayerOpacity}" />
    </Style>
    <Style Selector="^:focus-visible:selected /template/ Border#PART_StateLayer">
      <Setter Property="Background" Value="{DynamicResource MaterialOnSecondaryContainerBrush}" />
    </Style>
    <Style Selector="^:focus-visible /template/ Border#PART_FocusRing">
      <Setter Property="IsVisible" Value="True" />
    </Style>
    <!-- The source "Show focus indicator" boolean draws the same ring without keyboard focus. -->
    <Style Selector="^:force-focus /template/ Border#PART_FocusRing">
      <Setter Property="IsVisible" Value="True" />
    </Style>
    <Style Selector="^:no-icon /template/ Grid#PART_IconHost">
      <Setter Property="IsVisible" Value="False" />
    </Style>
    <!-- Non-text Content (a slot-style segment) renders through the presenter. -->
    <Style Selector="^:custom-content /template/ ContentPresenter#PART_Content">
      <Setter Property="IsVisible" Value="True" />
    </Style>
    <Style Selector="^:custom-content /template/ TextBlock#PART_Label">
      <Setter Property="IsVisible" Value="False" />
    </Style>
    <Style Selector="^:pressed /template/ Border#PART_StateLayer">
      <Setter Property="Opacity" Value="{DynamicResource MaterialPressedStateLayerOpacity}" />
    </Style>
    <Style Selector="^:pressed:selected /template/ Border#PART_StateLayer">
      <Setter Property="Background" Value="{DynamicResource MaterialOnSecondaryContainerBrush}" />
    </Style>

    <Style Selector="^:badge-small /template/ Border#PART_BadgeSmall">
      <Setter Property="IsVisible" Value="True" />
    </Style>
    <Style Selector="^:badge-large /template/ Border#PART_BadgeLarge">
      <Setter Property="IsVisible" Value="True" />
    </Style>

    <Style Selector="^:vertical:no-label /template/ Grid#PART_ItemLayout">
      <Setter Property="Margin" Value="0,4,0,4" />
      <Setter Property="RowSpacing" Value="0" />
    </Style>
    <Style Selector="^:vertical:no-label /template/ Grid#PART_IconHost">
      <Setter Property="Width" Value="56" />
      <Setter Property="Height" Value="56" />
    </Style>
    <Style Selector="^:vertical:no-label /template/ Border#PART_Indicator">
      <Setter Property="CornerRadius" Value="28" />
    </Style>
    <Style Selector="^:vertical:no-label /template/ Border#PART_StateLayer">
      <Setter Property="CornerRadius" Value="28" />
    </Style>
    <Style Selector="^:vertical:no-label /template/ TextBlock#PART_Label">
      <Setter Property="IsVisible" Value="False" />
    </Style>
    <Style Selector="^:vertical:no-label /template/ Border#PART_BadgeSmall">
      <Setter Property="Margin" Value="0,16,16,0" />
    </Style>
    <Style Selector="^:vertical:no-label /template/ Border#PART_BadgeLarge">
      <Setter Property="Margin" Value="0,14,12,0" />
    </Style>
    <Style Selector="^:horizontal:no-label /template/ TextBlock#PART_Label">
      <Setter Property="IsVisible" Value="False" />
    </Style>

    <Style Selector="^:disabled">
      <Setter Property="Foreground" Value="{DynamicResource MaterialDisabledContentBrush}" />
      <Setter Property="Cursor" Value="Arrow" />
    </Style>
    <Style Selector="^:disabled /template/ Path#PART_Icon">
      <Setter Property="Fill" Value="{DynamicResource MaterialDisabledContentBrush}" />
    </Style>
    <Style Selector="^:disabled /template/ Path#PART_SelectedIcon">
      <Setter Property="Fill" Value="{DynamicResource MaterialDisabledContentBrush}" />
    </Style>
    <Style Selector="^:disabled /template/ Border#PART_StateLayer">
      <Setter Property="Opacity" Value="0" />
    </Style>
  </ControlTheme>

  <ControlTheme x:Key="{x:Type controls:MaterialNavigationRailItem}" TargetType="controls:MaterialNavigationRailItem"
                BasedOn="{StaticResource MaterialNavigationRailItemTheme}" />

  <!-- Rail menu icon button: 56x56, 16 corner radius, on-surface-variant icon. -->
  <ControlTheme x:Key="MaterialNavigationRailMenuButtonTheme" TargetType="Button">
    <Setter Property="Width" Value="56" />
    <Setter Property="Height" Value="56" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{DynamicResource MaterialOnSurfaceVariantBrush}" />
    <Setter Property="CornerRadius" Value="16" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="Template">
      <ControlTemplate>
        <Border Background="{TemplateBinding Background}" CornerRadius="{TemplateBinding CornerRadius}">
          <Panel>
            <Border Name="PART_StateLayer" CornerRadius="{TemplateBinding CornerRadius}"
                    Background="{TemplateBinding Foreground}" Opacity="0" />
            <ContentPresenter Name="PART_ContentPresenter"
                              Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}"
                              HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                              VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}" />
            <Border Name="PART_FocusRing" Margin="2" CornerRadius="14" BorderThickness="2"
                    BorderBrush="{DynamicResource MaterialSecondaryBrush}" IsVisible="False" />
          </Panel>
        </Border>
      </ControlTemplate>
    </Setter>
    <Style Selector="^ /template/ Border#PART_StateLayer">
      <Setter Property="Transitions">
        <Transitions>
          <DoubleTransition Property="Opacity" Duration="{DynamicResource MaterialDurationShort4}" Easing="0.2,0,0,1" />
        </Transitions>
      </Setter>
    </Style>
    <Style Selector="^:pointerover /template/ Border#PART_StateLayer">
      <Setter Property="Opacity" Value="{DynamicResource MaterialHoverStateLayerOpacity}" />
    </Style>
    <Style Selector="^:pressed /template/ Border#PART_StateLayer">
      <Setter Property="Opacity" Value="{DynamicResource MaterialPressedStateLayerOpacity}" />
    </Style>
    <Style Selector="^:focus-visible /template/ Border#PART_FocusRing">
      <Setter Property="IsVisible" Value="True" />
    </Style>
    <Style Selector="^:disabled">
      <Setter Property="Foreground" Value="{DynamicResource MaterialDisabledContentBrush}" />
    </Style>
  </ControlTheme>

  <!-- Rail FAB: 56 compact / extended when the rail is expanded. primary-container, 16 radius. -->
  <ControlTheme x:Key="MaterialNavigationRailFabTheme" TargetType="Button">
    <Setter Property="Height" Value="56" />
    <Setter Property="MinWidth" Value="56" />
    <Setter Property="Padding" Value="16" />
    <Setter Property="Background" Value="{DynamicResource MaterialPrimaryContainerBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource MaterialOnPrimaryContainerBrush}" />
    <Setter Property="CornerRadius" Value="16" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="Template">
      <ControlTemplate>
        <Border Background="{TemplateBinding Background}" CornerRadius="{TemplateBinding CornerRadius}" ClipToBounds="True">
          <Panel>
            <Border Name="PART_StateLayer" CornerRadius="{TemplateBinding CornerRadius}"
                    Background="{TemplateBinding Foreground}" Opacity="0" />
            <ContentPresenter Name="PART_ContentPresenter" Margin="{TemplateBinding Padding}"
                              Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}"
                              HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                              VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}" />
            <Border Name="PART_FocusRing" Margin="2" CornerRadius="14" BorderThickness="2"
                    BorderBrush="{DynamicResource MaterialSecondaryBrush}" IsVisible="False" />
          </Panel>
        </Border>
      </ControlTemplate>
    </Setter>
    <Style Selector="^ /template/ Border#PART_StateLayer">
      <Setter Property="Transitions">
        <Transitions>
          <DoubleTransition Property="Opacity" Duration="{DynamicResource MaterialDurationShort4}" Easing="0.2,0,0,1" />
        </Transitions>
      </Setter>
    </Style>
    <Style Selector="^:pointerover /template/ Border#PART_StateLayer">
      <Setter Property="Opacity" Value="{DynamicResource MaterialHoverStateLayerOpacity}" />
    </Style>
    <Style Selector="^:pressed /template/ Border#PART_StateLayer">
      <Setter Property="Opacity" Value="{DynamicResource MaterialPressedStateLayerOpacity}" />
    </Style>
    <Style Selector="^:focus-visible /template/ Border#PART_FocusRing">
      <Setter Property="IsVisible" Value="True" />
    </Style>
    <Style Selector="^:disabled">
      <Setter Property="Foreground" Value="{DynamicResource MaterialDisabledContentBrush}" />
      <Setter Property="Background" Value="{DynamicResource MaterialDisabledContainerBrush}" />
    </Style>
  </ControlTheme>

  <ControlTheme x:Key="MaterialNavigationRailTheme" TargetType="controls:MaterialNavigationRail">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="SelectionMode" Value="Single" />
    <!-- Continue keeps the menu button and FAB in the tab order; the item list is a single
         stop of its own (Once on the presenter) so destinations are reached with arrows. -->
    <Setter Property="KeyboardNavigation.TabNavigation" Value="Continue" />
    <Setter Property="ItemContainerTheme" Value="{StaticResource MaterialNavigationRailItemTheme}" />
    <Setter Property="ItemsPanel">
      <Setter.Value>
        <ItemsPanelTemplate>
          <StackPanel Spacing="4" />
        </ItemsPanelTemplate>
      </Setter.Value>
    </Setter>
    <Setter Property="Template">
      <ControlTemplate>
        <Border Name="PART_Root" Background="{TemplateBinding Background}"
                CornerRadius="{TemplateBinding CornerRadius}" ClipToBounds="True">
          <Panel>
            <StackPanel Name="PART_MenuFab" Orientation="Vertical" Spacing="4"
                        VerticalAlignment="Top" HorizontalAlignment="Center" Margin="0,44,0,0">
              <Button Name="PART_MenuButton" Theme="{StaticResource MaterialNavigationRailMenuButtonTheme}"
                      HorizontalAlignment="Left"
                      Command="{TemplateBinding MenuCommand}" CommandParameter="{TemplateBinding MenuCommandParameter}"
                      IsVisible="{TemplateBinding ShowMenuButton}"
                      AutomationProperties.Name="{DynamicResource MaterialNavigationRailMenuText}">
                <Path Data="{TemplateBinding MenuIcon}" Fill="{Binding $parent[Button].Foreground}"
                      Width="18" Height="12" Stretch="Fill"
                      HorizontalAlignment="Center" VerticalAlignment="Center" />
              </Button>
              <Button Name="PART_FabButton" Theme="{StaticResource MaterialNavigationRailFabTheme}"
                      HorizontalAlignment="Left"
                      Command="{TemplateBinding FabCommand}" CommandParameter="{TemplateBinding FabCommandParameter}"
                      IsVisible="{TemplateBinding ShowFab}"
                      AutomationProperties.Name="{DynamicResource MaterialNavigationRailFabText}">
                <StackPanel Orientation="Horizontal" Spacing="8">
                  <!-- 24 unit icon slot holding the 18 unit glyph, as in the source state layer. -->
                  <Grid Name="PART_FabIconSlot" Width="24" Height="24" VerticalAlignment="Center">
                    <Path Name="PART_FabIcon" Data="{TemplateBinding FabIcon}" Width="18" Height="18" Stretch="Uniform"
                          Fill="{Binding $parent[Button].Foreground}"
                          HorizontalAlignment="Center" VerticalAlignment="Center" />
                  </Grid>
                  <TextBlock Name="PART_FabLabel" Text="{TemplateBinding FabText}"
                             Foreground="{Binding $parent[Button].Foreground}"
                             FontSize="{DynamicResource MaterialTitleMediumFontSize}"
                             FontWeight="Medium"
                             LetterSpacing="{DynamicResource MaterialTitleMediumLetterSpacing}"
                             LineHeight="{DynamicResource MaterialTitleMediumLineHeight}"
                             MaxWidth="40" TextTrimming="CharacterEllipsis"
                             VerticalAlignment="Center" />
                </StackPanel>
              </Button>
            </StackPanel>
            <ItemsPresenter Name="PART_ItemsPresenter" VerticalAlignment="Top"
                            KeyboardNavigation.TabNavigation="Once" />
          </Panel>
        </Border>
      </ControlTemplate>
    </Setter>

    <Style Selector="^">
      <Setter Property="Width" Value="96" />
    </Style>
    <!-- Source FAB: 56x56 icon FAB in the compact rail, fixed 104x56 extended FAB when expanded. -->
    <Style Selector="^ /template/ Button#PART_FabButton">
      <Setter Property="Width" Value="56" />
    </Style>
    <Style Selector="^:expanded /template/ Button#PART_FabButton">
      <Setter Property="Width" Value="104" />
    </Style>
    <Style Selector="^:expanded">
      <Setter Property="Width" Value="220" />
      <Setter Property="ItemsPanel">
        <Setter.Value>
          <ItemsPanelTemplate>
            <StackPanel Spacing="0" />
          </ItemsPanelTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style Selector="^:floating">
      <Setter Property="Background" Value="{DynamicResource MaterialSurfaceContainerBrush}" />
      <Setter Property="CornerRadius" Value="16" />
    </Style>
  </ControlTheme>

  <ControlTheme x:Key="{x:Type controls:MaterialNavigationRail}" TargetType="controls:MaterialNavigationRail"
                BasedOn="{StaticResource MaterialNavigationRailTheme}" />

  <!-- Expanded rail host: content, optional scrim, and the docked/floating rail surface.
       The scrim role and the 0.32 opacity match the source scrim; the slide is horizontal
       because the expanded rail enters from the leading edge. -->
  <ControlTheme x:Key="{x:Type controls:MaterialNavigationRailHost}" TargetType="controls:MaterialNavigationRailHost">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    <Setter Property="VerticalContentAlignment" Value="Stretch" />
    <Setter Property="Template">
      <ControlTemplate>
        <Panel Name="PART_Root" ClipToBounds="True" Background="{TemplateBinding Background}">
          <ContentPresenter Name="PART_ContentPresenter"
                            Content="{TemplateBinding Content}"
                            ContentTemplate="{TemplateBinding ContentTemplate}"
                            Padding="{TemplateBinding Padding}"
                            HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                            VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}" />
          <Panel Name="PART_Overlay" Background="Transparent" IsVisible="False">
            <Border Name="PART_Scrim" Background="{DynamicResource MaterialScrimBrush}" Opacity="0" />
          </Panel>
          <Border Name="PART_RailHost" HorizontalAlignment="Left" VerticalAlignment="Stretch"
                  IsVisible="False" Margin="0">
            <Border.RenderTransform>
              <TranslateTransform />
            </Border.RenderTransform>
            <ContentPresenter Name="PART_RailPresenter" Content="{TemplateBinding Rail}" />
          </Border>
        </Panel>
      </ControlTemplate>
    </Setter>
  </ControlTheme>
</ResourceDictionary>
