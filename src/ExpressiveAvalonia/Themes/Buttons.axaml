<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:theming="using:ExpressiveAvalonia.Theming">
  <!-- AndroidX Button*Tokens and *IconButtonTokens: visual containers are distinct from touch targets. -->
  <!-- Standard Avalonia buttons retain command, keyboard, access-key and toggle behavior. -->
  <!-- Transitions: state-layer and elevation changes use md.sys.motion duration tokens through
       DynamicResource (short4 = 200 ms, short2 = 100 ms, short3 = 150 ms, medium2 = 300 ms).
       MaterialTheme zeroes those tokens under Motion="Reduced", which collapses every transition.
       The curve is inlined because TransitionBase.Easing is a direct property that does not
       resolve DynamicResource; the MaterialEasing* resources carry the same md.sys.motion.easing
       values for code and for consumer styles. -->
  <ControlTheme x:Key="MaterialButtonBase" TargetType="Button">
    <Setter Property="Background" Value="{DynamicResource MaterialPrimaryBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource MaterialOnPrimaryBrush}" />
    <Setter Property="BorderBrush" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="CornerRadius" Value="{DynamicResource MaterialShapeFullCornerRadius}" />
    <Setter Property="Padding" Value="16,10" />
    <Setter Property="MinHeight" Value="48" />
    <Setter Property="MinWidth" Value="58" />
    <Setter Property="FontFamily" Value="{DynamicResource MaterialFontFamily}" />
    <Setter Property="FontSize" Value="{DynamicResource MaterialLabelLargeFontSize}" />
    <Setter Property="FontWeight" Value="{DynamicResource MaterialLabelLargeFontWeight}" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="theming:MaterialAssist.ContainerInset" Value="0,4" />
    <Setter Property="theming:MaterialAssist.AnimateShape" Value="True" />
    <Setter Property="Template">
      <ControlTemplate>
        <Panel Background="Transparent">
          <Panel Margin="{TemplateBinding theming:MaterialAssist.ContainerInset}">
          <Border Name="Surface"
                  Background="{TemplateBinding Background}"
                  BorderBrush="{TemplateBinding BorderBrush}"
                  BorderThickness="{TemplateBinding BorderThickness}"
                  CornerRadius="{TemplateBinding theming:MaterialAssist.AnimatedCornerRadius}" />
          <Border Name="StateLayer"
                  Background="{TemplateBinding Foreground}"
                  CornerRadius="{TemplateBinding theming:MaterialAssist.AnimatedCornerRadius}"
                  Opacity="0" IsHitTestVisible="False" />
          <Viewbox Name="ContentHost" Stretch="None"
                   HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                   VerticalAlignment="{TemplateBinding VerticalContentAlignment}">
          <ContentPresenter Name="PART_ContentPresenter"
                            Content="{TemplateBinding Content}"
                            ContentTemplate="{TemplateBinding ContentTemplate}"
                            Padding="{TemplateBinding Padding}"
                            HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                            VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"
                            LineHeight="{DynamicResource MaterialLabelLargeLineHeight}"
                            LetterSpacing="{DynamicResource MaterialLabelLargeLetterSpacing}"
                            RecognizesAccessKey="True" />
          </Viewbox>
          <Border Name="FocusRing" Margin="-5"
                  CornerRadius="{TemplateBinding theming:MaterialAssist.AnimatedCornerRadius}"
                  BorderBrush="{DynamicResource MaterialSecondaryBrush}"
                  BorderThickness="3" IsVisible="False" IsHitTestVisible="False" />
          </Panel>
        </Panel>
      </ControlTemplate>
    </Setter>

    <Style Selector="^ /template/ Border#Surface">
      <Setter Property="Transitions">
        <Transitions>
          <BoxShadowsTransition Property="BoxShadow" Duration="{DynamicResource MaterialDurationShort4}" Easing="0.2,0,0,1" />
          <DoubleTransition Property="Opacity" Duration="{DynamicResource MaterialDurationShort4}" Easing="0.2,0,0,1" />
          <BrushTransition Property="BorderBrush" Duration="{DynamicResource MaterialDurationShort4}" Easing="0.2,0,0,1" />
        </Transitions>
      </Setter>
    </Style>
    <Style Selector="^ /template/ Border#StateLayer">
      <Setter Property="Transitions">
        <Transitions>
          <DoubleTransition Property="Opacity" Duration="{DynamicResource MaterialDurationShort4}" Easing="0.2,0,0,1" />
        </Transitions>
      </Setter>
    </Style>

    <Style Selector="^[(theming|MaterialAssist.ButtonVariant)=Filled]">
      <Setter Property="Background" Value="{DynamicResource MaterialPrimaryBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource MaterialOnPrimaryBrush}" />
    </Style>
    <Style Selector="^[(theming|MaterialAssist.ButtonVariant)=Tonal]">
      <Setter Property="Background" Value="{DynamicResource MaterialSecondaryContainerBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource MaterialOnSecondaryContainerBrush}" />
    </Style>
    <Style Selector="^[(theming|MaterialAssist.ButtonVariant)=Outlined]">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Foreground" Value="{DynamicResource MaterialOnSurfaceVariantBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource MaterialOutlineVariantBrush}" />
      <Setter Property="BorderThickness" Value="1" />
    </Style>
    <Style Selector="^[(theming|MaterialAssist.ButtonVariant)=Elevated]">
      <Setter Property="Background" Value="{DynamicResource MaterialSurfaceContainerLowBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource MaterialPrimaryBrush}" />
    </Style>
    <Style Selector="^[(theming|MaterialAssist.ButtonVariant)=Elevated] /template/ Border#Surface">
      <Setter Property="BoxShadow" Value="{DynamicResource MaterialElevationLevel1Shadow}" />
    </Style>
    <Style Selector="^[(theming|MaterialAssist.IsIconButton)=False]">
      <Style Selector="^[(theming|MaterialAssist.ButtonVariant)=Filled]:pointerover:not(:pressed):not(:disabled) /template/ Border#Surface">
        <Setter Property="BoxShadow" Value="{DynamicResource MaterialElevationLevel1Shadow}" />
      </Style>
      <Style Selector="^[(theming|MaterialAssist.ButtonVariant)=Tonal]:pointerover:not(:pressed):not(:disabled) /template/ Border#Surface">
        <Setter Property="BoxShadow" Value="{DynamicResource MaterialElevationLevel1Shadow}" />
      </Style>
      <Style Selector="^[(theming|MaterialAssist.ButtonVariant)=Elevated]:pointerover:not(:pressed):not(:disabled) /template/ Border#Surface">
        <Setter Property="BoxShadow" Value="{DynamicResource MaterialElevationLevel2Shadow}" />
      </Style>
    </Style>
    <!-- TextButtonTokens: LabelColor and IconColor are OnSurfaceVariant, not Primary. -->
    <Style Selector="^[(theming|MaterialAssist.ButtonVariant)=Text]">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Foreground" Value="{DynamicResource MaterialOnSurfaceVariantBrush}" />
    </Style>

    <Style Selector="^[(theming|MaterialAssist.ControlSize)=ExtraSmall]">
      <Setter Property="MinHeight" Value="48" />
      <Setter Property="theming:MaterialAssist.ContainerInset" Value="0,8" />
      <!-- ButtonXSmallTokens.LeadingSpace/TrailingSpace = 16. -->
      <Setter Property="Padding" Value="16,6" />
    </Style>
    <Style Selector="^[(theming|MaterialAssist.ControlSize)=Small]">
      <Setter Property="MinHeight" Value="48" />
      <Setter Property="theming:MaterialAssist.ContainerInset" Value="0,4" />
      <Setter Property="Padding" Value="16,10" />
    </Style>
    <Style Selector="^[(theming|MaterialAssist.ControlSize)=Medium]">
      <Setter Property="MinHeight" Value="56" />
      <Setter Property="theming:MaterialAssist.ContainerInset" Value="0" />
      <Setter Property="Padding" Value="24,16" />
      <Setter Property="FontSize" Value="{DynamicResource MaterialTitleMediumFontSize}" />
      <Setter Property="FontWeight" Value="{DynamicResource MaterialTitleMediumFontWeight}" />
    </Style>
    <Style Selector="^[(theming|MaterialAssist.ControlSize)=Medium] /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="LineHeight" Value="{DynamicResource MaterialTitleMediumLineHeight}" />
      <Setter Property="LetterSpacing" Value="{DynamicResource MaterialTitleMediumLetterSpacing}" />
    </Style>
    <Style Selector="^[(theming|MaterialAssist.ControlSize)=Large]">
      <Setter Property="MinHeight" Value="96" />
      <Setter Property="theming:MaterialAssist.ContainerInset" Value="0" />
      <Setter Property="Padding" Value="48,32" />
      <Setter Property="FontSize" Value="{DynamicResource MaterialHeadlineSmallFontSize}" />
      <Setter Property="FontWeight" Value="{DynamicResource MaterialHeadlineSmallFontWeight}" />
    </Style>
    <Style Selector="^[(theming|MaterialAssist.ControlSize)=Large] /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="LineHeight" Value="{DynamicResource MaterialHeadlineSmallLineHeight}" />
      <Setter Property="LetterSpacing" Value="{DynamicResource MaterialHeadlineSmallLetterSpacing}" />
    </Style>
    <Style Selector="^[(theming|MaterialAssist.ControlSize)=ExtraLarge]">
      <Setter Property="MinHeight" Value="136" />
      <Setter Property="theming:MaterialAssist.ContainerInset" Value="0" />
      <Setter Property="Padding" Value="64,48" />
      <Setter Property="FontSize" Value="{DynamicResource MaterialHeadlineLargeFontSize}" />
      <Setter Property="FontWeight" Value="{DynamicResource MaterialHeadlineLargeFontWeight}" />
    </Style>
    <Style Selector="^[(theming|MaterialAssist.ControlSize)=ExtraLarge] /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="LineHeight" Value="{DynamicResource MaterialHeadlineLargeLineHeight}" />
      <Setter Property="LetterSpacing" Value="{DynamicResource MaterialHeadlineLargeLetterSpacing}" />
    </Style>
    <Style Selector="^[(theming|MaterialAssist.IsIconButton)=False]">
      <Style Selector="^ /template/ ContentPresenter#PART_ContentPresenter PathIcon">
        <Setter Property="Width" Value="20" />
        <Setter Property="Height" Value="20" />
      </Style>
      <Style Selector="^[(theming|MaterialAssist.ControlSize)=Medium] /template/ ContentPresenter#PART_ContentPresenter PathIcon">
        <Setter Property="Width" Value="24" />
        <Setter Property="Height" Value="24" />
      </Style>
      <Style Selector="^[(theming|MaterialAssist.ControlSize)=Large] /template/ ContentPresenter#PART_ContentPresenter PathIcon">
        <Setter Property="Width" Value="32" />
        <Setter Property="Height" Value="32" />
      </Style>
      <Style Selector="^[(theming|MaterialAssist.ControlSize)=ExtraLarge] /template/ ContentPresenter#PART_ContentPresenter PathIcon">
        <Setter Property="Width" Value="40" />
        <Setter Property="Height" Value="40" />
      </Style>
      <Style Selector="^ /template/ ContentPresenter#PART_ContentPresenter > StackPanel">
        <Setter Property="Spacing" Value="8" />
      </Style>
      <Style Selector="^[(theming|MaterialAssist.ControlSize)=Large] /template/ ContentPresenter#PART_ContentPresenter > StackPanel">
        <Setter Property="Spacing" Value="12" />
      </Style>
      <Style Selector="^[(theming|MaterialAssist.ControlSize)=ExtraLarge] /template/ ContentPresenter#PART_ContentPresenter > StackPanel">
        <Setter Property="Spacing" Value="16" />
      </Style>
    </Style>

    <Style Selector="^[(theming|MaterialAssist.ButtonShape)=Round]">
      <Setter Property="CornerRadius" Value="{DynamicResource MaterialShapeFullCornerRadius}" />
    </Style>
    <Style Selector="^[(theming|MaterialAssist.ButtonShape)=Square]">
      <Setter Property="CornerRadius" Value="12" />
    </Style>
    <Style Selector="^[(theming|MaterialAssist.ButtonShape)=Square]">
      <Style Selector="^[(theming|MaterialAssist.ControlSize)=Medium]">
        <Setter Property="CornerRadius" Value="16" />
      </Style>
      <Style Selector="^[(theming|MaterialAssist.ControlSize)=Large], ^[(theming|MaterialAssist.ControlSize)=ExtraLarge]">
        <Setter Property="CornerRadius" Value="28" />
      </Style>
    </Style>
    <Style Selector="^[(theming|MaterialAssist.ButtonVariant)=Outlined]">
      <Style Selector="^[(theming|MaterialAssist.ControlSize)=Large]">
        <Setter Property="BorderThickness" Value="2" />
      </Style>
      <Style Selector="^[(theming|MaterialAssist.ControlSize)=ExtraLarge]">
        <Setter Property="BorderThickness" Value="3" />
      </Style>
    </Style>

    <Style Selector="^[(theming|MaterialAssist.IsIconButton)=True]">
      <Setter Property="Padding" Value="0" />
      <Setter Property="MinWidth" Value="48" />
      <Setter Property="theming:MaterialAssist.ContainerInset" Value="4" />
      <Setter Property="FontSize" Value="24" />
      <!-- StandardIconButtonTokens: no container, icon uses OnSurfaceVariant. -->
      <Style Selector="^[(theming|MaterialAssist.ButtonVariant)=Standard], ^[(theming|MaterialAssist.ButtonVariant)=Text]">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource MaterialOnSurfaceVariantBrush}" />
      </Style>
    </Style>
    <Style Selector="^[(theming|MaterialAssist.IsIconButton)=True] /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="LineHeight" Value="NaN" />
      <Setter Property="LetterSpacing" Value="0" />
    </Style>
    <Style Selector="^[(theming|MaterialAssist.IsIconButton)=True] /template/ Viewbox#ContentHost">
      <Setter Property="Width" Value="24" />
      <Setter Property="Height" Value="24" />
      <Setter Property="Stretch" Value="Uniform" />
    </Style>
    <Style Selector="^[(theming|MaterialAssist.IsIconButton)=True]">
      <Style Selector="^[(theming|MaterialAssist.ControlSize)=ExtraSmall]">
        <Setter Property="MinWidth" Value="48" />
        <Setter Property="theming:MaterialAssist.ContainerInset" Value="8" />
        <Setter Property="FontSize" Value="20" />
        <Style Selector="^ /template/ Viewbox#ContentHost">
          <Setter Property="Width" Value="20" />
          <Setter Property="Height" Value="20" />
        </Style>
      </Style>
      <Style Selector="^[(theming|MaterialAssist.ControlSize)=Medium]">
        <Setter Property="MinWidth" Value="56" />
        <Setter Property="theming:MaterialAssist.ContainerInset" Value="0" />
      </Style>
      <Style Selector="^[(theming|MaterialAssist.ControlSize)=Large]">
        <Setter Property="MinWidth" Value="96" />
        <Setter Property="FontSize" Value="32" />
        <Setter Property="theming:MaterialAssist.ContainerInset" Value="0" />
        <Style Selector="^ /template/ Viewbox#ContentHost">
          <Setter Property="Width" Value="32" />
          <Setter Property="Height" Value="32" />
        </Style>
      </Style>
      <Style Selector="^[(theming|MaterialAssist.ControlSize)=ExtraLarge]">
        <Setter Property="MinWidth" Value="136" />
        <Setter Property="FontSize" Value="40" />
        <Setter Property="theming:MaterialAssist.ContainerInset" Value="0" />
        <Style Selector="^ /template/ Viewbox#ContentHost">
          <Setter Property="Width" Value="40" />
          <Setter Property="Height" Value="40" />
        </Style>
      </Style>
    </Style>

    <Style Selector="^:pointerover /template/ Border#StateLayer">
      <Setter Property="Opacity" Value="{DynamicResource MaterialHoverStateLayerOpacity}" />
    </Style>
    <Style Selector="^:focus-visible /template/ Border#StateLayer">
      <Setter Property="Opacity" Value="{DynamicResource MaterialFocusStateLayerOpacity}" />
    </Style>
    <Style Selector="^:focus-visible /template/ Border#FocusRing">
      <Setter Property="IsVisible" Value="True" />
    </Style>
    <Style Selector="^:pressed /template/ Border#StateLayer">
      <Setter Property="Opacity" Value="{DynamicResource MaterialPressedStateLayerOpacity}" />
    </Style>
    <!-- Disabled: container OnSurface at the token opacity, label OnSurfaceVariant at 0.38. -->
    <Style Selector="^:disabled">
      <Setter Property="Background" Value="{DynamicResource MaterialOnSurfaceBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource MaterialOnSurfaceVariantBrush}" />
      <Setter Property="BorderBrush" Value="Transparent" />
    </Style>
    <Style Selector="^[(theming|MaterialAssist.ButtonVariant)=Outlined]:disabled">
      <Setter Property="BorderBrush" Value="{DynamicResource MaterialOutlineVariantBrush}" />
    </Style>
    <Style Selector="^[(theming|MaterialAssist.ButtonVariant)=Text]:disabled">
      <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style Selector="^:disabled /template/ Border#Surface">
      <Setter Property="Opacity" Value="0.10" />
      <Setter Property="BoxShadow" Value="{DynamicResource MaterialElevationLevel0Shadow}" />
    </Style>
    <!-- FilledTonalButtonTokens.DisabledContainerOpacity = 0.12. -->
    <Style Selector="^[(theming|MaterialAssist.ButtonVariant)=Tonal]:disabled /template/ Border#Surface">
      <Setter Property="Opacity" Value="0.12" />
    </Style>
    <Style Selector="^:disabled /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Opacity" Value="0.38" />
    </Style>
    <Style Selector="^[(theming|MaterialAssist.IsIconButton)=True]:disabled">
      <Setter Property="Foreground" Value="{DynamicResource MaterialOnSurfaceBrush}" />
    </Style>
    <!-- Standard and text icon buttons have no container in any state. -->
    <Style Selector="^[(theming|MaterialAssist.IsIconButton)=True]">
      <Style Selector="^[(theming|MaterialAssist.ButtonVariant)=Standard]:disabled, ^[(theming|MaterialAssist.ButtonVariant)=Text]:disabled">
        <Setter Property="Background" Value="Transparent" />
      </Style>
    </Style>
    <Style Selector="^[(theming|MaterialAssist.IsIconButton)=True]">
      <Style Selector="^[(theming|MaterialAssist.ButtonVariant)=Text]">
        <Setter Property="Foreground" Value="{DynamicResource MaterialOnSurfaceVariantBrush}" />
        <Style Selector="^:disabled">
          <Setter Property="Foreground" Value="{DynamicResource MaterialOnSurfaceBrush}" />
        </Style>
      </Style>
    </Style>
    <Style Selector="^:disabled /template/ Border#StateLayer">
      <Setter Property="Opacity" Value="0" />
    </Style>
    <Style Selector="^:disabled /template/ Border#FocusRing">
      <Setter Property="IsVisible" Value="False" />
    </Style>
  </ControlTheme>

  <ControlTheme x:Key="{x:Type Button}" TargetType="Button" BasedOn="{StaticResource MaterialButtonBase}" />

  <ControlTheme x:Key="{x:Type ToggleButton}" TargetType="ToggleButton" BasedOn="{StaticResource MaterialButtonBase}">
    <Setter Property="Background" Value="{DynamicResource MaterialSurfaceContainerBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource MaterialOnSurfaceVariantBrush}" />
    <Style Selector="^[(theming|MaterialAssist.ButtonVariant)=Standard]:not(:checked):not(:disabled), ^[(theming|MaterialAssist.ButtonVariant)=Filled]:not(:checked):not(:disabled)">
      <Setter Property="Background" Value="{DynamicResource MaterialSurfaceContainerBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource MaterialOnSurfaceVariantBrush}" />
    </Style>
    <Style Selector="^[(theming|MaterialAssist.ButtonVariant)=Tonal]:not(:checked):not(:disabled)">
      <Setter Property="Background" Value="{DynamicResource MaterialSecondaryContainerBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource MaterialOnSecondaryContainerBrush}" />
    </Style>
    <Style Selector="^[(theming|MaterialAssist.ButtonVariant)=Outlined]:not(:checked):not(:disabled)">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Foreground" Value="{DynamicResource MaterialOnSurfaceVariantBrush}" />
    </Style>
    <Style Selector="^[(theming|MaterialAssist.ButtonVariant)=Elevated]:not(:checked):not(:disabled)">
      <Setter Property="Background" Value="{DynamicResource MaterialSurfaceContainerLowBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource MaterialPrimaryBrush}" />
    </Style>
    <Style Selector="^[(theming|MaterialAssist.ButtonVariant)=Text]:not(:checked):not(:disabled)">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Foreground" Value="{DynamicResource MaterialOnSurfaceVariantBrush}" />
    </Style>
    <!-- A standard icon toggle has no container until it is selected. -->
    <Style Selector="^[(theming|MaterialAssist.IsIconButton)=True]">
      <Style Selector="^[(theming|MaterialAssist.ButtonVariant)=Standard]:not(:checked):not(:disabled), ^[(theming|MaterialAssist.ButtonVariant)=Text]:not(:checked):not(:disabled)">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource MaterialOnSurfaceVariantBrush}" />
      </Style>
    </Style>
    <Style Selector="^:checked:not(:disabled)">
      <Setter Property="Background" Value="{DynamicResource MaterialPrimaryBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource MaterialOnPrimaryBrush}" />
    </Style>
    <Style Selector="^[(theming|MaterialAssist.ButtonVariant)=Tonal]:checked:not(:disabled)">
      <Setter Property="Background" Value="{DynamicResource MaterialSecondaryBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource MaterialOnSecondaryBrush}" />
    </Style>
    <Style Selector="^[(theming|MaterialAssist.ButtonVariant)=Outlined]:checked:not(:disabled)">
      <Setter Property="Background" Value="{DynamicResource MaterialInverseSurfaceBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource MaterialInverseOnSurfaceBrush}" />
      <Setter Property="BorderBrush" Value="Transparent" />
    </Style>
    <Style Selector="^[(theming|MaterialAssist.ButtonVariant)=Elevated]:checked:not(:disabled)">
      <Setter Property="Background" Value="{DynamicResource MaterialPrimaryBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource MaterialOnPrimaryBrush}" />
    </Style>
    <!-- TextButtonTokens define no selected container, so a checked text toggle keeps
         the text-button colors instead of becoming a filled button. -->
    <Style Selector="^[(theming|MaterialAssist.ButtonVariant)=Text]:checked:not(:disabled)">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Foreground" Value="{DynamicResource MaterialOnSurfaceVariantBrush}" />
    </Style>
    <Style Selector="^[(theming|MaterialAssist.IsIconButton)=True]">
      <Style Selector="^[(theming|MaterialAssist.ButtonVariant)=Text]:checked:not(:disabled)">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource MaterialOnSurfaceVariantBrush}" />
      </Style>
    </Style>
    <Style Selector="^:disabled">
      <Setter Property="Background" Value="{DynamicResource MaterialOnSurfaceBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource MaterialOnSurfaceVariantBrush}" />
      <Setter Property="BorderBrush" Value="Transparent" />
    </Style>
    <Style Selector="^[(theming|MaterialAssist.ButtonVariant)=Outlined]:disabled">
      <Setter Property="BorderBrush" Value="{DynamicResource MaterialOutlineVariantBrush}" />
    </Style>
    <Style Selector="^[(theming|MaterialAssist.ButtonVariant)=Text]:disabled">
      <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style Selector="^[(theming|MaterialAssist.IsIconButton)=True]:disabled">
      <Setter Property="Foreground" Value="{DynamicResource MaterialOnSurfaceBrush}" />
    </Style>
    <Style Selector="^[(theming|MaterialAssist.IsIconButton)=True]">
      <Style Selector="^[(theming|MaterialAssist.ButtonVariant)=Standard]:disabled, ^[(theming|MaterialAssist.ButtonVariant)=Text]:disabled">
        <Setter Property="Background" Value="Transparent" />
      </Style>
    </Style>
    <Style Selector="^[(theming|MaterialAssist.ButtonVariant)=Outlined]:checked:disabled">
      <Setter Property="Background" Value="{DynamicResource MaterialOnSurfaceBrush}" />
      <Setter Property="BorderBrush" Value="Transparent" />
    </Style>
    <Style Selector="^[(theming|MaterialAssist.ButtonVariant)=Outlined]:checked:disabled /template/ Border#Surface">
      <Setter Property="Opacity" Value="0.10" />
    </Style>
  </ControlTheme>
</ResourceDictionary>
