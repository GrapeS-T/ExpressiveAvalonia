<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:controls="using:ExpressiveAvalonia.Controls"
                    xmlns:theming="using:ExpressiveAvalonia.Theming">
  <!-- AndroidX Button*Tokens, *ToggleButtonTokens and *IconButtonTokens. Visual containers are
       distinct from touch targets: ContainerInset reserves the 48-DIP target while the Surface
       keeps the token size (32/40/56/96/136 for labeled buttons, the per-width content box for
       icon buttons). -->
  <!-- Standard Avalonia buttons retain command, keyboard (Space/Enter), access-key, automation
       and ToggleButton checked behavior; the theme only supplies the Material anatomy. -->
  <!-- Anatomy per source design data (all five sizes, both shapes, every state):
         Size      Container  Padding      Type style        Icon  Icon/label gap
         XSmall    32         12,6         label/large 14/20  20    4
         Small     40         16,10        label/large 14/20  20    8
         Medium    56         24,16        title/medium 16/24 24    8
         Large     96         48,32        headline/small 24/32 32  12
         XLarge    136        64,48        headline/large 32/40 40  16
       Round corners are CornerFull (a true half-min-dimension pill); Square corners are the
       CornerMedium/CornerLarge/CornerExtraLarge token per size, pressed corners are
       CornerSmall/CornerMedium/CornerLarge, and the checked silhouette swaps Round<->Square
       exactly as ToggleButtonDefaults/IconButtonDefaults specify. MaterialAssist resolves every
       corner logically (start/end), maps them for RTL, clamps each edge pair to the smaller
       dimension and re-resolves a percentage corner when the bounds change. -->
  <!-- Interaction: MaterialAssist.MaterialRipple is the source RippleNode, not a vector overlay.
       It draws the hover/focus state layer at StateTokens opacity and the bounded press ripple
       (75 ms fade-in / 225 ms radius / 150 ms fade-out, 30% start radius, 10 DIP extra end radius,
       pointer origin and centre target). Keyboard Space/Enter and non-button hosts start at the
       centre. The ripple is the only pressed indication: there is no second state-layer alpha in
       this template. -->
  <!-- Motion: MaterialAssist uses MotionSchemeKeyTokens.DefaultEffects for Button and every
       IconButton (including icon toggles; 1600 stiffness / 1 damping in both schemes) and
       FastSpatial for a labeled ToggleButton, exactly like the pinned sources. Plain Button.kt
       documents DefaultEffects as intentional to prevent any bounce. Both use the Float
       visibility threshold 0.01. Elevation uses the pinned 120 ms incoming / 150 ms outgoing
       tweens. The labeled ToggleButton BorderStroke also follows animateBorderStrokeAsState:
       its width interpolates with FastSpatial and its solid color with DefaultEffects, so the
       Outline border paints the animated channel, not the caller's target properties. All
       honour MaterialMotion.IsReduced: reduced mode snaps to the final interactive state and
       the ripple renders statically while pressed. -->
  <ControlTheme x:Key="MaterialButtonBase" TargetType="Button">
    <Setter Property="Background" Value="{DynamicResource MaterialPrimaryBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource MaterialOnPrimaryBrush}" />
    <Setter Property="BorderBrush" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="CornerRadius" Value="{DynamicResource MaterialShapeFullCornerRadius}" />
    <Setter Property="Padding" Value="16,10" />
    <Setter Property="MinHeight" Value="48" />
    <Setter Property="MinWidth" Value="58" />
    <Setter Property="FontFamily" Value="{DynamicResource MaterialFontFamily}" />
    <Setter Property="FontSize" Value="{DynamicResource MaterialLabelLargeFontSize}" />
    <Setter Property="FontWeight" Value="{DynamicResource MaterialLabelLargeFontWeight}" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="theming:MaterialAssist.ContainerInset" Value="0,4" />
    <Setter Property="theming:MaterialAssist.AnimateShape" Value="True" />
    <Setter Property="Template">
      <ControlTemplate>
        <Panel Background="Transparent">
          <Panel Margin="{TemplateBinding theming:MaterialAssist.ContainerInset}">
          <Border Name="Surface"
                  Background="{TemplateBinding Background}"
                  BoxShadow="{TemplateBinding theming:MaterialAssist.AnimatedShadow}"
                  CornerRadius="{TemplateBinding theming:MaterialAssist.AnimatedCornerRadius}" />
          <!-- The outline is a separate border so an outlined button keeps a crisp stroke while
               its container stays transparent; the stroke is token 1 DIP up to Medium and 2/3 DIP
               for Large/XLarge. ToggleButton.kt animates the BorderStroke itself: width uses
               FastSpatial and the solid color uses DefaultEffects, so the template paints the
               animated channel instead of the styled target. -->
          <Border Name="Outline"
                  Background="Transparent"
                  BorderBrush="{TemplateBinding theming:MaterialAssist.AnimatedOutlineBrush}"
                  BorderThickness="{TemplateBinding theming:MaterialAssist.AnimatedOutlineThickness}"
                  CornerRadius="{TemplateBinding theming:MaterialAssist.AnimatedCornerRadius}"
                  IsHitTestVisible="False" />
          <Viewbox Name="ContentHost" Stretch="None"
                   HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                   VerticalAlignment="{TemplateBinding VerticalContentAlignment}">
          <!-- The icon host is a sibling of the content presenter so the icon sits inside the
               token padding. Its spacing is a right margin, which collapses with the host, so a
               button without an icon keeps the exact token content width. -->
          <StackPanel Name="ContentRoot" Orientation="Horizontal"
                      Margin="{TemplateBinding Padding}">
          <ContentPresenter Name="IconHost"
                            Content="{TemplateBinding theming:MaterialAssist.DisplayedIcon}"
                            IsVisible="{TemplateBinding theming:MaterialAssist.IsIconVisible}"
                            VerticalAlignment="Center" />
          <ContentPresenter Name="PART_ContentPresenter"
                            Content="{TemplateBinding Content}"
                            ContentTemplate="{TemplateBinding ContentTemplate}"
                            Padding="0"
                            HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                            VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"
                            LineHeight="{DynamicResource MaterialLabelLargeLineHeight}"
                            LetterSpacing="{DynamicResource MaterialLabelLargeLetterSpacing}"
                            RecognizesAccessKey="True" />
          </StackPanel>
          </Viewbox>
          <!-- Source RippleNode draws the state layer and the press ripple above the content of
               its target. The node clips bounded ripples itself, so no extra ClipToBounds and no
               second pressed alpha are needed. -->
          <theming:MaterialRipple Name="Ripple"
                                  Fill="{TemplateBinding Foreground}"
                                  CornerRadius="{TemplateBinding theming:MaterialAssist.AnimatedCornerRadius}"
                                  PressOpacity="{DynamicResource MaterialPressedStateLayerOpacity}"
                                  HoverOpacity="{DynamicResource MaterialHoverStateLayerOpacity}"
                                  FocusOpacity="{DynamicResource MaterialFocusStateLayerOpacity}"
                                  EnableDrag="False"
                                  IsHitTestVisible="False" />
          <!-- 3 DIP secondary ring, two DIPs outside the animated silhouette. Its own bounds are
               enlarged by the margin, so the binding adds the same two DIPs to the corner. -->
          <controls:MaterialFocusIndicator Name="FocusRing" Margin="-2"
                                           IsActive="True" IsVisible="False"
                                           Stroke="{DynamicResource MaterialSecondaryBrush}"
                                           StrokeThickness="3"
                                           CornerRadius="{TemplateBinding theming:MaterialAssist.FocusRingCornerRadius}"
                                           IsHitTestVisible="False" />
          </Panel>
        </Panel>
      </ControlTemplate>
    </Setter>

    <!-- Color treatments. The ripple (state layer + press) reuses Foreground, which is exactly
         the token's state-layer color in every variant: onPrimary, primary,
         onSecondaryContainer, onSurfaceVariant and inverseOnSurface. -->
    <Style Selector="^[(theming|MaterialAssist.ButtonVariant)=Filled]">
      <Setter Property="Background" Value="{DynamicResource MaterialPrimaryBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource MaterialOnPrimaryBrush}" />
    </Style>
    <Style Selector="^[(theming|MaterialAssist.ButtonVariant)=Tonal]">
      <Setter Property="Background" Value="{DynamicResource MaterialSecondaryContainerBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource MaterialOnSecondaryContainerBrush}" />
    </Style>
    <Style Selector="^[(theming|MaterialAssist.ButtonVariant)=Outlined]">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Foreground" Value="{DynamicResource MaterialOnSurfaceVariantBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource MaterialOutlineVariantBrush}" />
      <Setter Property="BorderThickness" Value="1" />
    </Style>
    <Style Selector="^[(theming|MaterialAssist.ButtonVariant)=Elevated]">
      <Setter Property="Background" Value="{DynamicResource MaterialSurfaceContainerLowBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource MaterialPrimaryBrush}" />
    </Style>
    <!-- TextButtonTokens: label and icon are Primary and the state layer is Primary. The
         container stays transparent in every enabled state. -->
    <Style Selector="^[(theming|MaterialAssist.ButtonVariant)=Text]">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Foreground" Value="{DynamicResource MaterialPrimaryBrush}" />
    </Style>

    <!-- Sizes: container height, token padding, type scale, icon size and icon gap. The control's
         MinHeight is the 48 DIP touch target; ContainerInset shrinks the visible Surface to the
         token container height (32/40 for XSmall/Small). -->
    <Style Selector="^[(theming|MaterialAssist.ControlSize)=ExtraSmall]">
      <Setter Property="MinHeight" Value="48" />
      <Setter Property="theming:MaterialAssist.ContainerInset" Value="0,8" />
      <Setter Property="Padding" Value="12,6" />
      <Style Selector="^ /template/ ContentPresenter#IconHost">
        <Setter Property="Margin" Value="0,0,4,0" />
      </Style>
      <Style Selector="^ /template/ ContentPresenter#IconHost PathIcon">
        <Setter Property="Width" Value="20" />
        <Setter Property="Height" Value="20" />
      </Style>
      <Style Selector="^ /template/ ContentPresenter#PART_ContentPresenter PathIcon">
        <Setter Property="Width" Value="20" />
        <Setter Property="Height" Value="20" />
      </Style>
    </Style>
    <Style Selector="^[(theming|MaterialAssist.ControlSize)=Small]">
      <Setter Property="MinHeight" Value="48" />
      <Setter Property="theming:MaterialAssist.ContainerInset" Value="0,4" />
      <Setter Property="Padding" Value="16,10" />
      <Style Selector="^ /template/ ContentPresenter#IconHost">
        <Setter Property="Margin" Value="0,0,8,0" />
      </Style>
      <Style Selector="^ /template/ ContentPresenter#IconHost PathIcon">
        <Setter Property="Width" Value="20" />
        <Setter Property="Height" Value="20" />
      </Style>
      <Style Selector="^ /template/ ContentPresenter#PART_ContentPresenter PathIcon">
        <Setter Property="Width" Value="20" />
        <Setter Property="Height" Value="20" />
      </Style>
    </Style>
    <Style Selector="^[(theming|MaterialAssist.ControlSize)=Medium]">
      <Setter Property="MinHeight" Value="56" />
      <Setter Property="theming:MaterialAssist.ContainerInset" Value="0" />
      <Setter Property="Padding" Value="24,16" />
      <Setter Property="FontSize" Value="{DynamicResource MaterialTitleMediumFontSize}" />
      <Setter Property="FontWeight" Value="{DynamicResource MaterialTitleMediumFontWeight}" />
      <Style Selector="^ /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="LineHeight" Value="{DynamicResource MaterialTitleMediumLineHeight}" />
        <Setter Property="LetterSpacing" Value="{DynamicResource MaterialTitleMediumLetterSpacing}" />
      </Style>
      <Style Selector="^ /template/ ContentPresenter#IconHost">
        <Setter Property="Margin" Value="0,0,8,0" />
      </Style>
      <Style Selector="^ /template/ ContentPresenter#IconHost PathIcon">
        <Setter Property="Width" Value="24" />
        <Setter Property="Height" Value="24" />
      </Style>
      <Style Selector="^ /template/ ContentPresenter#PART_ContentPresenter PathIcon">
        <Setter Property="Width" Value="24" />
        <Setter Property="Height" Value="24" />
      </Style>
    </Style>
    <Style Selector="^[(theming|MaterialAssist.ControlSize)=Large]">
      <Setter Property="MinHeight" Value="96" />
      <Setter Property="theming:MaterialAssist.ContainerInset" Value="0" />
      <Setter Property="Padding" Value="48,32" />
      <Setter Property="FontSize" Value="{DynamicResource MaterialHeadlineSmallFontSize}" />
      <Setter Property="FontWeight" Value="{DynamicResource MaterialHeadlineSmallFontWeight}" />
      <Style Selector="^ /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="LineHeight" Value="{DynamicResource MaterialHeadlineSmallLineHeight}" />
        <Setter Property="LetterSpacing" Value="{DynamicResource MaterialHeadlineSmallLetterSpacing}" />
      </Style>
      <Style Selector="^ /template/ ContentPresenter#IconHost">
        <Setter Property="Margin" Value="0,0,12,0" />
      </Style>
      <Style Selector="^ /template/ ContentPresenter#IconHost PathIcon">
        <Setter Property="Width" Value="32" />
        <Setter Property="Height" Value="32" />
      </Style>
      <Style Selector="^ /template/ ContentPresenter#PART_ContentPresenter PathIcon">
        <Setter Property="Width" Value="32" />
        <Setter Property="Height" Value="32" />
      </Style>
    </Style>
    <Style Selector="^[(theming|MaterialAssist.ControlSize)=ExtraLarge]">
      <Setter Property="MinHeight" Value="136" />
      <Setter Property="theming:MaterialAssist.ContainerInset" Value="0" />
      <Setter Property="Padding" Value="64,48" />
      <Setter Property="FontSize" Value="{DynamicResource MaterialHeadlineLargeFontSize}" />
      <Setter Property="FontWeight" Value="{DynamicResource MaterialHeadlineLargeFontWeight}" />
      <Style Selector="^ /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="LineHeight" Value="{DynamicResource MaterialHeadlineLargeLineHeight}" />
        <Setter Property="LetterSpacing" Value="{DynamicResource MaterialHeadlineLargeLetterSpacing}" />
      </Style>
      <Style Selector="^ /template/ ContentPresenter#IconHost">
        <Setter Property="Margin" Value="0,0,16,0" />
      </Style>
      <Style Selector="^ /template/ ContentPresenter#IconHost PathIcon">
        <Setter Property="Width" Value="40" />
        <Setter Property="Height" Value="40" />
      </Style>
      <Style Selector="^ /template/ ContentPresenter#PART_ContentPresenter PathIcon">
        <Setter Property="Width" Value="40" />
        <Setter Property="Height" Value="40" />
      </Style>
    </Style>
    <!-- A consumer that composes its own icon + label StackPanel as Content keeps the token gap. -->
    <Style Selector="^ /template/ ContentPresenter#PART_ContentPresenter > StackPanel">
      <Setter Property="Spacing" Value="8" />
    </Style>
    <Style Selector="^[(theming|MaterialAssist.ControlSize)=ExtraSmall] /template/ ContentPresenter#PART_ContentPresenter > StackPanel">
      <Setter Property="Spacing" Value="4" />
    </Style>
    <Style Selector="^[(theming|MaterialAssist.ControlSize)=Large] /template/ ContentPresenter#PART_ContentPresenter > StackPanel">
      <Setter Property="Spacing" Value="12" />
    </Style>
    <Style Selector="^[(theming|MaterialAssist.ControlSize)=ExtraLarge] /template/ ContentPresenter#PART_ContentPresenter > StackPanel">
      <Setter Property="Spacing" Value="16" />
    </Style>

    <!-- The icon gap is a physical right margin in LTR; in RTL the StackPanel reverses the child
         order, so the same gap must sit on the icon's left. -->
    <Style Selector="^:rtl /template/ ContentPresenter#IconHost">
      <Setter Property="Margin" Value="8,0,0,0" />
    </Style>
    <Style Selector="^[(theming|MaterialAssist.ControlSize)=ExtraSmall]:rtl /template/ ContentPresenter#IconHost">
      <Setter Property="Margin" Value="4,0,0,0" />
    </Style>
    <Style Selector="^[(theming|MaterialAssist.ControlSize)=Large]:rtl /template/ ContentPresenter#IconHost">
      <Setter Property="Margin" Value="12,0,0,0" />
    </Style>
    <Style Selector="^[(theming|MaterialAssist.ControlSize)=ExtraLarge]:rtl /template/ ContentPresenter#IconHost">
      <Setter Property="Margin" Value="16,0,0,0" />
    </Style>
    <Style Selector="^[(theming|MaterialAssist.IsIconButton)=True]:rtl /template/ ContentPresenter#IconHost">
      <Setter Property="Margin" Value="0" />
    </Style>

    <!-- Silhouettes. Round is CornerFull; Square uses the per-size token. -->
    <Style Selector="^[(theming|MaterialAssist.ButtonShape)=Round]">
      <Setter Property="CornerRadius" Value="{DynamicResource MaterialShapeFullCornerRadius}" />
    </Style>
    <Style Selector="^[(theming|MaterialAssist.ButtonShape)=Square]">
      <Setter Property="CornerRadius" Value="12" />
    </Style>
    <Style Selector="^[(theming|MaterialAssist.ButtonShape)=Square]">
      <Style Selector="^[(theming|MaterialAssist.ControlSize)=Medium]">
        <Setter Property="CornerRadius" Value="16" />
      </Style>
      <Style Selector="^[(theming|MaterialAssist.ControlSize)=Large], ^[(theming|MaterialAssist.ControlSize)=ExtraLarge]">
        <Setter Property="CornerRadius" Value="28" />
      </Style>
    </Style>
    <!-- Outline weight follows the token stroke: 1 for XSmall/Small/Medium, 2 Large, 3 XLarge. -->
    <Style Selector="^[(theming|MaterialAssist.ButtonVariant)=Outlined]">
      <Style Selector="^[(theming|MaterialAssist.ControlSize)=Large]">
        <Setter Property="BorderThickness" Value="2" />
      </Style>
      <Style Selector="^[(theming|MaterialAssist.ControlSize)=ExtraLarge]">
        <Setter Property="BorderThickness" Value="3" />
      </Style>
    </Style>

    <!-- Icon buttons: the Content is the glyph, so there is no padding and no label. The icon
         box is 20/24/24/32/40 and the width axis changes only the container box. -->
    <Style Selector="^[(theming|MaterialAssist.IsIconButton)=True]">
      <Setter Property="Padding" Value="0" />
      <Setter Property="MinWidth" Value="48" />
      <Setter Property="theming:MaterialAssist.ContainerInset" Value="4" />
      <Setter Property="FontSize" Value="24" />
      <!-- StandardIconButtonTokens: no container, icon uses OnSurfaceVariant. -->
      <Style Selector="^[(theming|MaterialAssist.ButtonVariant)=Standard], ^[(theming|MaterialAssist.ButtonVariant)=Text]">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource MaterialOnSurfaceVariantBrush}" />
      </Style>
    </Style>
    <Style Selector="^[(theming|MaterialAssist.IsIconButton)=True] /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="LineHeight" Value="NaN" />
      <Setter Property="LetterSpacing" Value="0" />
    </Style>
    <Style Selector="^[(theming|MaterialAssist.IsIconButton)=True] /template/ Viewbox#ContentHost">
      <Setter Property="Width" Value="24" />
      <Setter Property="Height" Value="24" />
      <Setter Property="Stretch" Value="Uniform" />
    </Style>
    <!-- When an icon button uses the Icon/SelectedIcon properties instead of Content, the glyph
         takes the icon-button size and no label gap. -->
    <Style Selector="^[(theming|MaterialAssist.IsIconButton)=True] /template/ ContentPresenter#IconHost">
      <Setter Property="Margin" Value="0" />
    </Style>
    <Style Selector="^[(theming|MaterialAssist.IsIconButton)=True] /template/ ContentPresenter#IconHost PathIcon">
      <Setter Property="Width" Value="24" />
      <Setter Property="Height" Value="24" />
    </Style>
    <!-- The Content glyph of an icon button uses the icon-button size (20/24/24/32/40), not the
         labeled-button size, so the Viewbox never has to rescale it. Per-size overrides are nested
         below, because Avalonia's selector grammar cannot chain two attached-property matches. -->
    <Style Selector="^[(theming|MaterialAssist.IsIconButton)=True] /template/ ContentPresenter#PART_ContentPresenter PathIcon">
      <Setter Property="Width" Value="24" />
      <Setter Property="Height" Value="24" />
    </Style>
    <Style Selector="^[(theming|MaterialAssist.IsIconButton)=True]">
      <Style Selector="^[(theming|MaterialAssist.ControlSize)=ExtraSmall]">
        <Setter Property="FontSize" Value="20" />
        <Style Selector="^ /template/ Viewbox#ContentHost">
          <Setter Property="Width" Value="20" />
          <Setter Property="Height" Value="20" />
        </Style>
        <Style Selector="^ /template/ ContentPresenter#IconHost PathIcon">
          <Setter Property="Width" Value="20" />
          <Setter Property="Height" Value="20" />
        </Style>
        <Style Selector="^ /template/ ContentPresenter#PART_ContentPresenter PathIcon">
          <Setter Property="Width" Value="20" />
          <Setter Property="Height" Value="20" />
        </Style>
      </Style>
      <Style Selector="^[(theming|MaterialAssist.ControlSize)=Medium]">
        <Setter Property="MinHeight" Value="56" />
      </Style>
      <Style Selector="^[(theming|MaterialAssist.ControlSize)=Large]">
        <Setter Property="MinHeight" Value="96" />
        <Setter Property="FontSize" Value="32" />
        <Style Selector="^ /template/ Viewbox#ContentHost">
          <Setter Property="Width" Value="32" />
          <Setter Property="Height" Value="32" />
        </Style>
        <Style Selector="^ /template/ ContentPresenter#IconHost PathIcon">
          <Setter Property="Width" Value="32" />
          <Setter Property="Height" Value="32" />
        </Style>
        <Style Selector="^ /template/ ContentPresenter#PART_ContentPresenter PathIcon">
          <Setter Property="Width" Value="32" />
          <Setter Property="Height" Value="32" />
        </Style>
      </Style>
      <Style Selector="^[(theming|MaterialAssist.ControlSize)=ExtraLarge]">
        <Setter Property="MinHeight" Value="136" />
        <Setter Property="FontSize" Value="40" />
        <Style Selector="^ /template/ Viewbox#ContentHost">
          <Setter Property="Width" Value="40" />
          <Setter Property="Height" Value="40" />
        </Style>
        <Style Selector="^ /template/ ContentPresenter#IconHost PathIcon">
          <Setter Property="Width" Value="40" />
          <Setter Property="Height" Value="40" />
        </Style>
        <Style Selector="^ /template/ ContentPresenter#PART_ContentPresenter PathIcon">
          <Setter Property="Width" Value="40" />
          <Setter Property="Height" Value="40" />
        </Style>
      </Style>
    </Style>
    <!-- Width axis: root box = max(48, content box + insets). Narrow/Default/Wide content boxes
         (XSmallIconButtonTokens..XLargeIconButtonTokens): XSmall 28/32/40, Small 32/40/52,
         Medium 48/56/72, Large 64/96/128, XLarge 104/136/184. Every control is at least the 48 DIP
         touch target while the visible Surface keeps the token box. -->
    <Style Selector="^[(theming|MaterialAssist.IsIconButton)=True]">
      <Style Selector="^[(theming|MaterialAssist.ControlSize)=ExtraSmall]">
        <Style Selector="^[(theming|MaterialAssist.IconButtonWidth)=Narrow]">
          <Setter Property="MinWidth" Value="48" />
          <Setter Property="theming:MaterialAssist.ContainerInset" Value="10,8" />
        </Style>
        <Style Selector="^[(theming|MaterialAssist.IconButtonWidth)=Default]">
          <Setter Property="MinWidth" Value="48" />
          <Setter Property="theming:MaterialAssist.ContainerInset" Value="8,8" />
        </Style>
        <Style Selector="^[(theming|MaterialAssist.IconButtonWidth)=Wide]">
          <Setter Property="MinWidth" Value="48" />
          <Setter Property="theming:MaterialAssist.ContainerInset" Value="4,8" />
        </Style>
      </Style>
      <Style Selector="^[(theming|MaterialAssist.ControlSize)=Small]">
        <Style Selector="^[(theming|MaterialAssist.IconButtonWidth)=Narrow]">
          <Setter Property="MinWidth" Value="48" />
          <Setter Property="theming:MaterialAssist.ContainerInset" Value="8,4" />
        </Style>
        <Style Selector="^[(theming|MaterialAssist.IconButtonWidth)=Default]">
          <Setter Property="MinWidth" Value="48" />
          <Setter Property="theming:MaterialAssist.ContainerInset" Value="4,4" />
        </Style>
        <Style Selector="^[(theming|MaterialAssist.IconButtonWidth)=Wide]">
          <Setter Property="MinWidth" Value="52" />
          <Setter Property="theming:MaterialAssist.ContainerInset" Value="0,4" />
        </Style>
      </Style>
      <Style Selector="^[(theming|MaterialAssist.ControlSize)=Medium]">
        <Style Selector="^[(theming|MaterialAssist.IconButtonWidth)=Narrow]">
          <Setter Property="MinWidth" Value="48" />
          <Setter Property="theming:MaterialAssist.ContainerInset" Value="0" />
        </Style>
        <Style Selector="^[(theming|MaterialAssist.IconButtonWidth)=Default]">
          <Setter Property="MinWidth" Value="56" />
          <Setter Property="theming:MaterialAssist.ContainerInset" Value="0" />
        </Style>
        <Style Selector="^[(theming|MaterialAssist.IconButtonWidth)=Wide]">
          <Setter Property="MinWidth" Value="72" />
          <Setter Property="theming:MaterialAssist.ContainerInset" Value="0" />
        </Style>
      </Style>
      <Style Selector="^[(theming|MaterialAssist.ControlSize)=Large]">
        <Style Selector="^[(theming|MaterialAssist.IconButtonWidth)=Narrow]">
          <Setter Property="MinWidth" Value="64" />
          <Setter Property="theming:MaterialAssist.ContainerInset" Value="0" />
        </Style>
        <Style Selector="^[(theming|MaterialAssist.IconButtonWidth)=Default]">
          <Setter Property="MinWidth" Value="96" />
          <Setter Property="theming:MaterialAssist.ContainerInset" Value="0" />
        </Style>
        <Style Selector="^[(theming|MaterialAssist.IconButtonWidth)=Wide]">
          <Setter Property="MinWidth" Value="128" />
          <Setter Property="theming:MaterialAssist.ContainerInset" Value="0" />
        </Style>
      </Style>
      <Style Selector="^[(theming|MaterialAssist.ControlSize)=ExtraLarge]">
        <Style Selector="^[(theming|MaterialAssist.IconButtonWidth)=Narrow]">
          <Setter Property="MinWidth" Value="104" />
          <Setter Property="theming:MaterialAssist.ContainerInset" Value="0" />
        </Style>
        <Style Selector="^[(theming|MaterialAssist.IconButtonWidth)=Default]">
          <Setter Property="MinWidth" Value="136" />
          <Setter Property="theming:MaterialAssist.ContainerInset" Value="0" />
        </Style>
        <Style Selector="^[(theming|MaterialAssist.IconButtonWidth)=Wide]">
          <Setter Property="MinWidth" Value="184" />
          <Setter Property="theming:MaterialAssist.ContainerInset" Value="0" />
        </Style>
      </Style>
    </Style>

    <!-- Focus indication is the source 3 DIP secondary ring, shown only for :focus-visible so a
         pointer click does not paint keyboard-focus affordances. -->
    <Style Selector="^:focus-visible /template/ controls|MaterialFocusIndicator#FocusRing">
      <Setter Property="IsVisible" Value="True" />
    </Style>

    <!-- Disabled: FilledButtonTokens/ElevatedButtonTokens/OutlinedButtonTokens.
         Container OnSurface at 10%, label and icon OnSurfaceVariant at 38%, outlined stroke
         OutlineVariant at the same 10%. Text and outlined containers stay transparent so no
         blanket grey fill appears. No state layer and no ripple react while disabled. -->
    <Style Selector="^:disabled">
      <Setter Property="Background" Value="{DynamicResource MaterialOnSurfaceBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource MaterialOnSurfaceVariantBrush}" />
      <Setter Property="BorderBrush" Value="Transparent" />
    </Style>
    <Style Selector="^:disabled /template/ Border#Surface">
      <Setter Property="Opacity" Value="0.10" />
    </Style>
    <Style Selector="^:disabled /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Opacity" Value="0.38" />
    </Style>
    <Style Selector="^:disabled /template/ ContentPresenter#IconHost">
      <Setter Property="Opacity" Value="0.38" />
    </Style>
    <Style Selector="^:disabled /template/ theming|MaterialRipple#Ripple">
      <Setter Property="Opacity" Value="0" />
    </Style>
    <Style Selector="^:disabled /template/ controls|MaterialFocusIndicator#FocusRing">
      <Setter Property="IsVisible" Value="False" />
    </Style>
    <!-- FilledTonalButtonTokens: the disabled tonal container is OnSurface at 12%, not 10%, and
         the label/icon role is OnSurface. -->
    <Style Selector="^[(theming|MaterialAssist.ButtonVariant)=Tonal]:disabled">
      <Setter Property="Foreground" Value="{DynamicResource MaterialOnSurfaceBrush}" />
    </Style>
    <Style Selector="^[(theming|MaterialAssist.ButtonVariant)=Tonal]:disabled /template/ Border#Surface">
      <Setter Property="Opacity" Value="0.12" />
    </Style>
    <!-- Outlined disabled: transparent container, OutlineVariant stroke at 10%. -->
    <Style Selector="^[(theming|MaterialAssist.ButtonVariant)=Outlined]:disabled">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="{DynamicResource MaterialOutlineVariantBrush}" />
    </Style>
    <Style Selector="^[(theming|MaterialAssist.ButtonVariant)=Outlined]:disabled /template/ Border#Surface">
      <Setter Property="Opacity" Value="1" />
    </Style>
    <Style Selector="^[(theming|MaterialAssist.ButtonVariant)=Outlined]:disabled /template/ Border#Outline">
      <Setter Property="Opacity" Value="0.10" />
    </Style>
    <!-- Text disabled: transparent container, OnSurfaceVariant at 38%. -->
    <Style Selector="^[(theming|MaterialAssist.ButtonVariant)=Text]:disabled">
      <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style Selector="^[(theming|MaterialAssist.ButtonVariant)=Text]:disabled /template/ Border#Surface">
      <Setter Property="Opacity" Value="1" />
    </Style>
    <!-- Icon buttons: Standard/Text keep transparent containers; their disabled glyph is
         OnSurfaceVariant at 38% (StandardIconButtonTokens.DisabledOpacity). Filled/Tonal use an
         OnSurface container at 10% with an OnSurface 38% glyph (FilledIconButtonTokens.
         DisabledContainerOpacity/DisabledOpacity and their FilledTonal counterparts). Outlined
         keeps a transparent container and OnSurface 38% glyph; IconButtonDefaults.
         outlinedIconButtonBorder applies OutlinedIconButtonTokens.DisabledOpacity (0.38) to the
         stroke, so the icon stroke is 38%, not the labeled OutlinedButton 10%. Elevated has no
         upstream icon-button token set; it deliberately follows the filled container here. -->
    <Style Selector="^[(theming|MaterialAssist.IsIconButton)=True]:disabled">
      <Setter Property="Foreground" Value="{DynamicResource MaterialOnSurfaceBrush}" />
    </Style>
    <Style Selector="^[(theming|MaterialAssist.IsIconButton)=True]">
      <Style Selector="^[(theming|MaterialAssist.ButtonVariant)=Standard]:disabled, ^[(theming|MaterialAssist.ButtonVariant)=Text]:disabled">
        <Setter Property="Foreground" Value="{DynamicResource MaterialOnSurfaceVariantBrush}" />
      </Style>
    </Style>
    <Style Selector="^[(theming|MaterialAssist.IsIconButton)=True]">
      <Style Selector="^[(theming|MaterialAssist.ButtonVariant)=Standard]:disabled /template/ Border#Surface, ^[(theming|MaterialAssist.ButtonVariant)=Text]:disabled /template/ Border#Surface">
        <Setter Property="Opacity" Value="1" />
      </Style>
      <Style Selector="^[(theming|MaterialAssist.ButtonVariant)=Standard]:disabled, ^[(theming|MaterialAssist.ButtonVariant)=Text]:disabled">
        <Setter Property="Background" Value="Transparent" />
      </Style>
    </Style>
    <!-- FilledTonalIconButtonTokens.DisabledContainerOpacity is 0.1, not the labeled
         FilledTonalButtonTokens 0.12 the shared Tonal rule above paints. -->
    <Style Selector="^[(theming|MaterialAssist.IsIconButton)=True]">
      <Style Selector="^[(theming|MaterialAssist.ButtonVariant)=Tonal]:disabled /template/ Border#Surface">
        <Setter Property="Opacity" Value="0.10" />
      </Style>
    </Style>
    <Style Selector="^[(theming|MaterialAssist.IsIconButton)=True]">
      <Style Selector="^[(theming|MaterialAssist.ButtonVariant)=Outlined]:disabled">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="{DynamicResource MaterialOutlineVariantBrush}" />
      </Style>
      <Style Selector="^[(theming|MaterialAssist.ButtonVariant)=Outlined]:disabled /template/ Border#Surface">
        <Setter Property="Opacity" Value="1" />
      </Style>
      <Style Selector="^[(theming|MaterialAssist.ButtonVariant)=Outlined]:disabled /template/ Border#Outline">
        <Setter Property="Opacity" Value="0.38" />
      </Style>
    </Style>
  </ControlTheme>

  <ControlTheme x:Key="{x:Type Button}" TargetType="Button" BasedOn="{StaticResource MaterialButtonBase}" />

  <ControlTheme x:Key="{x:Type ToggleButton}" TargetType="ToggleButton" BasedOn="{StaticResource MaterialButtonBase}">
    <Setter Property="Background" Value="{DynamicResource MaterialSurfaceContainerBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource MaterialOnSurfaceVariantBrush}" />
    <!-- Unselected treatments: Standard/Filled keep the surface-container container, Outlined
         keeps its outline, Elevated keeps its level-1 shadow, Text stays transparent. -->
    <Style Selector="^[(theming|MaterialAssist.ButtonVariant)=Standard]:not(:checked):not(:disabled), ^[(theming|MaterialAssist.ButtonVariant)=Filled]:not(:checked):not(:disabled)">
      <Setter Property="Background" Value="{DynamicResource MaterialSurfaceContainerBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource MaterialOnSurfaceVariantBrush}" />
    </Style>
    <Style Selector="^[(theming|MaterialAssist.ButtonVariant)=Tonal]:not(:checked):not(:disabled)">
      <Setter Property="Background" Value="{DynamicResource MaterialSecondaryContainerBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource MaterialOnSecondaryContainerBrush}" />
    </Style>
    <Style Selector="^[(theming|MaterialAssist.ButtonVariant)=Outlined]:not(:checked):not(:disabled)">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Foreground" Value="{DynamicResource MaterialOnSurfaceVariantBrush}" />
    </Style>
    <Style Selector="^[(theming|MaterialAssist.ButtonVariant)=Elevated]:not(:checked):not(:disabled)">
      <Setter Property="Background" Value="{DynamicResource MaterialSurfaceContainerLowBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource MaterialPrimaryBrush}" />
    </Style>
    <Style Selector="^[(theming|MaterialAssist.ButtonVariant)=Text]:not(:checked):not(:disabled)">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Foreground" Value="{DynamicResource MaterialPrimaryBrush}" />
    </Style>
    <!-- A standard icon toggle has no container until it is selected. -->
    <Style Selector="^[(theming|MaterialAssist.IsIconButton)=True]">
      <Style Selector="^[(theming|MaterialAssist.ButtonVariant)=Standard]:not(:checked):not(:disabled), ^[(theming|MaterialAssist.ButtonVariant)=Text]:not(:checked):not(:disabled)">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource MaterialOnSurfaceVariantBrush}" />
      </Style>
    </Style>
    <!-- Selected treatments. ToggleButtonTokens swap container, label and icon together; the
         silhouette swap itself is animated by MaterialAssist. -->
    <Style Selector="^:checked:not(:disabled)">
      <Setter Property="Background" Value="{DynamicResource MaterialPrimaryBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource MaterialOnPrimaryBrush}" />
    </Style>
    <Style Selector="^[(theming|MaterialAssist.ButtonVariant)=Tonal]:checked:not(:disabled)">
      <Setter Property="Background" Value="{DynamicResource MaterialSecondaryBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource MaterialOnSecondaryBrush}" />
    </Style>
    <Style Selector="^[(theming|MaterialAssist.ButtonVariant)=Outlined]:checked:not(:disabled)">
      <Setter Property="Background" Value="{DynamicResource MaterialInverseSurfaceBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource MaterialInverseOnSurfaceBrush}" />
    </Style>
    <Style Selector="^[(theming|MaterialAssist.ButtonVariant)=Elevated]:checked:not(:disabled)">
      <Setter Property="Background" Value="{DynamicResource MaterialPrimaryBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource MaterialOnPrimaryBrush}" />
    </Style>
    <!-- Text toggles define no selected container; a checked text toggle keeps text colors. -->
    <Style Selector="^[(theming|MaterialAssist.ButtonVariant)=Text]:checked:not(:disabled)">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Foreground" Value="{DynamicResource MaterialPrimaryBrush}" />
    </Style>
    <!-- A selected standard icon toggle stays container-less and turns its glyph Primary. -->
    <Style Selector="^[(theming|MaterialAssist.IsIconButton)=True]">
      <Style Selector="^[(theming|MaterialAssist.ButtonVariant)=Standard]:checked:not(:disabled), ^[(theming|MaterialAssist.ButtonVariant)=Text]:checked:not(:disabled)">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource MaterialPrimaryBrush}" />
      </Style>
    </Style>
    <!-- Toggle disabled uses ToggleButtonColors/TonalButtonTokens/ElevatedButtonTokens: container
         OnSurface at 10%, content OnSurfaceVariant at 38%, selected and unselected collapse to
         that one disabled pair. An outlined toggle paints the OutlineVariant 10% container that
         OutlinedToggleButtonDefaults resolves. -->
    <Style Selector="^:disabled">
      <Setter Property="Background" Value="{DynamicResource MaterialOnSurfaceBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource MaterialOnSurfaceVariantBrush}" />
      <Setter Property="BorderBrush" Value="Transparent" />
    </Style>
    <Style Selector="^:disabled /template/ Border#Surface">
      <Setter Property="Opacity" Value="0.10" />
    </Style>
    <Style Selector="^:disabled /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Opacity" Value="0.38" />
    </Style>
    <Style Selector="^:disabled /template/ ContentPresenter#IconHost">
      <Setter Property="Opacity" Value="0.38" />
    </Style>
    <Style Selector="^:disabled /template/ theming|MaterialRipple#Ripple">
      <Setter Property="Opacity" Value="0" />
    </Style>
    <Style Selector="^:disabled /template/ controls|MaterialFocusIndicator#FocusRing">
      <Setter Property="IsVisible" Value="False" />
    </Style>
    <!-- ToggleButtonColors uses TonalButtonTokens (not FilledTonalButtonTokens): a disabled
         tonal toggle is OnSurface at 10% with OnSurfaceVariant content. -->
    <Style Selector="^[(theming|MaterialAssist.ButtonVariant)=Tonal]:disabled">
      <Setter Property="Foreground" Value="{DynamicResource MaterialOnSurfaceVariantBrush}" />
    </Style>
    <Style Selector="^[(theming|MaterialAssist.ButtonVariant)=Tonal]:disabled /template/ Border#Surface">
      <Setter Property="Opacity" Value="0.10" />
    </Style>
    <!-- FilledIconButtonTokens/FilledTonalIconButtonTokens disabled glyphs are OnSurface at 38%. -->
    <Style Selector="^[(theming|MaterialAssist.IsIconButton)=True]">
      <Style Selector="^[(theming|MaterialAssist.ButtonVariant)=Filled]:disabled, ^[(theming|MaterialAssist.ButtonVariant)=Tonal]:disabled, ^[(theming|MaterialAssist.ButtonVariant)=Elevated]:disabled">
        <Setter Property="Foreground" Value="{DynamicResource MaterialOnSurfaceBrush}" />
      </Style>
    </Style>
    <Style Selector="^[(theming|MaterialAssist.ButtonVariant)=Outlined]:disabled">
      <Setter Property="Background" Value="{DynamicResource MaterialOutlineVariantBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource MaterialOutlineVariantBrush}" />
    </Style>
    <Style Selector="^[(theming|MaterialAssist.IsIconButton)=True]">
      <Style Selector="^[(theming|MaterialAssist.ButtonVariant)=Standard]:disabled, ^[(theming|MaterialAssist.ButtonVariant)=Text]:disabled">
        <Setter Property="Background" Value="Transparent" />
      </Style>
      <Style Selector="^[(theming|MaterialAssist.ButtonVariant)=Standard]:disabled /template/ Border#Surface, ^[(theming|MaterialAssist.ButtonVariant)=Text]:disabled /template/ Border#Surface">
        <Setter Property="Opacity" Value="1" />
      </Style>
    </Style>
    <!-- Outlined icon toggles are IconToggleButton, not ToggleButton: defaultOutlinedIcon-
         ToggleButtonColors keeps disabledContainerColor transparent (the labeled outlined toggle
         paints the OutlineVariant 10% container below) and disabledContentColor at
         OutlinedIconButtonTokens.DisabledOpacity 0.38. IconButtonDefaults.outlinedIconToggle-
         ButtonBorder returns outlinedIconButtonBorder(enabled) while unchecked, so the disabled
         stroke is also 38%; the checked rule further down still drops the stroke entirely. -->
    <Style Selector="^[(theming|MaterialAssist.IsIconButton)=True]">
      <Style Selector="^[(theming|MaterialAssist.ButtonVariant)=Outlined]:disabled">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="{DynamicResource MaterialOutlineVariantBrush}" />
      </Style>
      <Style Selector="^[(theming|MaterialAssist.ButtonVariant)=Outlined]:disabled /template/ Border#Surface">
        <Setter Property="Opacity" Value="1" />
      </Style>
      <Style Selector="^[(theming|MaterialAssist.ButtonVariant)=Outlined]:disabled /template/ Border#Outline">
        <Setter Property="Opacity" Value="0.38" />
      </Style>
    </Style>
    <!-- OutlinedToggleButtonDefaults.border / outlinedIconToggleButtonBorder return null while
         checked, independently of enabled; the animated width and color then target zero and
         transparent. Keep this after the disabled outline so a checked disabled item resolves the
         same null stroke as the source. -->
    <Style Selector="^[(theming|MaterialAssist.ButtonVariant)=Outlined]:checked">
      <Setter Property="BorderBrush" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
    </Style>
  </ControlTheme>
  <ControlTheme x:Key="{x:Type HyperlinkButton}" TargetType="HyperlinkButton" BasedOn="{StaticResource MaterialButtonBase}">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{DynamicResource MaterialPrimaryBrush}" />
    <Setter Property="MinWidth" Value="0" />
    <Setter Property="MinHeight" Value="0" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="theming:MaterialAssist.ButtonVariant" Value="Text" />
  </ControlTheme>
</ResourceDictionary>