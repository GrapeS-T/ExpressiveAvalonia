<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:theming="using:ExpressiveAvalonia.Theming"
                    xmlns:controls="clr-namespace:ExpressiveAvalonia.Controls">
  <!-- SliderTokens v2_3_5 / AndroidX SliderDefaults: 16-DIP tracks,
       4 x 44 handles, 6-DIP handle gaps, 2-DIP inside corners, 4-DIP dots.
       PART_Track retains native dragging, keyboard, snapping and automation. -->
  <ControlTheme x:Key="MaterialSliderTrackButtonTheme" TargetType="RepeatButton">
    <Setter Property="Focusable" Value="False" />
    <Setter Property="Template">
      <ControlTemplate><Border Background="Transparent" /></ControlTemplate>
    </Setter>
  </ControlTheme>

  <ControlTheme x:Key="MaterialSliderThumbTheme" TargetType="Thumb">
    <Setter Property="Width" Value="48" />
    <Setter Property="Height" Value="48" />
    <Setter Property="Background" Value="{DynamicResource MaterialPrimaryBrush}" />
    <Setter Property="Template">
      <ControlTemplate>
        <Grid Background="Transparent">
          <Border Name="FocusRing" Width="12" Height="52" CornerRadius="6"
                  BorderBrush="{DynamicResource MaterialPrimaryBrush}" BorderThickness="2"
                  IsVisible="False" IsHitTestVisible="False" />
          <Border Name="Handle" Width="4" Height="44" CornerRadius="2"
                  Background="{TemplateBinding Background}" IsHitTestVisible="False" />
          <Border Name="ValueLabel" IsVisible="False" IsHitTestVisible="False"
                  HorizontalAlignment="Center" VerticalAlignment="Top"
                  Margin="-48,-42,-48,0" MinWidth="40" Height="32" Padding="12,6" CornerRadius="16"
                  Background="{DynamicResource MaterialInverseSurfaceBrush}">
            <TextBlock Text="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}, StringFormat={}{0:G4}}"
                       Foreground="{DynamicResource MaterialInverseOnSurfaceBrush}"
                       FontFamily="{DynamicResource MaterialFontFamily}"
                       FontSize="{DynamicResource MaterialLabelLargeFontSize}"
                       FontWeight="{DynamicResource MaterialLabelLargeFontWeight}"
                       LineHeight="{DynamicResource MaterialLabelLargeLineHeight}"
                       LetterSpacing="{DynamicResource MaterialLabelLargeLetterSpacing}" />
          </Border>
        </Grid>
      </ControlTemplate>
    </Setter>
    <Style Selector="^ /template/ Border#Handle">
      <Setter Property="Transitions">
        <Transitions>
          <DoubleTransition Property="Width" Duration="{DynamicResource MaterialDurationShort4}" Easing="0.2,0,0,1" />
          <DoubleTransition Property="Height" Duration="{DynamicResource MaterialDurationShort4}" Easing="0.2,0,0,1" />
        </Transitions>
      </Setter>
    </Style>
    <Style Selector="^:pointerover /template/ Border#ValueLabel, ^:pressed /template/ Border#ValueLabel">
      <Setter Property="IsVisible" Value="True" />
    </Style>
    <Style Selector="^:focus-visible /template/ Border#ValueLabel, ^[(theming|MaterialSlider.IsOwnerFocused)=True] /template/ Border#ValueLabel">
      <Setter Property="IsVisible" Value="True" />
    </Style>
    <Style Selector="^:focus-visible /template/ Border#FocusRing, ^[(theming|MaterialSlider.IsOwnerFocused)=True] /template/ Border#FocusRing">
      <Setter Property="IsVisible" Value="True" />
    </Style>
    <Style Selector="^:pressed /template/ Border#Handle, ^:focus-visible /template/ Border#Handle, ^[(theming|MaterialSlider.IsOwnerFocused)=True] /template/ Border#Handle">
      <Setter Property="Width" Value="2" />
    </Style>
    <Style Selector="^.vertical /template/ Border#Handle">
      <Setter Property="Width" Value="44" />
      <Setter Property="Height" Value="4" />
    </Style>
    <Style Selector="^.vertical /template/ Border#FocusRing">
      <Setter Property="Width" Value="52" />
      <Setter Property="Height" Value="12" />
    </Style>
    <Style Selector="^.vertical /template/ Border#ValueLabel">
      <Setter Property="HorizontalAlignment" Value="Right" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="Margin" Value="-128,0,58,0" />
    </Style>
    <Style Selector="^.vertical:pressed /template/ Border#Handle, ^.vertical:focus-visible /template/ Border#Handle, ^.vertical[(theming|MaterialSlider.IsOwnerFocused)=True] /template/ Border#Handle">
      <Setter Property="Width" Value="44" />
      <Setter Property="Height" Value="2" />
    </Style>
    <Style Selector="^:disabled">
      <Setter Property="Background" Value="{DynamicResource MaterialOnSurfaceBrush}" />
    </Style>
    <Style Selector="^:disabled /template/ Border#Handle">
      <Setter Property="Width" Value="4" />
      <Setter Property="Opacity" Value="0.38" />
    </Style>
    <Style Selector="^.vertical:disabled /template/ Border#Handle">
      <Setter Property="Width" Value="44" />
      <Setter Property="Height" Value="4" />
    </Style>
    <Style Selector="^:disabled /template/ Border#ValueLabel, ^:disabled /template/ Border#FocusRing">
      <Setter Property="IsVisible" Value="False" />
    </Style>
  </ControlTheme>

  <ControlTheme x:Key="{x:Type Slider}" TargetType="Slider">
    <Setter Property="MinWidth" Value="120" />
    <Setter Property="MinHeight" Value="48" />
    <Setter Property="Focusable" Value="True" />
    <Setter Property="Template">
      <ControlTemplate>
        <Grid Name="SliderRoot" Height="48" Background="Transparent">
          <theming:MaterialSliderTrack Owner="{Binding RelativeSource={RelativeSource TemplatedParent}}"
              IsDragging="{Binding #PART_Handle.IsDragging}"
              ActiveBrush="{DynamicResource MaterialPrimaryBrush}"
              InactiveBrush="{DynamicResource MaterialSecondaryContainerBrush}"
              DisabledBrush="{DynamicResource MaterialOnSurfaceBrush}" IsHitTestVisible="False" />
          <Track Name="PART_Track" Margin="-22,0" Orientation="Horizontal"
                 Minimum="{TemplateBinding Minimum}" Maximum="{TemplateBinding Maximum}"
                 Value="{TemplateBinding Value, Mode=TwoWay}"
                 IsDirectionReversed="{TemplateBinding IsDirectionReversed}">
            <Track.DecreaseButton>
              <RepeatButton Name="PART_DecreaseButton" Theme="{StaticResource MaterialSliderTrackButtonTheme}" />
            </Track.DecreaseButton>
            <Track.IncreaseButton>
              <RepeatButton Name="PART_IncreaseButton" Theme="{StaticResource MaterialSliderTrackButtonTheme}" />
            </Track.IncreaseButton>
            <theming:MaterialSliderThumb Name="PART_Handle" Theme="{StaticResource MaterialSliderThumbTheme}" Tag="{TemplateBinding Value}" />
          </Track>
        </Grid>
      </ControlTemplate>
    </Setter>
    <Style Selector="^:vertical">
      <Setter Property="MinWidth" Value="48" />
      <Setter Property="MinHeight" Value="120" />
      <Setter Property="Template">
        <ControlTemplate>
          <Grid Name="SliderRoot" Width="48" Background="Transparent">
            <theming:MaterialSliderTrack Owner="{Binding RelativeSource={RelativeSource TemplatedParent}}"
                IsDragging="{Binding #PART_Handle.IsDragging}"
                ActiveBrush="{DynamicResource MaterialPrimaryBrush}"
                InactiveBrush="{DynamicResource MaterialSecondaryContainerBrush}"
                DisabledBrush="{DynamicResource MaterialOnSurfaceBrush}" IsHitTestVisible="False" />
            <Track Name="PART_Track" Margin="0,-22" Orientation="Vertical"
                   Minimum="{TemplateBinding Minimum}" Maximum="{TemplateBinding Maximum}"
                   Value="{TemplateBinding Value, Mode=TwoWay}"
                   IsDirectionReversed="{TemplateBinding IsDirectionReversed}">
              <Track.DecreaseButton>
                <RepeatButton Name="PART_DecreaseButton" Theme="{StaticResource MaterialSliderTrackButtonTheme}" />
              </Track.DecreaseButton>
              <Track.IncreaseButton>
                <RepeatButton Name="PART_IncreaseButton" Theme="{StaticResource MaterialSliderTrackButtonTheme}" />
              </Track.IncreaseButton>
              <theming:MaterialSliderThumb Name="PART_Handle" Classes="vertical" Theme="{StaticResource MaterialSliderThumbTheme}" Tag="{TemplateBinding Value}" />
            </Track>
          </Grid>
        </ControlTemplate>
      </Setter>
    </Style>
    <Style Selector="^:focus-visible /template/ Thumb">
      <Setter Property="theming:MaterialSlider.IsOwnerFocused" Value="True" />
    </Style>
  </ControlTheme>

  <ControlTheme x:Key="{x:Type controls:MaterialRangeSlider}" TargetType="controls:MaterialRangeSlider">
    <Setter Property="MinWidth" Value="144" />
    <Setter Property="MinHeight" Value="48" />
    <Setter Property="Template">
      <ControlTemplate>
        <Grid Name="RangeRoot" Height="48" Background="Transparent">
          <theming:MaterialSliderTrack Name="PART_TrackVisual"
              Owner="{Binding RelativeSource={RelativeSource TemplatedParent}}"
              ActiveBrush="{DynamicResource MaterialPrimaryBrush}"
              InactiveBrush="{DynamicResource MaterialSecondaryContainerBrush}"
              DisabledBrush="{DynamicResource MaterialOnSurfaceBrush}" IsHitTestVisible="False" />
          <Canvas Name="PART_TrackCanvas" Height="48">
            <controls:MaterialRangeThumb Name="PART_LowerThumb" Canvas.Top="0"
                     Theme="{StaticResource MaterialSliderThumbTheme}"
                     Tag="{TemplateBinding LowerValue}" AutomationProperties.Name="{DynamicResource MaterialRangeLowerValueText}" />
            <controls:MaterialRangeThumb Name="PART_UpperThumb" Canvas.Top="0"
                     Theme="{StaticResource MaterialSliderThumbTheme}"
                     Tag="{TemplateBinding UpperValue}" AutomationProperties.Name="{DynamicResource MaterialRangeUpperValueText}" />
          </Canvas>
        </Grid>
      </ControlTemplate>
    </Setter>
  </ControlTheme>
</ResourceDictionary>
