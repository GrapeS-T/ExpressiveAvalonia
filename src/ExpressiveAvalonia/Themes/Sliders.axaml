<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:theming="using:ExpressiveAvalonia.Theming"
                    xmlns:controls="clr-namespace:ExpressiveAvalonia.Controls">
  <!-- Material 3 Expressive sliders: XS/S/M/L/XL track and handle tokens,
       6-DIP handle gaps, on-container stops and a 48x44 value indicator.
       Avalonia supplies RTL mirroring, pointer capture, snapping and automation. -->
  <ControlTheme x:Key="MaterialSliderTrackButtonTheme" TargetType="RepeatButton">
    <Setter Property="Focusable" Value="False" />
    <Setter Property="Template">
      <ControlTemplate><Border Background="Transparent" /></ControlTemplate>
    </Setter>
  </ControlTheme>

  <ControlTheme x:Key="MaterialSliderThumbTheme" TargetType="Thumb">
    <Setter Property="Width" Value="48" />
    <Setter Property="Height" Value="48" />
    <Setter Property="Template">
      <ControlTemplate><Border Background="Transparent" /></ControlTemplate>
    </Setter>
  </ControlTheme>

  <ControlTheme x:Key="MaterialSliderValueIndicatorTheme" TargetType="Popup">
    <Setter Property="IsHitTestVisible" Value="False" />
    <Setter Property="TakesFocusFromNativeControl" Value="False" />
    <Setter Property="ShouldUseOverlayLayer" Value="True" />
    <Setter Property="PlacementConstraintAdjustment" Value="FlipX,FlipY,SlideX,SlideY" />
  </ControlTheme>

  <ControlTheme x:Key="{x:Type Slider}" TargetType="Slider">
    <Setter Property="MinWidth" Value="120" />
    <Setter Property="MinHeight" Value="48" />
    <Setter Property="Focusable" Value="True" />
    <Setter Property="ClipToBounds" Value="False" />
    <Setter Property="FocusAdorner" Value="{x:Null}" />
    <!-- The source's default Size is XSmall; callers can opt into the larger sizes. -->
    <Setter Property="theming:MaterialAssist.ControlSize" Value="ExtraSmall" />
    <Setter Property="Template">
      <ControlTemplate>
        <Grid Name="SliderRoot" Background="Transparent" ClipToBounds="False">
          <theming:MaterialSliderTrack Name="PART_TrackVisual"
              Owner="{Binding RelativeSource={RelativeSource TemplatedParent}}"
              Thumb="{Binding #PART_Handle}"
              IsDragging="{Binding #PART_Handle.IsDragging}"
              ActiveBrush="{DynamicResource MaterialPrimaryBrush}"
              InactiveBrush="{DynamicResource MaterialSecondaryContainerBrush}"
              DisabledBrush="{DynamicResource MaterialOnSurfaceBrush}"
              DisabledHandleBrush="{DynamicResource MaterialSliderDisabledHandleBrush}"
              TickBrush="{DynamicResource MaterialOnSecondaryContainerBrush}"
              ActiveTickBrush="{DynamicResource MaterialOnPrimaryBrush}"
              FocusBrush="{DynamicResource MaterialSecondaryBrush}"
              DisabledActiveTickBrush="{DynamicResource MaterialSurfaceBrush}"
              ValueLabel="{Binding #PART_ValueLabel}"
              IconBrush="{DynamicResource MaterialOnPrimaryBrush}"
              IsHitTestVisible="False" />
          <theming:MaterialSliderNativeTrack Name="PART_Track" Margin="-22,0" Orientation="Horizontal"
                 Minimum="{TemplateBinding Minimum}" Maximum="{TemplateBinding Maximum}"
                 Value="{TemplateBinding Value, Mode=TwoWay}"
                 IsDirectionReversed="{TemplateBinding IsDirectionReversed}">
            <theming:MaterialSliderNativeTrack.DecreaseButton>
              <RepeatButton Name="PART_DecreaseButton" Theme="{StaticResource MaterialSliderTrackButtonTheme}" />
            </theming:MaterialSliderNativeTrack.DecreaseButton>
            <theming:MaterialSliderNativeTrack.IncreaseButton>
              <RepeatButton Name="PART_IncreaseButton" Theme="{StaticResource MaterialSliderTrackButtonTheme}" />
            </theming:MaterialSliderNativeTrack.IncreaseButton>
            <theming:MaterialSliderThumb Name="PART_Handle" Theme="{StaticResource MaterialSliderThumbTheme}"
                Height="{Binding Bounds.Height, RelativeSource={RelativeSource TemplatedParent}}" MinHeight="48" />
          </theming:MaterialSliderNativeTrack>
          <Popup Name="PART_ValueLabel" Theme="{StaticResource MaterialSliderValueIndicatorTheme}">
            <Border MinWidth="48" Height="44" CornerRadius="22" Padding="16,0"
                    Background="{DynamicResource MaterialInverseSurfaceBrush}">
              <TextBlock Foreground="{DynamicResource MaterialInverseOnSurfaceBrush}"
                         FontFamily="{DynamicResource MaterialFontFamily}" FontSize="14"
                         LineHeight="20" LetterSpacing="0.5" FontWeight="Normal"
                         HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
          </Popup>
        </Grid>
      </ControlTemplate>
    </Setter>
    <Style Selector="^:vertical">
      <Setter Property="MinWidth" Value="48" />
      <Setter Property="MinHeight" Value="120" />
      <Setter Property="Template">
        <ControlTemplate>
          <Grid Name="SliderRoot" Background="Transparent" ClipToBounds="False">
            <theming:MaterialSliderTrack Name="PART_TrackVisual"
                Owner="{Binding RelativeSource={RelativeSource TemplatedParent}}"
                Thumb="{Binding #PART_Handle}"
                IsDragging="{Binding #PART_Handle.IsDragging}"
                ActiveBrush="{DynamicResource MaterialPrimaryBrush}"
                InactiveBrush="{DynamicResource MaterialSecondaryContainerBrush}"
                DisabledBrush="{DynamicResource MaterialOnSurfaceBrush}"
                DisabledHandleBrush="{DynamicResource MaterialSliderDisabledHandleBrush}"
                TickBrush="{DynamicResource MaterialOnSecondaryContainerBrush}"
                ActiveTickBrush="{DynamicResource MaterialOnPrimaryBrush}"
                FocusBrush="{DynamicResource MaterialSecondaryBrush}"
                DisabledActiveTickBrush="{DynamicResource MaterialSurfaceBrush}"
                ValueLabel="{Binding #PART_ValueLabel}"
                IconBrush="{DynamicResource MaterialOnPrimaryBrush}"
                IsHitTestVisible="False" />
            <theming:MaterialSliderNativeTrack Name="PART_Track" Margin="0,-22" Orientation="Vertical"
                   Minimum="{TemplateBinding Minimum}" Maximum="{TemplateBinding Maximum}"
                   Value="{TemplateBinding Value, Mode=TwoWay}"
                   IsDirectionReversed="{TemplateBinding IsDirectionReversed}">
              <theming:MaterialSliderNativeTrack.DecreaseButton>
                <RepeatButton Name="PART_DecreaseButton" Theme="{StaticResource MaterialSliderTrackButtonTheme}" />
              </theming:MaterialSliderNativeTrack.DecreaseButton>
              <theming:MaterialSliderNativeTrack.IncreaseButton>
                <RepeatButton Name="PART_IncreaseButton" Theme="{StaticResource MaterialSliderTrackButtonTheme}" />
              </theming:MaterialSliderNativeTrack.IncreaseButton>
              <theming:MaterialSliderThumb Name="PART_Handle" Theme="{StaticResource MaterialSliderThumbTheme}"
                  Width="{Binding Bounds.Width, RelativeSource={RelativeSource TemplatedParent}}" MinWidth="48" />
            </theming:MaterialSliderNativeTrack>
            <Popup Name="PART_ValueLabel" Theme="{StaticResource MaterialSliderValueIndicatorTheme}">
              <Border MinWidth="48" Height="44" CornerRadius="22" Padding="16,0"
                      Background="{DynamicResource MaterialInverseSurfaceBrush}">
                <TextBlock Foreground="{DynamicResource MaterialInverseOnSurfaceBrush}"
                           FontFamily="{DynamicResource MaterialFontFamily}" FontSize="14"
                           LineHeight="20" LetterSpacing="0.5" FontWeight="Normal"
                           HorizontalAlignment="Center" VerticalAlignment="Center" />
              </Border>
            </Popup>
          </Grid>
        </ControlTemplate>
      </Setter>
      <Style Selector="^[(theming|MaterialAssist.ControlSize)=Medium]">
        <Setter Property="MinWidth" Value="52" />
      </Style>
      <Style Selector="^[(theming|MaterialAssist.ControlSize)=Large]">
        <Setter Property="MinWidth" Value="68" />
      </Style>
      <Style Selector="^[(theming|MaterialAssist.ControlSize)=ExtraLarge]">
        <Setter Property="MinWidth" Value="108" />
      </Style>
    </Style>
    <!-- Size changes the cross axis only; the length axis keeps its 120-DIP minimum.
         Nested selectors keep the orientation and size conditions in one style tree. -->
    <Style Selector="^:horizontal">
      <Setter Property="MinWidth" Value="120" />
      <Style Selector="^[(theming|MaterialAssist.ControlSize)=Medium]">
        <Setter Property="MinHeight" Value="52" />
      </Style>
      <Style Selector="^[(theming|MaterialAssist.ControlSize)=Large]">
        <Setter Property="MinHeight" Value="68" />
      </Style>
      <Style Selector="^[(theming|MaterialAssist.ControlSize)=ExtraLarge]">
        <Setter Property="MinHeight" Value="108" />
      </Style>
    </Style>
  </ControlTheme>

  <ControlTheme x:Key="{x:Type controls:MaterialRangeSlider}" TargetType="controls:MaterialRangeSlider">
    <Setter Property="MinWidth" Value="144" />
    <Setter Property="MinHeight" Value="48" />
    <Setter Property="ClipToBounds" Value="False" />
    <Setter Property="theming:MaterialAssist.ControlSize" Value="ExtraSmall" />
    <Setter Property="Template">
      <ControlTemplate>
        <Grid Name="RangeRoot" Background="Transparent" FlowDirection="LeftToRight" ClipToBounds="False">
          <theming:MaterialSliderTrack Name="PART_TrackVisual"
              Owner="{Binding RelativeSource={RelativeSource TemplatedParent}}"
              ActiveBrush="{DynamicResource MaterialPrimaryBrush}"
              InactiveBrush="{DynamicResource MaterialSecondaryContainerBrush}"
              DisabledBrush="{DynamicResource MaterialOnSurfaceBrush}"
              DisabledHandleBrush="{DynamicResource MaterialSliderDisabledHandleBrush}"
              TickBrush="{DynamicResource MaterialOnSecondaryContainerBrush}"
              ActiveTickBrush="{DynamicResource MaterialOnPrimaryBrush}"
              FocusBrush="{DynamicResource MaterialSecondaryBrush}"
              DisabledActiveTickBrush="{DynamicResource MaterialSurfaceBrush}"
              ValueLabel="{Binding #PART_ValueLabel}"
              IconBrush="{DynamicResource MaterialOnPrimaryBrush}"
              IsHitTestVisible="False" />
          <Canvas Name="PART_TrackCanvas" Background="Transparent">
            <controls:MaterialRangeThumb Name="PART_LowerThumb"
                Theme="{StaticResource MaterialSliderThumbTheme}"
                AutomationProperties.Name="{DynamicResource MaterialRangeLowerValueText}" />
            <controls:MaterialRangeThumb Name="PART_UpperThumb"
                Theme="{StaticResource MaterialSliderThumbTheme}"
                AutomationProperties.Name="{DynamicResource MaterialRangeUpperValueText}" />
          </Canvas>
          <Popup Name="PART_ValueLabel" Theme="{StaticResource MaterialSliderValueIndicatorTheme}">
            <Border MinWidth="48" Height="44" CornerRadius="22" Padding="16,0"
                    Background="{DynamicResource MaterialInverseSurfaceBrush}">
              <TextBlock Foreground="{DynamicResource MaterialInverseOnSurfaceBrush}"
                         FontFamily="{DynamicResource MaterialFontFamily}" FontSize="14"
                         LineHeight="20" LetterSpacing="0.5" FontWeight="Normal"
                         HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
          </Popup>
        </Grid>
      </ControlTemplate>
    </Setter>
    <!-- The range slider is horizontal-only in the source; height is the cross axis and the
         thumb target size is applied programmatically so the two endpoints stay in sync. -->
    <Style Selector="^[(theming|MaterialAssist.ControlSize)=Medium]">
      <Setter Property="MinHeight" Value="52" />
    </Style>
    <Style Selector="^[(theming|MaterialAssist.ControlSize)=Large]">
      <Setter Property="MinHeight" Value="68" />
    </Style>
    <Style Selector="^[(theming|MaterialAssist.ControlSize)=ExtraLarge]">
      <Setter Property="MinHeight" Value="108" />
    </Style>
  </ControlTheme>
</ResourceDictionary>
