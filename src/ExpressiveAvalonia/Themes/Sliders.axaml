<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:theming="using:ExpressiveAvalonia.Theming"
                    xmlns:controls="clr-namespace:ExpressiveAvalonia.Controls">
  <!-- Source family (pinned 77b2199 Slider.kt, SliderDefaults, SliderTokens): standard,
       centred and range sliders, horizontal and vertical, enabled/pressed/focused/disabled,
       stops and ticks, five sizes (an ExpressiveAvalonia extension around the source XSmall
       metrics), the value indicator (extension) and the leading icon slot (extension).
       The native Track keeps pointer capture, dragging, keyboard (arrows/Page/Home/End),
       snapping and automation; MaterialSliderTrack only paints the source anatomy.
       Source metrics (track thickness / handle length / outer corner radius):
       XSmall 16/44/8, Small 24/44/8, Medium 40/52/12, Large 56/68/16, XLarge 96/108/28.
       Only XSmall is a direct source token mapping (SliderTokens TrackHeight/HandleHeight);
       the larger sizes are ExpressiveAvalonia extensions, like the non-source value indicator.
       The thumb is a transparent 48-DIP touch target; the 4-DIP handle is painted above it.
       The source lays the track inside a 4-DIP thumb gutter, so the handle centre travels
       from 2 DIP to length-2 DIP and the corner-inset stop/tick grid starts at 2 + radius.
       The Track is inflated by 22 DIP so its 48-DIP thumb reaches those exact endpoints.
       Tick roles are the source's inverted defaults: Primary outside the active track and
       SecondaryContainer inside it; stop indicators use the active track colour (Primary).
       Vertical source default is topToBottom (minimum at the top), mapped to the native
       IsDirectionReversed=True default below; set it False for bottom-to-top. Horizontal
       RTL mirrors the whole root so the native Track and painted track stay aligned; the
       native Left/Right keys are not direction-aware in Avalonia (documented adapter). -->
  <ControlTheme x:Key="MaterialSliderTrackButtonTheme" TargetType="RepeatButton">
    <Setter Property="Focusable" Value="False" />
    <Setter Property="Template">
      <ControlTemplate><Border Background="Transparent" /></ControlTemplate>
    </Setter>
  </ControlTheme>

  <ControlTheme x:Key="MaterialSliderThumbTheme" TargetType="Thumb">
    <Setter Property="Width" Value="48" />
    <Setter Property="Height" Value="48" />
    <Setter Property="Template">
      <ControlTemplate><Border Background="Transparent" /></ControlTemplate>
    </Setter>
  </ControlTheme>

  <ControlTheme x:Key="{x:Type Slider}" TargetType="Slider">
    <Setter Property="MinWidth" Value="120" />
    <Setter Property="MinHeight" Value="44" />
    <Setter Property="Focusable" Value="True" />
    <!-- The source's default Size is XSmall; callers can opt into the larger sizes. -->
    <Setter Property="theming:MaterialAssist.ControlSize" Value="ExtraSmall" />
    <Setter Property="Template">
      <ControlTemplate>
        <Grid Name="SliderRoot" Background="Transparent">
          <theming:MaterialSliderTrack Name="PART_TrackVisual"
              Owner="{Binding RelativeSource={RelativeSource TemplatedParent}}"
              Thumb="{Binding #PART_Handle}"
              IsDragging="{Binding #PART_Handle.IsDragging}"
              ActiveBrush="{DynamicResource MaterialPrimaryBrush}"
              InactiveBrush="{DynamicResource MaterialSecondaryContainerBrush}"
              DisabledBrush="{DynamicResource MaterialOnSurfaceBrush}"
              DisabledHandleBrush="{DynamicResource MaterialSliderDisabledHandleBrush}"
              TickBrush="{DynamicResource MaterialPrimaryBrush}"
              ActiveTickBrush="{DynamicResource MaterialSecondaryContainerBrush}"
              FocusBrush="{DynamicResource MaterialSecondaryBrush}"
              ValueLabel="{Binding #PART_ValueLabel}"
              IconBrush="{DynamicResource MaterialOnPrimaryBrush}"
              IsHitTestVisible="False" />
          <theming:MaterialSliderNativeTrack Name="PART_Track" Margin="-22,0" Orientation="Horizontal"
                 Minimum="{TemplateBinding Minimum}" Maximum="{TemplateBinding Maximum}"
                 Value="{TemplateBinding Value, Mode=TwoWay}"
                 IsDirectionReversed="{TemplateBinding IsDirectionReversed}">
            <theming:MaterialSliderNativeTrack.DecreaseButton>
              <RepeatButton Name="PART_DecreaseButton" Theme="{StaticResource MaterialSliderTrackButtonTheme}" />
            </theming:MaterialSliderNativeTrack.DecreaseButton>
            <theming:MaterialSliderNativeTrack.IncreaseButton>
              <RepeatButton Name="PART_IncreaseButton" Theme="{StaticResource MaterialSliderTrackButtonTheme}" />
            </theming:MaterialSliderNativeTrack.IncreaseButton>
            <theming:MaterialSliderThumb Name="PART_Handle" Theme="{StaticResource MaterialSliderThumbTheme}" />
          </theming:MaterialSliderNativeTrack>
          <!-- Extension label host: the shared MaterialLabel plain-tooltip bubble, anchored on
               the painted handle. MaterialSliderTrack moves the zero-size host with the thumb. -->
          <Canvas IsHitTestVisible="False">
            <controls:MaterialLabel Name="PART_ValueLabel" />
          </Canvas>
        </Grid>
      </ControlTemplate>
    </Setter>
    <Style Selector="^:vertical">
      <Setter Property="MinWidth" Value="44" />
      <Setter Property="MinHeight" Value="120" />
      <!-- Source VerticalSlider default is topToBottom=True (minimum at the top). Avalonia's
           native Track uses minimum-at-the-bottom for IsDirectionReversed=False; the style
           default flips it to the source direction. A local/bound IsDirectionReversed wins. -->
      <Setter Property="IsDirectionReversed" Value="True" />
      <Setter Property="Template">
        <ControlTemplate>
          <Grid Name="SliderRoot" Background="Transparent">
            <theming:MaterialSliderTrack Name="PART_TrackVisual"
                Owner="{Binding RelativeSource={RelativeSource TemplatedParent}}"
                Thumb="{Binding #PART_Handle}"
                IsDragging="{Binding #PART_Handle.IsDragging}"
                ActiveBrush="{DynamicResource MaterialPrimaryBrush}"
                InactiveBrush="{DynamicResource MaterialSecondaryContainerBrush}"
                DisabledBrush="{DynamicResource MaterialOnSurfaceBrush}"
                DisabledHandleBrush="{DynamicResource MaterialSliderDisabledHandleBrush}"
                TickBrush="{DynamicResource MaterialPrimaryBrush}"
                ActiveTickBrush="{DynamicResource MaterialSecondaryContainerBrush}"
                FocusBrush="{DynamicResource MaterialSecondaryBrush}"
                ValueLabel="{Binding #PART_ValueLabel}"
                IconBrush="{DynamicResource MaterialOnPrimaryBrush}"
                IsHitTestVisible="False" />
            <theming:MaterialSliderNativeTrack Name="PART_Track" Margin="0,-22" Orientation="Vertical"
                   Minimum="{TemplateBinding Minimum}" Maximum="{TemplateBinding Maximum}"
                   Value="{TemplateBinding Value, Mode=TwoWay}"
                   IsDirectionReversed="{TemplateBinding IsDirectionReversed}">
              <theming:MaterialSliderNativeTrack.DecreaseButton>
                <RepeatButton Name="PART_DecreaseButton" Theme="{StaticResource MaterialSliderTrackButtonTheme}" />
              </theming:MaterialSliderNativeTrack.DecreaseButton>
              <theming:MaterialSliderNativeTrack.IncreaseButton>
                <RepeatButton Name="PART_IncreaseButton" Theme="{StaticResource MaterialSliderTrackButtonTheme}" />
              </theming:MaterialSliderNativeTrack.IncreaseButton>
              <theming:MaterialSliderThumb Name="PART_Handle" Theme="{StaticResource MaterialSliderThumbTheme}" />
            </theming:MaterialSliderNativeTrack>
            <Canvas IsHitTestVisible="False">
              <controls:MaterialLabel Name="PART_ValueLabel" />
            </Canvas>
          </Grid>
        </ControlTemplate>
      </Setter>
      <Style Selector="^[(theming|MaterialAssist.ControlSize)=Medium]">
        <Setter Property="MinWidth" Value="52" />
      </Style>
      <Style Selector="^[(theming|MaterialAssist.ControlSize)=Large]">
        <Setter Property="MinWidth" Value="68" />
      </Style>
      <Style Selector="^[(theming|MaterialAssist.ControlSize)=ExtraLarge]">
        <Setter Property="MinWidth" Value="108" />
      </Style>
    </Style>
    <!-- Size changes the cross axis only; the length axis keeps its 120-DIP minimum.
         Nested selectors keep the orientation and size conditions in one style tree. -->
    <Style Selector="^:horizontal">
      <Setter Property="MinWidth" Value="120" />
      <!-- Native Track is not RTL-aware; mirroring the whole template keeps the pointer target
           under the painted handle and gives the source start-at-right fill direction. -->
      <Style Selector="^[FlowDirection=RightToLeft] /template/ Grid#SliderRoot">
        <Setter Property="RenderTransform" Value="scale(-1,1)" />
        <Setter Property="RenderTransformOrigin" Value="50%,50%" />
      </Style>
      <!-- The root mirror also mirrors the value bubble; counter-mirror the label text so the
           number stays readable while the zero-size host keeps tracking the thumb. -->
      <Style Selector="^[FlowDirection=RightToLeft] /template/ controls|MaterialLabel#PART_ValueLabel">
        <Setter Property="RenderTransform" Value="scale(-1,1)" />
        <Setter Property="RenderTransformOrigin" Value="50%,50%" />
      </Style>
      <Style Selector="^[(theming|MaterialAssist.ControlSize)=Medium]">
        <Setter Property="MinHeight" Value="52" />
      </Style>
      <Style Selector="^[(theming|MaterialAssist.ControlSize)=Large]">
        <Setter Property="MinHeight" Value="68" />
      </Style>
      <Style Selector="^[(theming|MaterialAssist.ControlSize)=ExtraLarge]">
        <Setter Property="MinHeight" Value="108" />
      </Style>
    </Style>
  </ControlTheme>

  <ControlTheme x:Key="{x:Type controls:MaterialRangeSlider}" TargetType="controls:MaterialRangeSlider">
    <Setter Property="MinWidth" Value="144" />
    <Setter Property="MinHeight" Value="44" />
    <Setter Property="theming:MaterialAssist.ControlSize" Value="ExtraSmall" />
    <Setter Property="Template">
      <ControlTemplate>
        <Grid Name="RangeRoot" Background="Transparent">
          <theming:MaterialSliderTrack Name="PART_TrackVisual"
              Owner="{Binding RelativeSource={RelativeSource TemplatedParent}}"
              ActiveBrush="{DynamicResource MaterialPrimaryBrush}"
              InactiveBrush="{DynamicResource MaterialSecondaryContainerBrush}"
              DisabledBrush="{DynamicResource MaterialOnSurfaceBrush}"
              DisabledHandleBrush="{DynamicResource MaterialSliderDisabledHandleBrush}"
              TickBrush="{DynamicResource MaterialPrimaryBrush}"
              ActiveTickBrush="{DynamicResource MaterialSecondaryContainerBrush}"
              FocusBrush="{DynamicResource MaterialSecondaryBrush}"
              ValueLabel="{Binding #PART_ValueLabel}"
              IconBrush="{DynamicResource MaterialOnPrimaryBrush}"
              IsHitTestVisible="False" />
          <Canvas Name="PART_TrackCanvas" Background="Transparent">
            <controls:MaterialRangeThumb Name="PART_LowerThumb"
                Theme="{StaticResource MaterialSliderThumbTheme}"
                AutomationProperties.Name="{DynamicResource MaterialRangeLowerValueText}" />
            <controls:MaterialRangeThumb Name="PART_UpperThumb"
                Theme="{StaticResource MaterialSliderThumbTheme}"
                AutomationProperties.Name="{DynamicResource MaterialRangeUpperValueText}" />
          </Canvas>
          <Canvas IsHitTestVisible="False">
            <controls:MaterialLabel Name="PART_ValueLabel" />
          </Canvas>
        </Grid>
      </ControlTemplate>
    </Setter>
    <!-- The range slider is horizontal-only in the source; height is the cross axis and the
         thumb target size is applied programmatically so the two endpoints stay in sync. -->
    <Style Selector="^[(theming|MaterialAssist.ControlSize)=Medium]">
      <Setter Property="MinHeight" Value="52" />
    </Style>
    <Style Selector="^[(theming|MaterialAssist.ControlSize)=Large]">
      <Setter Property="MinHeight" Value="68" />
    </Style>
    <Style Selector="^[(theming|MaterialAssist.ControlSize)=ExtraLarge]">
      <Setter Property="MinHeight" Value="108" />
    </Style>
  </ControlTheme>
</ResourceDictionary>
