<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:md="using:ExpressiveAvalonia.Theming">
  <!-- Material 3 tab family. Geometry and color roles follow the assigned source packages:
       Tabs (local-005103, 10 variants), Primary tabs/Icon and label (local-004416, 8),
       Primary tabs/Icon only (local-004425, 8), Primary tabs/Label only (local-004434, 8),
       Secondary tabs/Icon and label (local-004547, 8) and Secondary tabs/Label only
       (local-004556, 8).

       Source anatomy: 48px header for label-only and icon-only, 64px for primary
       icon-and-label, 16px horizontal padding, 24px icon, 2px icon/label gap, 8px
       icon/label gap in the horizontal secondary header, title-small 14/20 medium label,
       primary indicator at least 24x3 centered at the bottom, secondary indicator full width x 2,
       one-pixel outline-variant divider under the strip, 6px error dot badge, and a
       3px secondary focus ring with a 12px radius. Scrollable headers use 90px tabs and
       clip/scroll instead of sharing the width.

       Feedback and content tint follow Tab.kt: the selectable indication is a bounded ripple
       whose color is always the tab's *selected* content role, even while the tab is unselected
       (the source comment explains that the ripple must show the colour before selection). The
       shared MaterialRipple owns the press fade/radius/fade-out, the 10% pressed alpha from
       StateTokens (not an 8% design-snapshot overlay), and the short linear hover/focus tweens.
       The header content is tinted only by the selected/unselected content-colour transition,
       owned by MaterialTabs; hover and press deliberately do not add a third foreground. -->
  <ControlTheme x:Key="DesignTabItem" TargetType="TabItem">
    <Setter Property="MinHeight" Value="48" />
    <Setter Property="MinWidth" Value="48" />
    <Setter Property="Padding" Value="16,0" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{DynamicResource MaterialOnSurfaceVariantBrush}" />
    <Setter Property="FontSize" Value="{DynamicResource MaterialTitleSmallFontSize}" />
    <Setter Property="FontWeight" Value="{DynamicResource MaterialTitleSmallFontWeight}" />
    <Setter Property="TextElement.LetterSpacing" Value="{DynamicResource MaterialTitleSmallLetterSpacing}" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="Template">
      <ControlTemplate>
        <Grid Background="{TemplateBinding Background}">
          <Grid Name="HeaderArea" Margin="{TemplateBinding Padding}">
            <StackPanel Name="HeaderContent" Orientation="Horizontal" Spacing="8"
                        HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                        VerticalAlignment="Stretch">
              <Grid Name="ContentColumn" ColumnDefinitions="Auto" VerticalAlignment="Stretch">
                <StackPanel Grid.Column="0" Name="LabelGroup" Orientation="Horizontal" Spacing="8"
                            HorizontalAlignment="Center"
                            VerticalAlignment="{TemplateBinding VerticalContentAlignment}">
                  <Grid Name="IconHost" Width="24" Height="24" HorizontalAlignment="Center" VerticalAlignment="Center"
                        IsVisible="False">
                    <ContentPresenter Name="IconPresenter" Content="{TemplateBinding Icon}"
                                      ContentTemplate="{TemplateBinding IconTemplate}"
                                      Width="24" Height="24"
                                      HorizontalAlignment="Center" VerticalAlignment="Center" />
                    <!-- The source places the badge over the icon's top-right corner when the
                         header carries an icon; that badge is the small (dot) variant. -->
                    <Border Name="IconBadge" Width="6" Height="6" CornerRadius="3"
                            Background="{DynamicResource MaterialErrorBrush}"
                            HorizontalAlignment="Right" VerticalAlignment="Top"
                            IsVisible="False" IsHitTestVisible="False" />
                  </Grid>
                  <ContentPresenter Name="PART_ContentPresenter" Content="{TemplateBinding Header}"
                                    ContentTemplate="{TemplateBinding HeaderTemplate}"
                                    RecognizesAccessKey="True" TextBlock.LineHeight="20"
                                    IsVisible="False"
                                    HorizontalContentAlignment="Center" VerticalAlignment="Center" />
                </StackPanel>
                <!-- Horizontal primary/secondary indicators are the single shared
                     PART_Indicator in the TabControl template. -->
              </Grid>
              <Border Name="TrailingBadge" Width="6" Height="6" CornerRadius="3"
                      Background="{DynamicResource MaterialErrorBrush}"
                      Margin="-4,0,0,0" VerticalAlignment="Center"
                      IsVisible="False" IsHitTestVisible="False">
                <TextBlock Name="TrailingBadgeText" IsVisible="False"
                           Text="{TemplateBinding (md:MaterialTabs.BadgeText)}"
                           FontSize="{DynamicResource MaterialLabelSmallFontSize}"
                           FontWeight="Medium"
                           LineHeight="{DynamicResource MaterialLabelSmallLineHeight}"
                           Foreground="{DynamicResource MaterialOnErrorBrush}"
                           HorizontalAlignment="Center" VerticalAlignment="Center" />
              </Border>
            </StackPanel>
          </Grid>
          <!-- Source RippleNode (Tab.kt creates ripple(bounded = true, color =
               selectedContentColor)): the state layer and the press ripple are painted above the
               header content. Primary tabs therefore ripple with Primary even while unselected;
               the .md-secondary rule below swaps the selected role to OnSurface. Pressed alpha is
               the StateTokens 10%, while hover/focus use the short linear ripple tweens. The node
               is decorative and never hit-tested; TabItem stays the input owner. -->
          <md:MaterialRipple Name="StateLayer"
                             Fill="{DynamicResource MaterialPrimaryBrush}"
                             PressOpacity="{DynamicResource MaterialPressedStateLayerOpacity}"
                             HoverOpacity="{DynamicResource MaterialHoverStateLayerOpacity}"
                             FocusOpacity="{DynamicResource MaterialFocusStateLayerOpacity}"
                             EnableDrag="False" IsHitTestVisible="False" />
          <!-- Secondary indicator: spans the whole strip width. -->
          <Border Name="IndicatorSecondary" Height="2" CornerRadius="0"
                  Background="{DynamicResource MaterialPrimaryBrush}"
                  HorizontalAlignment="Stretch" VerticalAlignment="Bottom"
                  IsVisible="False" IsHitTestVisible="False" />
          <Border Name="FocusRing" Margin="3,3,3,8" CornerRadius="12" BorderThickness="3"
                  BorderBrush="{DynamicResource MaterialSecondaryBrush}"
                  IsVisible="False" IsHitTestVisible="False" />
        </Grid>
      </ControlTemplate>
    </Setter>

    <!-- Header composition. MaterialTabs publishes the resolved layout as ordinary style
         classes (an external helper cannot add pseudo-classes), so an icon-only tab can keep a
         Header for its accessible name without painting it and a label-only tab never reserves
         icon space. -->
    <Style Selector="^.md-icon-only /template/ Grid#IconHost, ^.md-icon-and-label /template/ Grid#IconHost">
      <Setter Property="IsVisible" Value="True" />
    </Style>
    <Style Selector="^.md-label-only /template/ ContentPresenter#PART_ContentPresenter, ^.md-icon-and-label /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="IsVisible" Value="True" />
    </Style>
    <Style Selector="^.md-scrollable">
      <Setter Property="MinWidth" Value="90" />
    </Style>

    <!-- Primary icon-and-label uses the source Tab's 72 DIP large header with an 8 DIP gap. -->
    <Style Selector="^.md-primary.md-icon-and-label, ^.md-secondary.md-icon-and-label">
      <Setter Property="MinHeight" Value="72" />
    </Style>
    <Style Selector="^.md-icon-and-label /template/ StackPanel#LabelGroup">
      <Setter Property="Orientation" Value="Vertical" />
      <Setter Property="Spacing" Value="8" />
    </Style>

    <!-- Badges: a dot by default, a pill when BadgeText is present. -->
    <Style Selector="^.md-has-badge.md-icon-only /template/ Border#IconBadge">
      <Setter Property="IsVisible" Value="True" />
    </Style>
    <Style Selector="^.md-has-badge.md-icon-and-label /template/ Border#IconBadge">
      <Setter Property="IsVisible" Value="True" />
    </Style>
    <Style Selector="^.md-secondary.md-has-badge.md-icon-and-label /template/ Border#IconBadge">
      <Setter Property="IsVisible" Value="False" />
    </Style>
    <Style Selector="^.md-secondary.md-has-badge.md-icon-and-label /template/ Border#TrailingBadge">
      <Setter Property="IsVisible" Value="True" />
    </Style>
    <Style Selector="^.md-has-badge.md-label-only /template/ Border#TrailingBadge">
      <Setter Property="IsVisible" Value="True" />
    </Style>
    <Style Selector="^.md-badge-text /template/ Border#TrailingBadge">
      <Setter Property="Width" Value="NaN" />
      <Setter Property="MinWidth" Value="16" />
      <Setter Property="Height" Value="16" />
      <Setter Property="Padding" Value="4,0" />
      <Setter Property="CornerRadius" Value="8" />
    </Style>
    <Style Selector="^.md-badge-text /template/ TextBlock#TrailingBadgeText">
      <Setter Property="IsVisible" Value="True" />
    </Style>

    <!-- Horizontal strips use the single PART_Indicator from the TabControl template (3 DIP
         primary content width, 3 DIP secondary full tab width, spring motion). Left/Right strips
         are an Avalonia-only extension with no upstream geometry, so they keep per-tab edge
         markers: a 3x20 primary marker or a 2 DIP secondary edge rule. -->
    <Style Selector="^ /template/ Border#IndicatorSecondary">
      <Setter Property="IsVisible" Value="False" />
    </Style>
    <Style Selector="^[TabStripPlacement=Left] /template/ Border#IndicatorSecondary,
                    ^[TabStripPlacement=Right] /template/ Border#IndicatorSecondary">
      <Setter Property="Background" Value="{DynamicResource MaterialPrimaryBrush}" />
    </Style>
    <!-- Primary: 3x20 edge marker for side strips. -->
    <Style Selector="^.md-primary[TabStripPlacement=Left] /template/ Border#IndicatorSecondary,
                    ^.md-primary[TabStripPlacement=Right] /template/ Border#IndicatorSecondary">
      <Setter Property="Width" Value="3" />
      <Setter Property="Height" Value="20" />
      <Setter Property="CornerRadius" Value="0" />
    </Style>
    <Style Selector="^.md-primary[TabStripPlacement=Left] /template/ Border#IndicatorSecondary">
      <Setter Property="HorizontalAlignment" Value="Right" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="^.md-primary[TabStripPlacement=Right] /template/ Border#IndicatorSecondary">
      <Setter Property="HorizontalAlignment" Value="Left" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="^.md-primary:selected[TabStripPlacement=Left] /template/ Border#IndicatorSecondary,
                    ^.md-primary:selected[TabStripPlacement=Right] /template/ Border#IndicatorSecondary">
      <Setter Property="IsVisible" Value="True" />
    </Style>
    <!-- Secondary: full-height 2 DIP edge rule for side strips. -->
    <Style Selector="^.md-secondary[TabStripPlacement=Left] /template/ Border#IndicatorSecondary,
                    ^.md-secondary[TabStripPlacement=Right] /template/ Border#IndicatorSecondary">
      <Setter Property="Width" Value="2" />
      <Setter Property="Height" Value="NaN" />
      <Setter Property="VerticalAlignment" Value="Stretch" />
      <Setter Property="CornerRadius" Value="0" />
    </Style>
    <Style Selector="^.md-secondary:selected[TabStripPlacement=Left] /template/ Border#IndicatorSecondary,
                    ^.md-secondary:selected[TabStripPlacement=Right] /template/ Border#IndicatorSecondary">
      <Setter Property="IsVisible" Value="True" />
    </Style>

    <!-- Content tint roles. Tab.kt supplies exactly two content colours: the selected role and
         the unselected role. Pointer/keyboard feedback is the ripple's state layer, so hover,
         focus and press do NOT introduce a third foreground; MaterialTabs animates the header
         between these two endpoints (DefaultEffects selecting, FastEffects deselecting). -->
    <Style Selector="^:selected">
      <Setter Property="Foreground" Value="{DynamicResource MaterialPrimaryBrush}" />
    </Style>

    <Style Selector="^.md-secondary">
      <Style Selector="^:selected">
        <Setter Property="Foreground" Value="{DynamicResource MaterialOnSurfaceBrush}" />
      </Style>
      <!-- Secondary tabs use the secondary (on-surface) role for the ripple too; the source
           default for secondary tab rows is onSurface, not primary. -->
      <Style Selector="^ /template/ md|MaterialRipple#StateLayer">
        <Setter Property="Fill" Value="{DynamicResource MaterialOnSurfaceBrush}" />
      </Style>
    </Style>

    <!-- Focus ring: 3px secondary, 12px radius, inset from the header edges. -->
    <Style Selector="^:focus-visible /template/ Border#FocusRing">
      <Setter Property="IsVisible" Value="True" />
    </Style>
    <Style Selector="^[(md|MaterialTabs.ShowFocusIndicator)=False] /template/ Border#FocusRing">
      <Setter Property="IsVisible" Value="False" />
    </Style>

    <Style Selector="^:disabled">
      <Setter Property="Foreground" Value="{DynamicResource MaterialOnSurfaceBrush}" />
    </Style>
    <Style Selector="^:disabled /template/ StackPanel#HeaderContent">
      <Setter Property="Opacity" Value="0.38" />
    </Style>
    <Style Selector="^:disabled /template/ Border#Indicator, ^:disabled /template/ Border#IndicatorSecondary">
      <Setter Property="Background" Value="{DynamicResource MaterialOnSurfaceBrush}" />
      <Setter Property="Opacity" Value="0.38" />
    </Style>
    <Style Selector="^:disabled /template/ md|MaterialRipple#StateLayer">
      <Setter Property="Opacity" Value="0" />
    </Style>
    <Style Selector="^:disabled /template/ Border#FocusRing">
      <Setter Property="IsVisible" Value="False" />
    </Style>
  </ControlTheme>

  <ControlTheme x:Key="DesignTabControl" TargetType="TabControl">
    <Setter Property="Background" Value="{DynamicResource MaterialSurfaceBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource MaterialOnSurfaceBrush}" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    <Setter Property="VerticalContentAlignment" Value="Stretch" />
    <Setter Property="ItemContainerTheme" Value="{StaticResource DesignTabItem}" />
    <Setter Property="ItemsPanel">
      <ItemsPanelTemplate>
        <UniformGrid Rows="1" />
      </ItemsPanelTemplate>
    </Setter>
    <Setter Property="Template">
      <ControlTemplate>
        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{TemplateBinding CornerRadius}">
          <DockPanel>
            <!-- The strip and its divider are one host so the divider always sits on the far
                 side of the headers for every TabStripPlacement. -->
            <DockPanel Name="HeaderHost" DockPanel.Dock="Top" LastChildFill="False">
              <ScrollViewer Name="PART_HeaderScroller" DockPanel.Dock="Top"
                            HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Disabled"
                            BringIntoViewOnFocusChange="True">
                <Panel Name="HeaderPanel">
                  <ItemsPresenter Name="PART_ItemsPresenter" ItemsPanel="{TemplateBinding ItemsPanel}" />
                  <!-- Single animated indicator shared by every header (TabRow's indicator).
                       MaterialTabs positions and springs it; the per-tab side markers remain only
                       for the Avalonia-only Left/Right strip extension. -->
                  <Canvas Name="PART_IndicatorLayer" IsHitTestVisible="False">
                    <Border Name="PART_Indicator" Height="3" CornerRadius="3"
                            Background="{DynamicResource MaterialPrimaryBrush}"
                            IsVisible="False" />
                  </Canvas>
                </Panel>
              </ScrollViewer>
              <!-- The divider is a one-pixel outline-variant rule owned by the strip, exactly as
                   the source Tabs component places it on the far side of the tab group. -->
              <Border Name="HeaderDivider" DockPanel.Dock="Top" Height="1"
                      Background="{DynamicResource MaterialOutlineVariantBrush}" IsHitTestVisible="False" />
            </DockPanel>
            <Panel ClipToBounds="True">
              <ContentPresenter Name="PART_SelectedContentHost" Margin="{TemplateBinding Padding}"
                                HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}" />
            </Panel>
          </DockPanel>
        </Border>
      </ControlTemplate>
    </Setter>

    <!-- Fixed configuration: headers share the strip width equally. -->
    <Style Selector="^[TabStripPlacement=Bottom] /template/ DockPanel#HeaderHost">
      <Setter Property="DockPanel.Dock" Value="Bottom" />
    </Style>
    <Style Selector="^[TabStripPlacement=Bottom] /template/ ScrollViewer#PART_HeaderScroller">
      <Setter Property="DockPanel.Dock" Value="Bottom" />
    </Style>
    <Style Selector="^[TabStripPlacement=Bottom] /template/ Border#HeaderDivider">
      <Setter Property="DockPanel.Dock" Value="Bottom" />
    </Style>
    <Style Selector="^[TabStripPlacement=Left] /template/ DockPanel#HeaderHost">
      <Setter Property="DockPanel.Dock" Value="Left" />
    </Style>
    <Style Selector="^[TabStripPlacement=Left] /template/ ScrollViewer#PART_HeaderScroller">
      <Setter Property="DockPanel.Dock" Value="Left" />
    </Style>
    <Style Selector="^[TabStripPlacement=Left] /template/ Border#HeaderDivider">
      <Setter Property="DockPanel.Dock" Value="Left" />
      <Setter Property="Width" Value="1" />
      <Setter Property="Height" Value="NaN" />
    </Style>
    <Style Selector="^[TabStripPlacement=Right] /template/ DockPanel#HeaderHost">
      <Setter Property="DockPanel.Dock" Value="Right" />
    </Style>
    <Style Selector="^[TabStripPlacement=Right] /template/ ScrollViewer#PART_HeaderScroller">
      <Setter Property="DockPanel.Dock" Value="Right" />
    </Style>
    <Style Selector="^[TabStripPlacement=Right] /template/ Border#HeaderDivider">
      <Setter Property="DockPanel.Dock" Value="Right" />
      <Setter Property="Width" Value="1" />
      <Setter Property="Height" Value="NaN" />
    </Style>
    <Style Selector="^[TabStripPlacement=Left], ^[TabStripPlacement=Right]">
      <Setter Property="ItemsPanel">
        <ItemsPanelTemplate>
          <UniformGrid Columns="1" />
        </ItemsPanelTemplate>
      </Setter>
    </Style>

    <!-- Scrollable configuration: 90 DIP headers that scroll instead of sharing the width, with the
         source's 52 DIP edge padding so the first and last header can centre. -->
    <Style Selector="^[(md|MaterialTabs.IsScrollable)=True]">
      <Setter Property="ItemsPanel">
        <ItemsPanelTemplate>
          <StackPanel Orientation="Horizontal" />
        </ItemsPanelTemplate>
      </Setter>
      <Style Selector="^ /template/ ItemsPresenter#PART_ItemsPresenter">
        <Setter Property="Margin" Value="52,0" />
      </Style>
      <Style Selector="^ /template/ ScrollViewer#PART_HeaderScroller">
        <Setter Property="HorizontalScrollBarVisibility" Value="Hidden" />
        <Setter Property="VerticalScrollBarVisibility" Value="Disabled" />
      </Style>
      <Style Selector="^[TabStripPlacement=Left], ^[TabStripPlacement=Right]">
        <Setter Property="ItemsPanel">
          <ItemsPanelTemplate>
            <StackPanel Orientation="Vertical" />
          </ItemsPanelTemplate>
        </Setter>
      </Style>
      <Style Selector="^[TabStripPlacement=Left] /template/ ScrollViewer#PART_HeaderScroller, ^[TabStripPlacement=Right] /template/ ScrollViewer#PART_HeaderScroller">
        <Setter Property="HorizontalScrollBarVisibility" Value="Disabled" />
        <Setter Property="VerticalScrollBarVisibility" Value="Hidden" />
      </Style>
    </Style>
  </ControlTheme>

  <!-- Implicit keys make these the default tab themes for the whole theme; the keyed themes
       above remain available for explicit opt-in on a single strip. Collections.axaml no longer
       defines tab themes, so no other dictionary competes for these keys. -->
  <ControlTheme x:Key="{x:Type TabItem}" TargetType="TabItem"
                BasedOn="{StaticResource DesignTabItem}" />
  <ControlTheme x:Key="{x:Type TabControl}" TargetType="TabControl"
                BasedOn="{StaticResource DesignTabControl}" />
</ResourceDictionary>
