<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:controls="using:ExpressiveAvalonia.Controls"
                    xmlns:md="using:ExpressiveAvalonia.Theming">
  <!-- Rich tooltip presenter (RichTooltipTokens + Tooltip.kt RichTooltipContent): a
       surface-container card, CornerMedium (12), level 2 elevation, min 40 x 24 and max width 320.
       The internal paddings are set by RichTooltip from the source baseline rules (16 horizontal,
       12 above the subhead, 4 between subhead and body, 16 below the body, 8 below the 36 DIP
       action row), so they are not duplicated here. RichTooltip assigns this theme to
       FlyoutPresenterTheme when the application has not chosen one.
       Avalonia forbids child/descendant selectors directly inside a ControlTheme, so the
       action-button and text-wrapping rules live in RichTooltip's programmatic presenter.

       Tooltip.kt RichTooltip caretShape defaults to null, so SurfaceMargin is zero until
       RichTooltip.ShowCaret is set. The presenter then reserves 8 DIP on one edge and
       TooltipCaretRenderer draws the 16 x 8 triangle from the real popup/anchor screen bounds. -->
  <ControlTheme x:Key="MaterialRichTooltipPresenter" TargetType="controls:MaterialRichTooltipPresenter">
    <Setter Property="Background" Value="{DynamicResource MaterialSurfaceContainerBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource MaterialOnSurfaceVariantBrush}" />
    <Setter Property="BorderBrush" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="CornerRadius" Value="12" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="MinWidth" Value="40" />
    <Setter Property="MinHeight" Value="24" />
    <Setter Property="MaxWidth" Value="320" />
    <Setter Property="FontFamily" Value="{DynamicResource MaterialFontFamily}" />
    <Setter Property="FontSize" Value="{DynamicResource MaterialBodyMediumFontSize}" />
    <Setter Property="FontWeight" Value="{DynamicResource MaterialBodyMediumFontWeight}" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    <Setter Property="VerticalContentAlignment" Value="Top" />
    <Setter Property="Template">
      <ControlTemplate>
        <Panel>
          <Border Name="PART_Surface" Margin="{TemplateBinding SurfaceMargin}"
                  Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                  BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{TemplateBinding CornerRadius}"
                  BoxShadow="{DynamicResource MaterialElevationLevel2Shadow}">
            <ContentPresenter Name="PART_ContentPresenter" Padding="{TemplateBinding Padding}"
                              Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}"
                              HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                              VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}" />
          </Border>
          <md:TooltipCaretRenderer Name="PART_Caret" Fill="{TemplateBinding Background}"
                                   IsHitTestVisible="False" />
        </Panel>
      </ControlTemplate>
    </Setter>
  </ControlTheme>
</ResourceDictionary>
