<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:controls="using:ExpressiveAvalonia.Controls">
  <!-- Material 3 FAB family. Geometry and color roles follow the assigned source packages:
       FAB (local-001450, 72 variants), Extended FAB (local-001377, 72 variants),
       FAB menu (local-001523, 3 variants) and its Primary/Secondary/Tertiary building
       blocks (local-000227..local-000256, 24 variants).
       Elevation: resting FAB = level 3, hovered = level 4, pressed/focused = level 3
       (the source uses exactly the two-layer md.sys.elevation 3 and 4 shadows).
       State layers: hover 8%, focus 10%, pressed 8% of the role's content color.
       Focus ring: surface radius + 2 on every corner, 3 unit stroke in the secondary role. -->
  <x:String x:Key="MaterialFabMenuOpenText">Open actions menu</x:String>
  <x:String x:Key="MaterialFabMenuCloseText">Close actions menu</x:String>

  <ControlTheme x:Key="MaterialFabBaseTheme" TargetType="controls:MaterialFabBase">
    <Setter Property="Background" Value="{DynamicResource MaterialPrimaryContainerBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource MaterialOnPrimaryContainerBrush}" />
    <Setter Property="FontFamily" Value="{DynamicResource MaterialFontFamily}" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />

    <Style Selector="^[ColorRole=PrimaryContainer]">
      <Setter Property="Background" Value="{DynamicResource MaterialPrimaryContainerBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource MaterialOnPrimaryContainerBrush}" />
    </Style>
    <Style Selector="^[ColorRole=SecondaryContainer]">
      <Setter Property="Background" Value="{DynamicResource MaterialSecondaryContainerBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource MaterialOnSecondaryContainerBrush}" />
    </Style>
    <Style Selector="^[ColorRole=TertiaryContainer]">
      <Setter Property="Background" Value="{DynamicResource MaterialTertiaryContainerBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource MaterialOnTertiaryContainerBrush}" />
    </Style>
    <Style Selector="^[ColorRole=Primary]">
      <Setter Property="Background" Value="{DynamicResource MaterialPrimaryBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource MaterialOnPrimaryBrush}" />
    </Style>
    <Style Selector="^[ColorRole=Secondary]">
      <Setter Property="Background" Value="{DynamicResource MaterialSecondaryBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource MaterialOnSecondaryBrush}" />
    </Style>
    <Style Selector="^[ColorRole=Tertiary]">
      <Setter Property="Background" Value="{DynamicResource MaterialTertiaryBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource MaterialOnTertiaryBrush}" />
    </Style>

    <Style Selector="^ /template/ Border#Surface">
      <Setter Property="Transitions">
        <Transitions>
          <BoxShadowsTransition Property="BoxShadow" Duration="{DynamicResource MaterialDurationShort4}" Easing="0.2,0,0,1" />
          <BrushTransition Property="Background" Duration="{DynamicResource MaterialDurationShort4}" Easing="0.2,0,0,1" />
        </Transitions>
      </Setter>
    </Style>
    <Style Selector="^ /template/ Border#StateLayer">
      <Setter Property="Transitions">
        <Transitions>
          <DoubleTransition Property="Opacity" Duration="{DynamicResource MaterialDurationShort4}" Easing="0.2,0,0,1" />
        </Transitions>
      </Setter>
    </Style>

    <Style Selector="^:pointerover:not(:disabled) /template/ Border#StateLayer">
      <Setter Property="Opacity" Value="{DynamicResource MaterialHoverStateLayerOpacity}" />
    </Style>
    <Style Selector="^:focus-visible /template/ Border#StateLayer">
      <Setter Property="Opacity" Value="{DynamicResource MaterialFocusStateLayerOpacity}" />
    </Style>
    <!-- The source pressed snapshots use an 8% content layer, not the 10% generic token. -->
    <Style Selector="^:pressed:not(:disabled) /template/ Border#StateLayer">
      <Setter Property="Opacity" Value="0.08" />
    </Style>
    <Style Selector="^:focus-visible /template/ Border#FocusRing">
      <Setter Property="IsVisible" Value="True" />
    </Style>

    <!-- Disabled roles are composited (OnSurface container at 12%, content at 38%) instead of
         dimming the complete control, which would stack two translucent layers. -->
    <Style Selector="^:disabled">
      <Setter Property="Background" Value="{DynamicResource MaterialOnSurfaceBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource MaterialOnSurfaceBrush}" />
    </Style>
    <Style Selector="^:disabled /template/ Border#Surface">
      <Setter Property="Opacity" Value="0.12" />
      <Setter Property="BoxShadow" Value="{DynamicResource MaterialElevationLevel0Shadow}" />
    </Style>
    <Style Selector="^:disabled /template/ Border#ContentHost">
      <Setter Property="Opacity" Value="0.38" />
    </Style>
    <Style Selector="^:disabled /template/ Border#StateLayer">
      <Setter Property="Opacity" Value="0" />
    </Style>
    <Style Selector="^:disabled /template/ Border#FocusRing">
      <Setter Property="IsVisible" Value="False" />
    </Style>
  </ControlTheme>

  <ControlTheme x:Key="{x:Type controls:MaterialFab}" TargetType="controls:MaterialFab"
                BasedOn="{StaticResource MaterialFabBaseTheme}">
    <Setter Property="Template">
      <ControlTemplate>
        <Panel Background="Transparent">
          <Border Name="Surface" Background="{TemplateBinding Background}"
                  CornerRadius="{TemplateBinding CornerRadius}" IsHitTestVisible="False" />
          <Border Name="StateLayer" Background="{TemplateBinding Foreground}"
                  CornerRadius="{TemplateBinding CornerRadius}" Opacity="0" IsHitTestVisible="False" />
          <Border Name="ContentHost" Background="Transparent" Padding="{TemplateBinding Padding}">
            <ContentPresenter Name="PART_ContentPresenter"
                              Content="{TemplateBinding Content}"
                              ContentTemplate="{TemplateBinding ContentTemplate}"
                              HorizontalContentAlignment="Center"
                              VerticalContentAlignment="Center" />
          </Border>
          <Canvas Name="PART_RippleHost" IsHitTestVisible="False" />
          <Border Name="FocusRing" Margin="-2"
                  CornerRadius="{TemplateBinding FocusRingCornerRadius}"
                  BorderBrush="{DynamicResource MaterialSecondaryBrush}"
                  BorderThickness="3" IsVisible="False" IsHitTestVisible="False" />
        </Panel>
      </ControlTemplate>
    </Setter>

    <Style Selector="^[Size=Default]">
      <Setter Property="Width" Value="56" />
      <Setter Property="Height" Value="56" />
      <Setter Property="CornerRadius" Value="16" />
      <Setter Property="Padding" Value="16" />
    </Style>
    <Style Selector="^[Size=Medium]">
      <Setter Property="Width" Value="80" />
      <Setter Property="Height" Value="80" />
      <Setter Property="CornerRadius" Value="20" />
      <Setter Property="Padding" Value="26" />
    </Style>
    <Style Selector="^[Size=Large]">
      <Setter Property="Width" Value="96" />
      <Setter Property="Height" Value="96" />
      <Setter Property="CornerRadius" Value="28" />
      <Setter Property="Padding" Value="30" />
    </Style>

    <!-- Icon boxes follow the source anatomy: a 24/28/36 instance box holding a 20/23/30 glyph. -->
    <Style Selector="^ /template/ ContentPresenter#PART_ContentPresenter PathIcon">
      <Setter Property="Width" Value="20" />
      <Setter Property="Height" Value="20" />
      <Setter Property="Margin" Value="2" />
    </Style>
    <Style Selector="^[Size=Medium] /template/ ContentPresenter#PART_ContentPresenter PathIcon">
      <Setter Property="Width" Value="23" />
      <Setter Property="Height" Value="23" />
      <Setter Property="Margin" Value="2.5" />
    </Style>
    <Style Selector="^[Size=Large] /template/ ContentPresenter#PART_ContentPresenter PathIcon">
      <Setter Property="Width" Value="30" />
      <Setter Property="Height" Value="30" />
      <Setter Property="Margin" Value="3" />
    </Style>

    <Style Selector="^ /template/ Border#Surface">
      <Setter Property="BoxShadow" Value="{DynamicResource MaterialElevationLevel3Shadow}" />
    </Style>
    <Style Selector="^:pointerover:not(:pressed):not(:disabled) /template/ Border#Surface">
      <Setter Property="BoxShadow" Value="{DynamicResource MaterialElevationLevel4Shadow}" />
    </Style>
  </ControlTheme>

  <ControlTheme x:Key="{x:Type controls:MaterialExtendedFab}" TargetType="controls:MaterialExtendedFab"
                BasedOn="{StaticResource MaterialFabBaseTheme}">
    <Setter Property="Template">
      <ControlTemplate>
        <Panel Background="Transparent">
          <Border Name="Surface" Background="{TemplateBinding Background}"
                  CornerRadius="{TemplateBinding CornerRadius}" IsHitTestVisible="False" />
          <Border Name="StateLayer" Background="{TemplateBinding Foreground}"
                  CornerRadius="{TemplateBinding CornerRadius}" Opacity="0" IsHitTestVisible="False" />
          <Border Name="ContentHost" Background="Transparent" Padding="{TemplateBinding Padding}">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
              <PathIcon Name="PART_Icon" Data="{TemplateBinding Icon}" VerticalAlignment="Center" />
              <Border Name="PART_LabelHost" Width="0" ClipToBounds="True" VerticalAlignment="Center">
                <TextBlock Name="PART_Label" Text="{TemplateBinding Label}"
                           Foreground="{TemplateBinding Foreground}"
                           Margin="8,0,0,0"
                           FontSize="16" FontWeight="Medium" LetterSpacing="0.15" LineHeight="24"
                           VerticalAlignment="Center" TextWrapping="NoWrap" />
              </Border>
            </StackPanel>
          </Border>
          <Canvas Name="PART_RippleHost" IsHitTestVisible="False" />
          <Border Name="FocusRing" Margin="-2"
                  CornerRadius="{TemplateBinding FocusRingCornerRadius}"
                  BorderBrush="{DynamicResource MaterialSecondaryBrush}"
                  BorderThickness="3" IsVisible="False" IsHitTestVisible="False" />
        </Panel>
      </ControlTemplate>
    </Setter>

    <Style Selector="^ /template/ Border#PART_LabelHost">
      <Setter Property="Transitions">
        <Transitions>
          <DoubleTransition Property="Width" Duration="{DynamicResource MaterialDurationShort4}" Easing="0.2,0,0,1" />
        </Transitions>
      </Setter>
    </Style>

    <Style Selector="^[Size=Small]">
      <Setter Property="MinHeight" Value="56" />
      <Setter Property="CornerRadius" Value="16" />
      <Setter Property="Padding" Value="16" />
    </Style>
    <Style Selector="^[Size=Small] /template/ PathIcon#PART_Icon">
      <Setter Property="Width" Value="20" />
      <Setter Property="Height" Value="20" />
      <Setter Property="Margin" Value="2" />
    </Style>
    <Style Selector="^[Size=Medium]">
      <Setter Property="MinHeight" Value="80" />
      <Setter Property="CornerRadius" Value="20" />
      <Setter Property="Padding" Value="26" />
    </Style>
    <Style Selector="^[Size=Medium] /template/ PathIcon#PART_Icon">
      <Setter Property="Width" Value="23" />
      <Setter Property="Height" Value="23" />
      <Setter Property="Margin" Value="2.5" />
    </Style>
    <Style Selector="^[Size=Medium] /template/ TextBlock#PART_Label">
      <Setter Property="FontSize" Value="22" />
      <Setter Property="FontWeight" Value="Normal" />
      <Setter Property="LetterSpacing" Value="0" />
      <Setter Property="LineHeight" Value="28" />
      <Setter Property="Margin" Value="12,0,0,0" />
    </Style>
    <Style Selector="^[Size=Large]">
      <Setter Property="MinHeight" Value="96" />
      <Setter Property="CornerRadius" Value="28" />
      <Setter Property="Padding" Value="28,30" />
    </Style>
    <Style Selector="^[Size=Large] /template/ PathIcon#PART_Icon">
      <Setter Property="Width" Value="30" />
      <Setter Property="Height" Value="30" />
      <Setter Property="Margin" Value="3" />
    </Style>
    <Style Selector="^[Size=Large] /template/ TextBlock#PART_Label">
      <Setter Property="FontSize" Value="24" />
      <Setter Property="FontWeight" Value="Normal" />
      <Setter Property="LetterSpacing" Value="0" />
      <Setter Property="LineHeight" Value="32" />
      <Setter Property="Margin" Value="16,0,0,0" />
    </Style>

    <!-- Collapsed: the icon-only square uses the vertical padding on all sides (56/80/96). -->
    <Style Selector="^[IsExpanded=False][Size=Small]">
      <Setter Property="Padding" Value="16" />
    </Style>
    <Style Selector="^[IsExpanded=False][Size=Medium]">
      <Setter Property="Padding" Value="26" />
    </Style>
    <Style Selector="^[IsExpanded=False][Size=Large]">
      <Setter Property="Padding" Value="30" />
    </Style>

    <Style Selector="^ /template/ Border#Surface">
      <Setter Property="BoxShadow" Value="{DynamicResource MaterialElevationLevel3Shadow}" />
    </Style>
    <Style Selector="^:pointerover:not(:pressed):not(:disabled) /template/ Border#Surface">
      <Setter Property="BoxShadow" Value="{DynamicResource MaterialElevationLevel4Shadow}" />
    </Style>
  </ControlTheme>

  <ControlTheme x:Key="{x:Type controls:MaterialFabMenuSegment}" TargetType="controls:MaterialFabMenuSegment"
                BasedOn="{StaticResource MaterialFabBaseTheme}">
    <Setter Property="MinHeight" Value="56" />
    <Setter Property="CornerRadius" Value="28" />
    <Setter Property="Padding" Value="24,16" />
    <Setter Property="FontSize" Value="16" />
    <Setter Property="FontWeight" Value="Medium" />
    <!-- Menu actions fade and slide in when the menu expands. The duration is zeroed by
         MaterialTheme under reduced motion, so the same class toggle becomes instant. -->
    <Setter Property="Transitions">
      <Transitions>
        <DoubleTransition Property="Opacity" Duration="{DynamicResource MaterialDurationShort4}" Easing="0.2,0,0,1" />
        <TransformOperationsTransition Property="RenderTransform" Duration="{DynamicResource MaterialDurationShort4}" Easing="0.2,0,0,1" />
      </Transitions>
    </Setter>
    <Setter Property="Template">
      <ControlTemplate>
        <Panel Background="Transparent">
          <Border Name="Surface" Background="{TemplateBinding Background}"
                  CornerRadius="{TemplateBinding CornerRadius}" IsHitTestVisible="False" />
          <Border Name="StateLayer" Background="{TemplateBinding Foreground}"
                  CornerRadius="{TemplateBinding CornerRadius}" Opacity="0" IsHitTestVisible="False" />
          <Border Name="ContentHost" Background="Transparent" Padding="{TemplateBinding Padding}">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
              <PathIcon Name="PART_Icon" Data="{TemplateBinding Icon}" Width="20" Height="20"
                        Margin="2" VerticalAlignment="Center" />
              <TextBlock Text="{TemplateBinding Label}"
                         Foreground="{TemplateBinding Foreground}"
                         Margin="8,0,0,0"
                         FontSize="16" FontWeight="Medium" LetterSpacing="0.15" LineHeight="24"
                         VerticalAlignment="Center" TextWrapping="NoWrap" />
            </StackPanel>
          </Border>
          <Canvas Name="PART_RippleHost" IsHitTestVisible="False" />
          <Border Name="FocusRing" Margin="-2"
                  CornerRadius="{TemplateBinding FocusRingCornerRadius}"
                  BorderBrush="{DynamicResource MaterialSecondaryBrush}"
                  BorderThickness="3" IsVisible="False" IsHitTestVisible="False" />
        </Panel>
      </ControlTemplate>
    </Setter>

    <Style Selector="^.material-fab-menu-hidden">
      <Setter Property="Opacity" Value="0" />
      <Setter Property="RenderTransform" Value="translateY(8px)" />
    </Style>
  </ControlTheme>

  <ControlTheme x:Key="{x:Type controls:MaterialFabMenu}" TargetType="controls:MaterialFabMenu">
    <Setter Property="ItemsPanel">
      <ItemsPanelTemplate>
        <StackPanel Orientation="Vertical" Spacing="4" HorizontalAlignment="Right" />
      </ItemsPanelTemplate>
    </Setter>
    <Setter Property="Template">
      <ControlTemplate>
        <StackPanel Orientation="Vertical" Spacing="8">
          <Border Name="PART_MenuHost" HorizontalAlignment="Right" IsVisible="False">
            <ItemsPresenter Name="PART_ItemsPresenter" ItemsPanel="{TemplateBinding ItemsPanel}" />
          </Border>
          <controls:MaterialFab Name="PART_Trigger" HorizontalAlignment="Right"
                                CornerRadius="28" Size="Default">
            <PathIcon Name="PART_TriggerIcon" Data="{TemplateBinding TriggerIcon}"
                      Width="12" Height="12" Margin="4" />
          </controls:MaterialFab>
        </StackPanel>
      </ControlTemplate>
    </Setter>
  </ControlTheme>
</ResourceDictionary>
