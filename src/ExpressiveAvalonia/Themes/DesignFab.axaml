<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:controls="using:ExpressiveAvalonia.Controls"
                    xmlns:theming="using:ExpressiveAvalonia.Theming">
  <!-- Material 3 FAB family. Geometry and color roles follow the assigned source packages:
       FAB (local-001450, 72 variants), Extended FAB (local-001377, 72 variants),
       FAB menu (local-001523, 3 variants) and its Primary/Secondary/Tertiary building
       blocks (local-000227..local-000256, 24 variants).
       Elevation: resting FAB = level 3, hovered = level 4, pressed/focused = level 3
       (the source uses exactly the two-layer md.sys.elevation 3 and 4 shadows).
       State layers: hover 8%, focus 10%, pressed 10% per current M3 FAB specs, all drawn by the
       shared MaterialRipple; there is no separate state-layer border and no second pressed alpha.
       The 40 DIP Small container keeps the source InteractiveComponentSize 48 DIP target through
       ContainerInset, while the larger sizes already exceed the minimum.
       Focus ring: surface radius + 2 on every corner, 3 unit stroke in the secondary role. -->
  <x:String x:Key="MaterialFabMenuOpenText">Open actions menu</x:String>
  <x:String x:Key="MaterialFabMenuCloseText">Close actions menu</x:String>

  <!-- Material glyph paths use a 24 by 24 viewport rather than their tight ink bounds. -->
  <ControlTheme x:Key="MaterialFabPathIconTheme" TargetType="PathIcon">
    <Setter Property="Template">
      <ControlTemplate>
        <Viewbox Stretch="Uniform">
          <Canvas Width="24" Height="24">
            <Path Data="{TemplateBinding Data}" Fill="{TemplateBinding Foreground}" Stretch="None" />
          </Canvas>
        </Viewbox>
      </ControlTemplate>
    </Setter>
  </ControlTheme>

  <ControlTheme x:Key="MaterialFabBaseTheme" TargetType="controls:MaterialFabBase">
    <Setter Property="Background" Value="{DynamicResource MaterialPrimaryContainerBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource MaterialOnPrimaryContainerBrush}" />
    <Setter Property="FontFamily" Value="{DynamicResource MaterialFontFamily}" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="ClipToBounds" Value="False" />

    <Style Selector="^[ColorRole=PrimaryContainer]">
      <Setter Property="Background" Value="{DynamicResource MaterialPrimaryContainerBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource MaterialOnPrimaryContainerBrush}" />
    </Style>
    <Style Selector="^[ColorRole=SecondaryContainer]">
      <Setter Property="Background" Value="{DynamicResource MaterialSecondaryContainerBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource MaterialOnSecondaryContainerBrush}" />
    </Style>
    <Style Selector="^[ColorRole=TertiaryContainer]">
      <Setter Property="Background" Value="{DynamicResource MaterialTertiaryContainerBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource MaterialOnTertiaryContainerBrush}" />
    </Style>
    <Style Selector="^[ColorRole=Primary]">
      <Setter Property="Background" Value="{DynamicResource MaterialPrimaryBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource MaterialOnPrimaryBrush}" />
    </Style>
    <Style Selector="^[ColorRole=Secondary]">
      <Setter Property="Background" Value="{DynamicResource MaterialSecondaryBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource MaterialOnSecondaryBrush}" />
    </Style>
    <Style Selector="^[ColorRole=Tertiary]">
      <Setter Property="Background" Value="{DynamicResource MaterialTertiaryBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource MaterialOnTertiaryBrush}" />
    </Style>

    <!-- Elevation and the FAB menu progress are frame-driven: MaterialElevationAnimation and
         MaterialFabMenu publish interpolated values directly, so a template transition would add
         a second, differently timed trajectory. -->

    <!-- Interaction is the shared MaterialRipple: hover/focus/press alpha, press origin and the
         release/reversal timeline all come from the source RippleNode implementation. -->
    <Style Selector="^:focus-visible /template/ Border#FocusRing">
      <Setter Property="IsVisible" Value="True" />
    </Style>

    <!-- Disabled roles are composited (OnSurface container at 12%, content at 38%) instead of
         dimming the complete control, which would stack two translucent layers. -->
    <Style Selector="^:disabled">
      <Setter Property="Background" Value="{DynamicResource MaterialOnSurfaceBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource MaterialOnSurfaceBrush}" />
    </Style>
    <Style Selector="^:disabled /template/ Border#Surface">
      <Setter Property="Opacity" Value="0.12" />
    </Style>
    <Style Selector="^:disabled /template/ Border#ContentHost">
      <Setter Property="Opacity" Value="0.38" />
    </Style>
    <Style Selector="^:disabled /template/ theming|MaterialRipple#Ripple">
      <Setter Property="Opacity" Value="0" />
    </Style>
    <Style Selector="^:disabled /template/ Border#FocusRing">
      <Setter Property="IsVisible" Value="False" />
    </Style>
  </ControlTheme>

  <ControlTheme x:Key="{x:Type controls:MaterialFab}" TargetType="controls:MaterialFab"
                BasedOn="{StaticResource MaterialFabBaseTheme}">
    <Setter Property="Template">
      <ControlTemplate>
        <Panel Background="Transparent">
          <Panel Margin="{TemplateBinding theming:MaterialAssist.ContainerInset}">
            <Border Name="Surface" Background="{TemplateBinding Background}"
                    BoxShadow="{TemplateBinding theming:MaterialAssist.AnimatedShadow}"
                    CornerRadius="{TemplateBinding CornerRadius}" IsHitTestVisible="False" />
            <!-- Current M3 FAB specs: pressed state layer opacity 10%. -->
            <theming:MaterialRipple Name="Ripple"
                                    Fill="{TemplateBinding Foreground}"
                                    CornerRadius="{TemplateBinding CornerRadius}"
                                    PressOpacity="0.10"
                                    HoverOpacity="{DynamicResource MaterialHoverStateLayerOpacity}"
                                    FocusOpacity="{DynamicResource MaterialFocusStateLayerOpacity}"
                                    EnableDrag="False"
                                    IsHitTestVisible="False" />
            <Border Name="ContentHost" Background="Transparent" Padding="{TemplateBinding Padding}">
              <ContentPresenter Name="PART_ContentPresenter"
                                Content="{TemplateBinding Content}"
                                ContentTemplate="{TemplateBinding ContentTemplate}"
                                HorizontalContentAlignment="Center"
                                VerticalContentAlignment="Center" />
            </Border>
            <Border Name="FocusRing" Margin="-2"
                    CornerRadius="{TemplateBinding FocusRingCornerRadius}"
                    BorderBrush="{DynamicResource MaterialSecondaryBrush}"
                    BorderThickness="3" IsVisible="False" IsHitTestVisible="False" />
          </Panel>
        </Panel>
      </ControlTemplate>
    </Setter>

    <Style Selector="^[Size=Small]">
      <Setter Property="Width" Value="48" />
      <Setter Property="Height" Value="48" />
      <Setter Property="theming:MaterialAssist.ContainerInset" Value="4" />
      <Setter Property="CornerRadius" Value="12" />
      <Setter Property="Padding" Value="8" />
    </Style>
    <Style Selector="^[Size=Default]">
      <Setter Property="Width" Value="56" />
      <Setter Property="Height" Value="56" />
      <Setter Property="CornerRadius" Value="16" />
      <Setter Property="Padding" Value="16" />
    </Style>
    <Style Selector="^[Size=Medium]">
      <Setter Property="Width" Value="80" />
      <Setter Property="Height" Value="80" />
      <Setter Property="CornerRadius" Value="20" />
      <Setter Property="Padding" Value="26" />
    </Style>
    <Style Selector="^[Size=Large]">
      <Setter Property="Width" Value="96" />
      <Setter Property="Height" Value="96" />
      <Setter Property="CornerRadius" Value="28" />
      <Setter Property="Padding" Value="30" />
    </Style>


    <!-- Elevation is published by MaterialFabBase through MaterialAssist.AnimatedShadow. -->
  </ControlTheme>

  <ControlTheme x:Key="{x:Type controls:MaterialExtendedFab}" TargetType="controls:MaterialExtendedFab"
                BasedOn="{StaticResource MaterialFabBaseTheme}">
    <Setter Property="Template">
      <ControlTemplate>
        <Panel Background="Transparent">
          <Panel Margin="{TemplateBinding theming:MaterialAssist.ContainerInset}">
            <Border Name="Surface" Background="{TemplateBinding Background}"
                    BoxShadow="{TemplateBinding theming:MaterialAssist.AnimatedShadow}"
                    CornerRadius="{TemplateBinding CornerRadius}" IsHitTestVisible="False" />
            <theming:MaterialRipple Name="Ripple"
                                    Fill="{TemplateBinding Foreground}"
                                    CornerRadius="{TemplateBinding CornerRadius}"
                                    PressOpacity="0.10"
                                    HoverOpacity="{DynamicResource MaterialHoverStateLayerOpacity}"
                                    FocusOpacity="{DynamicResource MaterialFocusStateLayerOpacity}"
                                    EnableDrag="False"
                                    IsHitTestVisible="False" />
            <Border Name="ContentHost" Background="Transparent" Padding="{TemplateBinding Padding}">
              <StackPanel Name="PART_ContentRow" Orientation="Horizontal"
                          HorizontalAlignment="Center" VerticalAlignment="Center">
                <PathIcon Name="PART_Icon" Data="{TemplateBinding Icon}" VerticalAlignment="Center"
                          Theme="{StaticResource MaterialFabPathIconTheme}" />
                <Border Name="PART_LabelHost" Width="0" ClipToBounds="True" VerticalAlignment="Center"
                      Opacity="{TemplateBinding LabelOpacity}">
                  <Panel>
                    <TextBlock Name="PART_Label" Text="{TemplateBinding Label}"
                               Foreground="{TemplateBinding Foreground}"
                               VerticalAlignment="Center" TextWrapping="NoWrap" />
                    <!-- Source text-only overload: Content/ContentTemplate replace the label text. -->
                    <ContentPresenter Name="PART_LabelContent" IsVisible="False"
                                      Content="{TemplateBinding Content}"
                                      ContentTemplate="{TemplateBinding ContentTemplate}"
                                      VerticalAlignment="Center" />
                  </Panel>
                </Border>
              </StackPanel>
            </Border>
            <Border Name="FocusRing" Margin="-2"
                    CornerRadius="{TemplateBinding FocusRingCornerRadius}"
                    BorderBrush="{DynamicResource MaterialSecondaryBrush}"
                    BorderThickness="3" IsVisible="False" IsHitTestVisible="False" />
          </Panel>
        </Panel>
      </ControlTemplate>
    </Setter>

    <Style Selector="^ /template/ TextBlock#PART_Label">
      <Setter Property="FontSize" Value="16" />
      <Setter Property="FontWeight" Value="Medium" />
      <Setter Property="LetterSpacing" Value="0.15" />
      <Setter Property="LineHeight" Value="24" />
    </Style>

    <!-- Expressive geometry: Small/Medium/Large tokens. Padding, the icon-to-label gap and the
         content-row minimum width are driven by MaterialExtendedFab from the same interruptible
         progress as the label clip, so the total width and the icon position move continuously
         instead of jumping between paddings when the label collapses. Only the fixed geometry
         (height, radius, icon box, typography) stays in the theme. -->
    <Style Selector="^[Mode=Expressive][Size=Small]">
      <Setter Property="MinHeight" Value="56" />
      <Setter Property="CornerRadius" Value="16" />
    </Style>
    <Style Selector="^[Mode=Expressive][Size=Small] /template/ PathIcon#PART_Icon">
      <Setter Property="Width" Value="24" />
      <Setter Property="Height" Value="24" />
    </Style>
    <Style Selector="^[Mode=Expressive][Size=Medium]">
      <Setter Property="MinHeight" Value="80" />
      <Setter Property="CornerRadius" Value="20" />
    </Style>
    <Style Selector="^[Mode=Expressive][Size=Medium] /template/ PathIcon#PART_Icon">
      <Setter Property="Width" Value="28" />
      <Setter Property="Height" Value="28" />
    </Style>
    <Style Selector="^[Mode=Expressive][Size=Medium] /template/ TextBlock#PART_Label">
      <Setter Property="FontSize" Value="22" />
      <Setter Property="FontWeight" Value="Normal" />
      <Setter Property="LetterSpacing" Value="0" />
      <Setter Property="LineHeight" Value="28" />
    </Style>
    <Style Selector="^[Mode=Expressive][Size=Large]">
      <Setter Property="MinHeight" Value="96" />
      <Setter Property="CornerRadius" Value="28" />
    </Style>
    <Style Selector="^[Mode=Expressive][Size=Large] /template/ PathIcon#PART_Icon">
      <Setter Property="Width" Value="36" />
      <Setter Property="Height" Value="36" />
    </Style>
    <Style Selector="^[Mode=Expressive][Size=Large] /template/ TextBlock#PART_Label">
      <Setter Property="FontSize" Value="24" />
      <Setter Property="FontWeight" Value="Normal" />
      <Setter Property="LetterSpacing" Value="0" />
      <Setter Property="LineHeight" Value="32" />
    </Style>

    <!-- Classic (baseline) anatomy: ExtendedFabPrimaryTokens/FabBaselineTokens — 56 high,
         16 radius, 24 icon, LabelLarge text. The 16 leading / 20 trailing padding, 12 gap and
         80 expanded / 56 collapsed minimum width come from MaterialExtendedFab because they
         animate; the size token does not apply. -->
    <Style Selector="^[Mode=Classic]">
      <Setter Property="MinHeight" Value="56" />
      <Setter Property="CornerRadius" Value="16" />
    </Style>
    <Style Selector="^[Mode=Classic] /template/ PathIcon#PART_Icon">
      <Setter Property="Width" Value="24" />
      <Setter Property="Height" Value="24" />
    </Style>
    <Style Selector="^[Mode=Classic] /template/ TextBlock#PART_Label">
      <Setter Property="FontSize" Value="{DynamicResource MaterialLabelLargeFontSize}" />
      <Setter Property="FontWeight" Value="{DynamicResource MaterialLabelLargeFontWeight}" />
      <Setter Property="LetterSpacing" Value="{DynamicResource MaterialLabelLargeLetterSpacing}" />
      <Setter Property="LineHeight" Value="{DynamicResource MaterialLabelLargeLineHeight}" />
    </Style>

    <!-- Elevation is published by MaterialFabBase through MaterialAssist.AnimatedShadow. -->
  </ControlTheme>

  <ControlTheme x:Key="{x:Type controls:MaterialFabMenuSegment}" TargetType="controls:MaterialFabMenuSegment"
                BasedOn="{StaticResource MaterialFabBaseTheme}">
    <Setter Property="MinHeight" Value="56" />
    <Setter Property="CornerRadius" Value="28" />
    <Setter Property="Padding" Value="24,16" />
    <Setter Property="HorizontalContentAlignment" Value="Right" />
    <Setter Property="FontSize" Value="16" />
    <Setter Property="FontWeight" Value="Medium" />
    <Setter Property="Template">
      <ControlTemplate>
        <Panel Background="Transparent">
          <Border Name="Surface" Background="{TemplateBinding Background}"
                  CornerRadius="{TemplateBinding CornerRadius}" IsHitTestVisible="False" />
          <theming:MaterialRipple Name="Ripple"
                                  Fill="{TemplateBinding Foreground}"
                                  CornerRadius="{TemplateBinding CornerRadius}"
                                  PressOpacity="0.10"
                                  HoverOpacity="{DynamicResource MaterialHoverStateLayerOpacity}"
                                  FocusOpacity="{DynamicResource MaterialFocusStateLayerOpacity}"
                                  EnableDrag="False"
                                  IsHitTestVisible="False" />
          <Border Name="ContentHost" Background="Transparent" Padding="{TemplateBinding Padding}" ClipToBounds="True">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center">
              <PathIcon Name="PART_Icon" Data="{TemplateBinding Icon}" Width="24" Height="24"
                        Theme="{StaticResource MaterialFabPathIconTheme}" VerticalAlignment="Center" />
              <TextBlock Text="{TemplateBinding Label}"
                         Foreground="{TemplateBinding Foreground}"
                         Margin="8,0,0,0"
                         FontSize="16" FontWeight="Medium" LetterSpacing="0.15" LineHeight="24"
                         VerticalAlignment="Center" TextWrapping="NoWrap" />
            </StackPanel>
          </Border>
          <Border Name="FocusRing" Margin="-2"
                  CornerRadius="{TemplateBinding FocusRingCornerRadius}"
                  BorderBrush="{DynamicResource MaterialSecondaryBrush}"
                  BorderThickness="3" IsVisible="False" IsHitTestVisible="False" />
        </Panel>
      </ControlTemplate>
    </Setter>

    <Style Selector="^.material-fab-menu-hidden">
      <Setter Property="Opacity" Value="0" />
    </Style>
  </ControlTheme>

  <ControlTheme x:Key="{x:Type controls:MaterialFabMenu}" TargetType="controls:MaterialFabMenu">
    <Setter Property="ClipToBounds" Value="False" />
    <Setter Property="ItemsPanel">
      <ItemsPanelTemplate>
        <StackPanel Orientation="Vertical" Spacing="4" HorizontalAlignment="Right" />
      </ItemsPanelTemplate>
    </Setter>
    <Setter Property="Template">
      <ControlTemplate>
        <Grid RowDefinitions="*,Auto" RowSpacing="8">
          <Border Name="PART_MenuHost" HorizontalAlignment="Right" IsVisible="False">
            <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
              <ItemsPresenter Name="PART_ItemsPresenter" ItemsPanel="{TemplateBinding ItemsPanel}" />
            </ScrollViewer>
          </Border>
          <controls:MaterialFab Name="PART_Trigger" Grid.Row="1" HorizontalAlignment="Right"
                                CornerRadius="16" Size="Default">
            <Panel>
              <PathIcon Name="PART_TriggerIcon" Data="{TemplateBinding TriggerIcon}"
                        Theme="{StaticResource MaterialFabPathIconTheme}"
                        Width="24" Height="24" VerticalAlignment="Center" HorizontalAlignment="Center" />
              <PathIcon Name="PART_TriggerCloseIcon" Width="24" Height="24" Opacity="0"
                        Theme="{StaticResource MaterialFabPathIconTheme}"
                        VerticalAlignment="Center" HorizontalAlignment="Center"
                        Data="M5,6.4 L6.4,5 L12,10.6 L17.6,5 L19,6.4 L13.4,12 L19,17.6 L17.6,19 L12,13.4 L6.4,19 L5,17.6 L10.6,12 Z" />
            </Panel>
          </controls:MaterialFab>
        </Grid>
      </ControlTemplate>
    </Setter>
  </ControlTheme>
</ResourceDictionary>
