<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:theming="clr-namespace:ExpressiveAvalonia.Theming">
  <!-- Source families: Checkboxes (local-001236, 30 variants), Radio buttons (local-004445, 10),
       Switch (local-005081, 20). Geometry is taken verbatim from the source fillGeometry:
       18x18 checkbox container with a 12x9.4 check / 12x2 mixed mark, 20x20 radio glyphs and a
       52x32 switch track with a 16/24/28 handle.
       Native controls retain toggle automation, tri-state cycling, radio grouping, knob dragging,
       keyboard activation and access keys.
       Deliberate source deltas, all recorded here rather than left implicit:
       1) Disabled. The source applies 0.38 opacity to the complete checkbox/radio node, so every
          role inside it dims once. This theme dims each role instead (box/stroke OnSurface at 38%,
          mark Surface at full strength, state layer off). The result is identical when the control
          sits on Surface, and differs only on a tinted container, where the source also dims the
          Surface mark; per-role dimming is required because the theme must not fade content text.
       2) Error selected/indeterminate check mark. The source binds that one mark to on-primary while
          the remaining error variants use on-error. This theme uses on-error, which is the correct
          M3 role and matches the other error variants; the two are the same white in baseline light.
       3) Focus. The source "Show focus indicator" boolean is a static variant switch; here it is
          driven by :focus-visible, so the ring only appears for keyboard focus.
       4) Checkboxes pressed ripple is exact, not approximated: the source 50x35 vector is drawn by
          theming:MaterialRipple through its Data property, right/bottom anchored inside the 40-unit
          state layer (source offset -10,+5), clipped by the 20-unit circle, at the source 0.20 node
          opacity, above the 0.10 pressed state layer. Radio buttons and Switch have no ripple node
          in any source variant, so their pressed state is the state layer alone.
       Every painted property is supplied by a style rather than a literal template value, so the
       state styles below always win over the template defaults. -->
  <ControlTheme x:Key="{x:Type CheckBox}" TargetType="CheckBox">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{DynamicResource MaterialOnSurfaceBrush}" />
    <Setter Property="FontFamily" Value="{DynamicResource MaterialFontFamily}" />
    <Setter Property="FontSize" Value="{DynamicResource MaterialBodyLargeFontSize}" />
    <Setter Property="LetterSpacing" Value="{DynamicResource MaterialBodyLargeLetterSpacing}" />
    <Setter Property="MinHeight" Value="48" />
    <Setter Property="MinWidth" Value="48" />
    <Setter Property="HorizontalContentAlignment" Value="Left" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="Template">
      <ControlTemplate>
        <Grid ColumnDefinitions="48,*" Background="{TemplateBinding Background}">
          <!-- 40-unit state layer inside the 48-unit target; the 18-unit box is centred in both. -->
          <Panel Width="40" Height="40" HorizontalAlignment="Center" VerticalAlignment="Center">
            <Border Name="StateLayer" Width="40" Height="40" CornerRadius="20" IsHitTestVisible="False" />
            <!-- The 18-unit container holds both marks. The source places the 12x9.4 check at
                 (3,4) and the 12x2 mixed bar at (3,8) inside it. -->
            <Border Name="Box" Width="18" Height="18" CornerRadius="2">
              <Panel>
                <Path Name="Check" Data="M4 9.4L0 5.4L1.4 4L4 6.6L10.6 0L12 1.4L4 9.4Z"
                      Width="12" Height="9.4" Stretch="None" Margin="3,4,0,0"
                      HorizontalAlignment="Left" VerticalAlignment="Top" IsHitTestVisible="False" />
                <Path Name="Mixed" Data="M0 2L0 0L12 0L12 2L0 2Z"
                      Width="12" Height="2" Stretch="None" Margin="3,8,0,0"
                      HorizontalAlignment="Left" VerticalAlignment="Top" IsHitTestVisible="False" />
              </Panel>
            </Border>
            <!-- Source pressed ripple: the exact 50x35 source vector, right/bottom anchored inside
                 this 40-unit state layer (source offset -10,+5) and clipped by its 20-unit circle.
                 Painted above the container and the check/mixed mark, exactly as the source frame
                 order. Data is the source path normalized to its own 50x35 box, including the
                 rounded bottom-right corner the button-family ripple omits. -->
            <theming:MaterialRipple Name="Ripple" RippleWidth="50" RippleHeight="35" CornerRadius="20"
                                    Data="M1,0.111568 L1,0.891891 C1,0.951597 0.966836,1 0.925926,1 L0,1 C0,0.447714 0.306768,0 0.685186,0 C0.798684,0 0.905736,0.040274 1,0.111568 Z"
                                    IsHitTestVisible="False" />
            <Border Name="FocusRing" Width="44" Height="44" CornerRadius="22" BorderThickness="3"
                    BorderBrush="{DynamicResource MaterialSecondaryBrush}" IsHitTestVisible="False" />
          </Panel>
          <ContentPresenter Name="PART_ContentPresenter" Grid.Column="1" Margin="0,8,8,8"
                            Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}"
                            LineHeight="{DynamicResource MaterialBodyLargeLineHeight}"
                            LetterSpacing="{TemplateBinding LetterSpacing}"
                            HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                            VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"
                            RecognizesAccessKey="True" />
        </Grid>
      </ControlTemplate>
    </Setter>

    <Style Selector="^ /template/ Border#StateLayer">
      <Setter Property="Background" Value="{DynamicResource MaterialOnSurfaceBrush}" />
      <Setter Property="Opacity" Value="0" />
      <Setter Property="Transitions">
        <Transitions>
          <DoubleTransition Property="Opacity" Duration="{DynamicResource MaterialDurationShort4}" Easing="0.2,0,0,1" />
          <BrushTransition Property="Background" Duration="{DynamicResource MaterialDurationShort2}" Easing="0.2,0,0,1" />
        </Transitions>
      </Setter>
    </Style>
    <Style Selector="^ /template/ Border#Box">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="{DynamicResource MaterialOnSurfaceVariantBrush}" />
      <Setter Property="BorderThickness" Value="2" />
      <Setter Property="Transitions">
        <Transitions>
          <BrushTransition Property="Background" Duration="{DynamicResource MaterialDurationShort2}" Easing="0.2,0,0,1" />
          <BrushTransition Property="BorderBrush" Duration="{DynamicResource MaterialDurationShort2}" Easing="0.2,0,0,1" />
          <ThicknessTransition Property="BorderThickness" Duration="{DynamicResource MaterialDurationShort2}" Easing="0.2,0,0,1" />
        </Transitions>
      </Setter>
    </Style>
    <Style Selector="^ /template/ Path#Check, ^ /template/ Path#Mixed">
      <Setter Property="Fill" Value="{DynamicResource MaterialOnPrimaryBrush}" />
      <Setter Property="Opacity" Value="0" />
      <Setter Property="RenderTransform" Value="scale(0.7)" />
      <Setter Property="RenderTransformOrigin" Value="50%,50%" />
      <Setter Property="Transitions">
        <Transitions>
          <DoubleTransition Property="Opacity" Duration="{DynamicResource MaterialDurationShort3}" Easing="0.2,0,0,1" />
          <TransformOperationsTransition Property="RenderTransform" Duration="{DynamicResource MaterialDurationShort3}" Easing="0.05,0.7,0.1,1" />
          <BrushTransition Property="Fill" Duration="{DynamicResource MaterialDurationShort2}" Easing="0.2,0,0,1" />
        </Transitions>
      </Setter>
    </Style>
    <Style Selector="^ /template/ Border#FocusRing">
      <Setter Property="IsVisible" Value="False" />
    </Style>
    <!-- Ripple paint roles from the source pressed variants: Primary on an unselected box,
         OnSurface on a selected/indeterminate box, Error in every error type. The source node
         opacity is 0.20 and is carried by the ripple itself, not the state layer. -->
    <Style Selector="^ /template/ theming|MaterialRipple#Ripple">
      <Setter Property="Fill" Value="{DynamicResource MaterialPrimaryBrush}" />
      <Setter Property="Opacity" Value="0" />
      <Setter Property="Transitions">
        <Transitions>
          <DoubleTransition Property="Opacity" Duration="{DynamicResource MaterialDurationShort2}" Easing="0.2,0,0,1" />
        </Transitions>
      </Setter>
    </Style>

    <!-- Selected and indeterminate share the filled 18-unit container with a 2-unit radius. -->
    <Style Selector="^:checked /template/ Border#Box, ^:indeterminate /template/ Border#Box">
      <Setter Property="Background" Value="{DynamicResource MaterialPrimaryBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource MaterialPrimaryBrush}" />
      <Setter Property="BorderThickness" Value="0" />
    </Style>
    <Style Selector="^:checked /template/ Path#Check">
      <Setter Property="Opacity" Value="1" />
      <Setter Property="RenderTransform" Value="scale(1)" />
    </Style>
    <Style Selector="^:indeterminate /template/ Path#Mixed">
      <Setter Property="Opacity" Value="1" />
      <Setter Property="RenderTransform" Value="scale(1)" />
    </Style>
    <Style Selector="^:checked /template/ Border#StateLayer, ^:indeterminate /template/ Border#StateLayer">
      <Setter Property="Background" Value="{DynamicResource MaterialPrimaryBrush}" />
    </Style>
    <!-- Unselected hover/focus/pressed move the 2-unit outline to OnSurface. -->
    <Style Selector="^:not(:checked):not(:indeterminate):pointerover /template/ Border#Box, ^:not(:checked):not(:indeterminate):focus /template/ Border#Box, ^:not(:checked):not(:indeterminate):pressed /template/ Border#Box">
      <Setter Property="BorderBrush" Value="{DynamicResource MaterialOnSurfaceBrush}" />
    </Style>
    <!-- Error types: unselected keeps the error outline, selected/indeterminate fill with Error.
         The source binds the enabled error check mark to on-primary while the rest of the error
         set uses on-error; the M3 token set uses on-error, so the mark follows on-error here. -->
    <Style Selector="^:error:not(:disabled):not(:checked):not(:indeterminate) /template/ Border#Box">
      <Setter Property="BorderBrush" Value="{DynamicResource MaterialErrorBrush}" />
    </Style>
    <Style Selector="^:error:not(:disabled):checked /template/ Border#Box, ^:error:not(:disabled):indeterminate /template/ Border#Box">
      <Setter Property="Background" Value="{DynamicResource MaterialErrorBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource MaterialErrorBrush}" />
      <Setter Property="BorderThickness" Value="0" />
    </Style>
    <Style Selector="^:error /template/ Border#StateLayer">
      <Setter Property="Background" Value="{DynamicResource MaterialErrorBrush}" />
    </Style>
    <Style Selector="^:error:not(:disabled) /template/ Path#Check, ^:error:not(:disabled) /template/ Path#Mixed">
      <Setter Property="Fill" Value="{DynamicResource MaterialOnErrorBrush}" />
    </Style>
    <Style Selector="^:checked /template/ theming|MaterialRipple#Ripple, ^:indeterminate /template/ theming|MaterialRipple#Ripple">
      <Setter Property="Fill" Value="{DynamicResource MaterialOnSurfaceBrush}" />
    </Style>
    <!-- Declared after the checked roles so an error type wins in every selection state. -->
    <Style Selector="^:error /template/ theming|MaterialRipple#Ripple">
      <Setter Property="Fill" Value="{DynamicResource MaterialErrorBrush}" />
    </Style>
    <Style Selector="^:pressed:not(:disabled) /template/ theming|MaterialRipple#Ripple">
      <Setter Property="Opacity" Value="0.2" />
    </Style>

    <Style Selector="^:pointerover:not(:disabled) /template/ Border#StateLayer"><Setter Property="Opacity" Value="{DynamicResource MaterialHoverStateLayerOpacity}" /></Style>
    <Style Selector="^:focus-visible:not(:disabled) /template/ Border#StateLayer"><Setter Property="Opacity" Value="{DynamicResource MaterialFocusStateLayerOpacity}" /></Style>
    <Style Selector="^:pressed:not(:disabled) /template/ Border#StateLayer"><Setter Property="Opacity" Value="{DynamicResource MaterialPressedStateLayerOpacity}" /></Style>
    <Style Selector="^:focus-visible /template/ Border#FocusRing"><Setter Property="IsVisible" Value="True" /></Style>

    <Style Selector="^:disabled"><Setter Property="Foreground" Value="{DynamicResource MaterialSelectionDisabledOnSurfaceBrush}" /></Style>
    <Style Selector="^:disabled /template/ Border#Box">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="{DynamicResource MaterialSelectionDisabledOnSurfaceBrush}" />
      <Setter Property="BorderThickness" Value="2" />
    </Style>
    <Style Selector="^:disabled:checked /template/ Border#Box, ^:disabled:indeterminate /template/ Border#Box">
      <Setter Property="Background" Value="{DynamicResource MaterialSelectionDisabledOnSurfaceBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource MaterialSelectionDisabledOnSurfaceBrush}" />
      <Setter Property="BorderThickness" Value="0" />
    </Style>
    <Style Selector="^:disabled /template/ Path#Check, ^:disabled /template/ Path#Mixed">
      <Setter Property="Fill" Value="{DynamicResource MaterialSurfaceBrush}" />
    </Style>
    <Style Selector="^:disabled /template/ Border#StateLayer"><Setter Property="Opacity" Value="0" /></Style>
    <Style Selector="^:disabled /template/ theming|MaterialRipple#Ripple"><Setter Property="Opacity" Value="0" /></Style>
    <Style Selector="^:disabled /template/ Border#FocusRing"><Setter Property="IsVisible" Value="False" /></Style>
  </ControlTheme>

  <!-- Radio buttons: the 20x20 source glyph carries ring and dot in one path, so the checked and
       unselected glyphs are two paths whose opacity swaps instead of an ellipse pair. -->
  <ControlTheme x:Key="{x:Type RadioButton}" TargetType="RadioButton">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{DynamicResource MaterialOnSurfaceBrush}" />
    <Setter Property="FontFamily" Value="{DynamicResource MaterialFontFamily}" />
    <Setter Property="FontSize" Value="{DynamicResource MaterialBodyLargeFontSize}" />
    <Setter Property="LetterSpacing" Value="{DynamicResource MaterialBodyLargeLetterSpacing}" />
    <Setter Property="MinHeight" Value="48" />
    <Setter Property="MinWidth" Value="48" />
    <Setter Property="HorizontalContentAlignment" Value="Left" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="Template">
      <ControlTemplate>
        <Grid ColumnDefinitions="48,*" Background="{TemplateBinding Background}">
          <Panel Width="40" Height="40" HorizontalAlignment="Center" VerticalAlignment="Center">
            <Border Name="StateLayer" Width="40" Height="40" CornerRadius="20" IsHitTestVisible="False" />
            <Path Name="RadioUnchecked" Width="20" Height="20" Stretch="None"
                  Data="M10 20C8.61667 20 7.31667 19.7375 6.1 19.2125C4.88333 18.6875 3.825 17.975 2.925 17.075C2.025 16.175 1.3125 15.1167 0.7875 13.9C0.2625 12.6833 0 11.3833 0 10C0 8.61667 0.2625 7.31667 0.7875 6.1C1.3125 4.88333 2.025 3.825 2.925 2.925C3.825 2.025 4.88333 1.3125 6.1 0.7875C7.31667 0.2625 8.61667 0 10 0C11.3833 0 12.6833 0.2625 13.9 0.7875C15.1167 1.3125 16.175 2.025 17.075 2.925C17.975 3.825 18.6875 4.88333 19.2125 6.1C19.7375 7.31667 20 8.61667 20 10C20 11.3833 19.7375 12.6833 19.2125 13.9C18.6875 15.1167 17.975 16.175 17.075 17.075C16.175 17.975 15.1167 18.6875 13.9 19.2125C12.6833 19.7375 11.3833 20 10 20ZM10 18C12.2333 18 14.125 17.225 15.675 15.675C17.225 14.125 18 12.2333 18 10C18 7.76667 17.225 5.875 15.675 4.325C14.125 2.775 12.2333 2 10 2C7.76667 2 5.875 2.775 4.325 4.325C2.775 5.875 2 7.76667 2 10C2 12.2333 2.775 14.125 4.325 15.675C5.875 17.225 7.76667 18 10 18Z"
                  HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False" />
            <Path Name="RadioChecked" Width="20" Height="20" Stretch="None"
                  Data="M10 15C11.3833 15 12.5625 14.5125 13.5375 13.5375C14.5125 12.5625 15 11.3833 15 10C15 8.61667 14.5125 7.4375 13.5375 6.4625C12.5625 5.4875 11.3833 5 10 5C8.61667 5 7.4375 5.4875 6.4625 6.4625C5.4875 7.4375 5 8.61667 5 10C5 11.3833 5.4875 12.5625 6.4625 13.5375C7.4375 14.5125 8.61667 15 10 15ZM10 20C8.61667 20 7.31667 19.7375 6.1 19.2125C4.88333 18.6875 3.825 17.975 2.925 17.075C2.025 16.175 1.3125 15.1167 0.7875 13.9C0.2625 12.6833 0 11.3833 0 10C0 8.61667 0.2625 7.31667 0.7875 6.1C1.3125 4.88333 2.025 3.825 2.925 2.925C3.825 2.025 4.88333 1.3125 6.1 0.7875C7.31667 0.2625 8.61667 0 10 0C11.3833 0 12.6833 0.2625 13.9 0.7875C15.1167 1.3125 16.175 2.025 17.075 2.925C17.975 3.825 18.6875 4.88333 19.2125 6.1C19.7375 7.31667 20 8.61667 20 10C20 11.3833 19.7375 12.6833 19.2125 13.9C18.6875 15.1167 17.975 16.175 17.075 17.075C16.175 17.975 15.1167 18.6875 13.9 19.2125C12.6833 19.7375 11.3833 20 10 20ZM10 18C12.2333 18 14.125 17.225 15.675 15.675C17.225 14.125 18 12.2333 18 10C18 7.76667 17.225 5.875 15.675 4.325C14.125 2.775 12.2333 2 10 2C7.76667 2 5.875 2.775 4.325 4.325C2.775 5.875 2 7.76667 2 10C2 12.2333 2.775 14.125 4.325 15.675C5.875 17.225 7.76667 18 10 18Z"
                  HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False" />
            <Border Name="FocusRing" Width="44" Height="44" CornerRadius="22" BorderThickness="3"
                    BorderBrush="{DynamicResource MaterialSecondaryBrush}" IsHitTestVisible="False" />
          </Panel>
          <ContentPresenter Name="PART_ContentPresenter" Grid.Column="1" Margin="0,8,8,8"
                            Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}"
                            LineHeight="{DynamicResource MaterialBodyLargeLineHeight}"
                            LetterSpacing="{TemplateBinding LetterSpacing}"
                            HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                            VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"
                            RecognizesAccessKey="True" />
        </Grid>
      </ControlTemplate>
    </Setter>

    <Style Selector="^ /template/ Border#StateLayer">
      <Setter Property="Background" Value="{DynamicResource MaterialOnSurfaceBrush}" />
      <Setter Property="Opacity" Value="0" />
      <Setter Property="Transitions">
        <Transitions>
          <DoubleTransition Property="Opacity" Duration="{DynamicResource MaterialDurationShort4}" Easing="0.2,0,0,1" />
          <BrushTransition Property="Background" Duration="{DynamicResource MaterialDurationShort2}" Easing="0.2,0,0,1" />
        </Transitions>
      </Setter>
    </Style>
    <Style Selector="^ /template/ Path#RadioUnchecked">
      <Setter Property="Fill" Value="{DynamicResource MaterialOnSurfaceVariantBrush}" />
      <Setter Property="Opacity" Value="1" />
      <Setter Property="Transitions">
        <Transitions>
          <DoubleTransition Property="Opacity" Duration="{DynamicResource MaterialDurationShort3}" Easing="0.2,0,0,1" />
          <BrushTransition Property="Fill" Duration="{DynamicResource MaterialDurationShort2}" Easing="0.2,0,0,1" />
        </Transitions>
      </Setter>
    </Style>
    <Style Selector="^ /template/ Path#RadioChecked">
      <Setter Property="Fill" Value="{DynamicResource MaterialPrimaryBrush}" />
      <Setter Property="Opacity" Value="0" />
      <Setter Property="RenderTransform" Value="scale(0)" />
      <Setter Property="RenderTransformOrigin" Value="50%,50%" />
      <Setter Property="Transitions">
        <Transitions>
          <DoubleTransition Property="Opacity" Duration="{DynamicResource MaterialDurationShort3}" Easing="0.2,0,0,1" />
          <TransformOperationsTransition Property="RenderTransform" Duration="{DynamicResource MaterialDurationShort3}" Easing="0.05,0.7,0.1,1" />
          <BrushTransition Property="Fill" Duration="{DynamicResource MaterialDurationShort2}" Easing="0.2,0,0,1" />
        </Transitions>
      </Setter>
    </Style>
    <Style Selector="^ /template/ Border#FocusRing">
      <Setter Property="IsVisible" Value="False" />
    </Style>

    <Style Selector="^:checked /template/ Path#RadioUnchecked"><Setter Property="Opacity" Value="0" /></Style>
    <Style Selector="^:checked /template/ Path#RadioChecked">
      <Setter Property="Opacity" Value="1" />
      <Setter Property="RenderTransform" Value="scale(1)" />
    </Style>
    <Style Selector="^:checked /template/ Border#StateLayer">
      <Setter Property="Background" Value="{DynamicResource MaterialPrimaryBrush}" />
    </Style>
    <!-- Unselected hover/focus/pressed raise the glyph from OnSurfaceVariant to OnSurface. -->
    <Style Selector="^:not(:checked):pointerover /template/ Path#RadioUnchecked, ^:not(:checked):focus /template/ Path#RadioUnchecked, ^:not(:checked):pressed /template/ Path#RadioUnchecked">
      <Setter Property="Fill" Value="{DynamicResource MaterialOnSurfaceBrush}" />
    </Style>
    <!-- The pressed ripple uses the complementary role: Primary when unselected, OnSurface when
         selected, exactly as the source pressed variants do. -->
    <Style Selector="^:not(:checked):pressed /template/ Border#StateLayer">
      <Setter Property="Background" Value="{DynamicResource MaterialPrimaryBrush}" />
    </Style>
    <Style Selector="^:checked:pressed /template/ Border#StateLayer">
      <Setter Property="Background" Value="{DynamicResource MaterialOnSurfaceBrush}" />
    </Style>
    <Style Selector="^:pointerover:not(:disabled) /template/ Border#StateLayer"><Setter Property="Opacity" Value="{DynamicResource MaterialHoverStateLayerOpacity}" /></Style>
    <Style Selector="^:focus-visible:not(:disabled) /template/ Border#StateLayer"><Setter Property="Opacity" Value="{DynamicResource MaterialFocusStateLayerOpacity}" /></Style>
    <Style Selector="^:pressed:not(:disabled) /template/ Border#StateLayer"><Setter Property="Opacity" Value="{DynamicResource MaterialPressedStateLayerOpacity}" /></Style>
    <Style Selector="^:focus-visible /template/ Border#FocusRing"><Setter Property="IsVisible" Value="True" /></Style>

    <Style Selector="^:disabled"><Setter Property="Foreground" Value="{DynamicResource MaterialSelectionDisabledOnSurfaceBrush}" /></Style>
    <Style Selector="^:disabled /template/ Path#RadioUnchecked, ^:disabled /template/ Path#RadioChecked">
      <Setter Property="Fill" Value="{DynamicResource MaterialSelectionDisabledOnSurfaceBrush}" />
    </Style>
    <Style Selector="^:disabled /template/ Border#StateLayer"><Setter Property="Opacity" Value="0" /></Style>
    <Style Selector="^:disabled /template/ Border#FocusRing"><Setter Property="IsVisible" Value="False" /></Style>
  </ControlTheme>

  <!-- Switch: 52x32 track. The handle centre travels 16 -> 36 while its diameter grows
       16 (off) / 24 (on, or off with icons) / 28 (pressed). The 32-unit carrier stays centred on
       Canvas.Left 0 or 20, which is exactly the native drag travel (PART_SwitchKnob.Width). -->
  <ControlTheme x:Key="{x:Type ToggleSwitch}" TargetType="ToggleSwitch">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{DynamicResource MaterialOnSurfaceBrush}" />
    <Setter Property="FontFamily" Value="{DynamicResource MaterialFontFamily}" />
    <Setter Property="FontSize" Value="{DynamicResource MaterialBodyLargeFontSize}" />
    <Setter Property="LetterSpacing" Value="{DynamicResource MaterialBodyLargeLetterSpacing}" />
    <Setter Property="MinHeight" Value="48" />
    <Setter Property="MinWidth" Value="52" />
    <Setter Property="OnContent" Value="{x:Null}" />
    <Setter Property="OffContent" Value="{x:Null}" />
    <Setter Property="HorizontalContentAlignment" Value="Left" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="KnobTransitions">
      <Transitions>
        <DoubleTransition Property="Canvas.Left" Duration="{DynamicResource MaterialDurationMedium2}" Easing="0.2,0,0,1" />
      </Transitions>
    </Setter>
    <Setter Property="Template">
      <ControlTemplate>
        <Grid ColumnDefinitions="52,*" Background="{TemplateBinding Background}">
          <Panel Width="52" Height="48" HorizontalAlignment="Left" VerticalAlignment="Center">
            <!-- Disabled colors are composited over Surface, not over one another. -->
            <Border Name="DisabledTrackSurface" Width="52" Height="32" VerticalAlignment="Center" CornerRadius="16" />
            <Border Name="Track" Width="52" Height="32" VerticalAlignment="Center" CornerRadius="16" />
            <Canvas Name="PART_SwitchKnob" Width="20" Height="48" HorizontalAlignment="Left">
              <Grid Name="PART_MovingKnobs" Width="32" Height="48" Background="Transparent">
                <Border Name="ThumbStateLayer" Width="40" Height="40" CornerRadius="20"
                        HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False" />
                <Border Name="Thumb" HorizontalAlignment="Center" VerticalAlignment="Center" CornerRadius="14">
                  <Border Name="ThumbFill" CornerRadius="14">
                    <!-- The 16-unit slot is centred in the handle: a 16-unit handle has no inset,
                         a 24-unit icon-bearing handle gives the source 4-unit inset. -->
                    <Panel Name="IconSlot" Width="16" Height="16">
                      <!-- Native OnContent/OffContent stay available as handle icons. -->
                      <ContentPresenter Name="PART_OffContentPresenter"
                                        Content="{TemplateBinding OffContent}" ContentTemplate="{TemplateBinding OffContentTemplate}"
                                        TextElement.FontSize="16"
                                        HorizontalContentAlignment="Center" VerticalContentAlignment="Center">
                        <ContentPresenter.IsVisible>
                          <MultiBinding Converter="{x:Static BoolConverters.Or}">
                            <Binding Path="OffContent" RelativeSource="{RelativeSource TemplatedParent}" Converter="{x:Static ObjectConverters.IsNotNull}" />
                            <Binding Path="OffContentTemplate" RelativeSource="{RelativeSource TemplatedParent}" Converter="{x:Static ObjectConverters.IsNotNull}" />
                          </MultiBinding>
                        </ContentPresenter.IsVisible>
                      </ContentPresenter>
                      <ContentPresenter Name="PART_OnContentPresenter"
                                        Content="{TemplateBinding OnContent}" ContentTemplate="{TemplateBinding OnContentTemplate}"
                                        TextElement.FontSize="16"
                                        HorizontalContentAlignment="Center" VerticalContentAlignment="Center" />
                      <!-- Source "Icon=True": built-in check / close glyphs in the 16-unit icon slot.
                           MaterialSelection adds the switch-icons class only while OnContent,
                           OffContent and their templates are null, so consumer content wins. -->
                      <Panel Name="ThumbIcons" IsHitTestVisible="False">
                        <Path Name="SwitchOffIcon" Width="9.333" Height="9.333" Stretch="None"
                              Data="M0.933333 9.33333L0 8.4L3.73333 4.66667L0 0.933333L0.933333 0L4.66667 3.73333L8.4 0L9.33333 0.933333L5.6 4.66667L9.33333 8.4L8.4 9.33333L4.66667 5.6L0.933333 9.33333Z"
                              HorizontalAlignment="Center" VerticalAlignment="Center" />
                        <Path Name="SwitchOnIcon" Width="10.867" Height="8.017" Stretch="None"
                              Data="M3.8 8.01667L0 4.21667L0.95 3.26667L3.8 6.11667L9.91667 0L10.8667 0.95L3.8 8.01667Z"
                              HorizontalAlignment="Center" VerticalAlignment="Center" />
                      </Panel>
                    </Panel>
                  </Border>
                </Border>
              </Grid>
            </Canvas>
            <Border Name="FocusRing" Width="56" Height="36" CornerRadius="18" BorderThickness="3"
                    BorderBrush="{DynamicResource MaterialSecondaryBrush}" IsHitTestVisible="False" />
          </Panel>
          <ContentPresenter Name="PART_ContentPresenter" Grid.Column="1" Margin="12,8,0,8"
                            Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}"
                            LineHeight="{DynamicResource MaterialBodyLargeLineHeight}"
                            LetterSpacing="{TemplateBinding LetterSpacing}"
                            HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                            VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}" RecognizesAccessKey="True" />
        </Grid>
      </ControlTemplate>
    </Setter>

    <Style Selector="^ /template/ Border#DisabledTrackSurface">
      <Setter Property="Background" Value="{DynamicResource MaterialSurfaceBrush}" />
      <Setter Property="IsVisible" Value="False" />
    </Style>
    <Style Selector="^ /template/ Border#Track">
      <Setter Property="Background" Value="{DynamicResource MaterialSurfaceContainerHighestBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource MaterialOutlineBrush}" />
      <Setter Property="BorderThickness" Value="2" />
      <Setter Property="Transitions">
        <Transitions>
          <BrushTransition Property="Background" Duration="{DynamicResource MaterialDurationShort2}" Easing="0.2,0,0,1" />
          <BrushTransition Property="BorderBrush" Duration="{DynamicResource MaterialDurationShort2}" Easing="0.2,0,0,1" />
          <ThicknessTransition Property="BorderThickness" Duration="{DynamicResource MaterialDurationShort2}" Easing="0.2,0,0,1" />
        </Transitions>
      </Setter>
    </Style>
    <Style Selector="^ /template/ Border#Thumb">
      <Setter Property="Width" Value="16" />
      <Setter Property="Height" Value="16" />
      <Setter Property="Background" Value="{DynamicResource MaterialSurfaceBrush}" />
      <Setter Property="Transitions">
        <Transitions>
          <DoubleTransition Property="Width" Duration="{DynamicResource MaterialDurationShort4}" Easing="0.2,0,0,1" />
          <DoubleTransition Property="Height" Duration="{DynamicResource MaterialDurationShort4}" Easing="0.2,0,0,1" />
        </Transitions>
      </Setter>
    </Style>
    <Style Selector="^ /template/ Border#ThumbFill">
      <Setter Property="Background" Value="{DynamicResource MaterialOutlineBrush}" />
      <Setter Property="Transitions">
        <Transitions>
          <BrushTransition Property="Background" Duration="{DynamicResource MaterialDurationShort2}" Easing="0.2,0,0,1" />
        </Transitions>
      </Setter>
    </Style>
    <Style Selector="^ /template/ Border#ThumbStateLayer">
      <Setter Property="Background" Value="{DynamicResource MaterialOnSurfaceBrush}" />
      <Setter Property="Opacity" Value="0" />
      <Setter Property="Transitions">
        <Transitions>
          <DoubleTransition Property="Opacity" Duration="{DynamicResource MaterialDurationShort4}" Easing="0.2,0,0,1" />
          <BrushTransition Property="Background" Duration="{DynamicResource MaterialDurationShort2}" Easing="0.2,0,0,1" />
        </Transitions>
      </Setter>
    </Style>
    <Style Selector="^ /template/ ContentPresenter#PART_OffContentPresenter">
      <Setter Property="TextElement.Foreground" Value="{DynamicResource MaterialSurfaceContainerHighestBrush}" />
    </Style>
    <Style Selector="^ /template/ ContentPresenter#PART_OnContentPresenter">
      <Setter Property="TextElement.Foreground" Value="{DynamicResource MaterialOnPrimaryContainerBrush}" />
      <Setter Property="IsVisible" Value="False" />
    </Style>
    <Style Selector="^ /template/ Panel#ThumbIcons">
      <Setter Property="IsVisible" Value="False" />
    </Style>
    <Style Selector="^ /template/ Path#SwitchOffIcon">
      <Setter Property="Fill" Value="{DynamicResource MaterialSurfaceContainerHighestBrush}" />
      <Setter Property="IsVisible" Value="True" />
    </Style>
    <Style Selector="^ /template/ Path#SwitchOnIcon">
      <Setter Property="Fill" Value="{DynamicResource MaterialOnPrimaryContainerBrush}" />
      <Setter Property="IsVisible" Value="False" />
    </Style>
    <Style Selector="^ /template/ Border#FocusRing">
      <Setter Property="IsVisible" Value="False" />
    </Style>

    <Style Selector="^:checked /template/ Border#Track">
      <Setter Property="Background" Value="{DynamicResource MaterialPrimaryBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource MaterialPrimaryBrush}" />
      <Setter Property="BorderThickness" Value="0" />
    </Style>
    <Style Selector="^:checked /template/ Border#Thumb">
      <Setter Property="Width" Value="24" /><Setter Property="Height" Value="24" />
    </Style>
    <Style Selector="^:checked /template/ Border#ThumbFill">
      <Setter Property="Background" Value="{DynamicResource MaterialOnPrimaryBrush}" />
    </Style>
    <Style Selector="^:checked /template/ Border#ThumbStateLayer">
      <Setter Property="Background" Value="{DynamicResource MaterialPrimaryBrush}" />
    </Style>
    <!-- The off presenter owns a MultiBinding for IsVisible, so the checked state hides it with
         opacity instead of fighting that binding. Both presenters occupy the same 16-unit slot. -->
    <Style Selector="^:checked /template/ ContentPresenter#PART_OffContentPresenter"><Setter Property="Opacity" Value="0" /></Style>
    <Style Selector="^:checked /template/ ContentPresenter#PART_OnContentPresenter"><Setter Property="IsVisible" Value="True" /></Style>
    <Style Selector="^:checked /template/ Path#SwitchOffIcon"><Setter Property="IsVisible" Value="False" /></Style>
    <Style Selector="^:checked /template/ Path#SwitchOnIcon"><Setter Property="IsVisible" Value="True" /></Style>
    <!-- Icon-bearing off handle is 24, so the built-in glyph keeps its 4-unit inset. -->
    <Style Selector="^.switch-icons /template/ Panel#ThumbIcons">
      <Setter Property="IsVisible" Value="True" />
    </Style>
    <Style Selector="^.switch-icons:not(:checked):not(:pressed):not(:dragging) /template/ Border#Thumb">
      <Setter Property="Width" Value="24" /><Setter Property="Height" Value="24" />
    </Style>

    <!-- Off hover/focus/pressed raise the handle from Outline to OnSurfaceVariant; on hover/focus/
         pressed move it from OnPrimary to PrimaryContainer. -->
    <Style Selector="^:not(:checked):pointerover /template/ Border#ThumbFill, ^:not(:checked):focus /template/ Border#ThumbFill, ^:not(:checked):pressed /template/ Border#ThumbFill, ^:not(:checked):dragging /template/ Border#ThumbFill">
      <Setter Property="Background" Value="{DynamicResource MaterialOnSurfaceVariantBrush}" />
    </Style>
    <Style Selector="^:checked:pointerover /template/ Border#ThumbFill, ^:checked:focus /template/ Border#ThumbFill, ^:checked:pressed /template/ Border#ThumbFill, ^:checked:dragging /template/ Border#ThumbFill">
      <Setter Property="Background" Value="{DynamicResource MaterialPrimaryContainerBrush}" />
    </Style>
    <Style Selector="^:pointerover:not(:disabled) /template/ Border#ThumbStateLayer"><Setter Property="Opacity" Value="{DynamicResource MaterialHoverStateLayerOpacity}" /></Style>
    <Style Selector="^:focus-visible:not(:disabled) /template/ Border#ThumbStateLayer"><Setter Property="Opacity" Value="{DynamicResource MaterialFocusStateLayerOpacity}" /></Style>
    <Style Selector="^:pressed:not(:disabled) /template/ Border#ThumbStateLayer, ^:dragging:not(:disabled) /template/ Border#ThumbStateLayer"><Setter Property="Opacity" Value="{DynamicResource MaterialPressedStateLayerOpacity}" /></Style>
    <Style Selector="^:pressed /template/ Border#Thumb, ^:dragging /template/ Border#Thumb">
      <Setter Property="Width" Value="28" /><Setter Property="Height" Value="28" />
    </Style>
    <Style Selector="^:focus-visible /template/ Border#FocusRing"><Setter Property="IsVisible" Value="True" /></Style>

    <Style Selector="^:disabled"><Setter Property="Foreground" Value="{DynamicResource MaterialSelectionDisabledOnSurfaceBrush}" /></Style>
    <Style Selector="^:disabled /template/ Border#DisabledTrackSurface"><Setter Property="IsVisible" Value="True" /></Style>
    <Style Selector="^:disabled /template/ Border#Track">
      <Setter Property="Background" Value="{DynamicResource MaterialSwitchDisabledOffTrackBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource MaterialSwitchDisabledTrackBrush}" />
      <Setter Property="BorderThickness" Value="2" />
    </Style>
    <Style Selector="^:disabled:checked /template/ Border#Track">
      <Setter Property="Background" Value="{DynamicResource MaterialSwitchDisabledTrackBrush}" />
      <Setter Property="BorderThickness" Value="0" />
    </Style>
    <Style Selector="^:disabled /template/ Border#ThumbFill">
      <Setter Property="Background" Value="{DynamicResource MaterialSelectionDisabledOnSurfaceBrush}" />
    </Style>
    <Style Selector="^:disabled:checked /template/ Border#ThumbFill">
      <Setter Property="Background" Value="{DynamicResource MaterialSurfaceBrush}" />
    </Style>
    <Style Selector="^:disabled /template/ ContentPresenter#PART_OffContentPresenter">
      <Setter Property="TextElement.Foreground" Value="{DynamicResource MaterialSwitchDisabledOffIconBrush}" />
    </Style>
    <Style Selector="^:disabled /template/ ContentPresenter#PART_OnContentPresenter">
      <Setter Property="TextElement.Foreground" Value="{DynamicResource MaterialSelectionDisabledOnSurfaceBrush}" />
    </Style>
    <Style Selector="^:disabled /template/ Path#SwitchOffIcon, ^:disabled /template/ Path#SwitchOnIcon">
      <Setter Property="Fill" Value="{DynamicResource MaterialSelectionDisabledOnSurfaceBrush}" />
    </Style>
    <Style Selector="^:disabled /template/ Border#ThumbStateLayer"><Setter Property="Opacity" Value="0" /></Style>
    <Style Selector="^:disabled /template/ Border#FocusRing"><Setter Property="IsVisible" Value="False" /></Style>
  </ControlTheme>
</ResourceDictionary>
