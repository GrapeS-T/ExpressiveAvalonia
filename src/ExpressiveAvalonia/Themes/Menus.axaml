<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:conv="using:Avalonia.Controls.Converters"
                    xmlns:data="using:Avalonia.Data.Converters"
                    xmlns:md="using:ExpressiveAvalonia.Theming">
  <conv:PlatformKeyGestureConverter x:Key="MaterialMenuKeyGestureConverter" />

  <!-- MenuTokens v0_210: container SurfaceContainer at elevation 2, corner extra-small (4),
       item height 48, min width 112, max width 280. Menu.kt provides labelLarge for items. -->
  <ControlTheme x:Key="{x:Type MenuItem}" TargetType="MenuItem">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{DynamicResource MaterialOnSurfaceBrush}" />
    <Setter Property="FontSize" Value="{DynamicResource MaterialLabelLargeFontSize}" />
    <Setter Property="FontWeight" Value="{DynamicResource MaterialLabelLargeFontWeight}" />
    <Setter Property="MinHeight" Value="48" />
    <Setter Property="MinWidth" Value="112" />
    <Setter Property="MaxWidth" Value="280" />
    <Setter Property="Padding" Value="12,8" />
    <Setter Property="CornerRadius" Value="4" />
    <Setter Property="Template">
      <ControlTemplate>
        <Border Name="Root" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{TemplateBinding CornerRadius}">
          <Panel>
          <Border Name="StateLayer" Background="{DynamicResource MaterialOnSurfaceBrush}" CornerRadius="{TemplateBinding CornerRadius}" Opacity="0" IsHitTestVisible="False" />
          <Grid ColumnDefinitions="Auto,*,Auto,Auto" Margin="{TemplateBinding Padding}">
            <ContentPresenter Name="PART_IconPresenter" Content="{TemplateBinding Icon}" Width="24" Height="24" Margin="0,0,12,0"
                              IsVisible="{Binding Icon, RelativeSource={RelativeSource TemplatedParent}, Converter={x:Static data:ObjectConverters.IsNotNull}}"
                              TextElement.Foreground="{DynamicResource MaterialOnSurfaceVariantBrush}"
                              HorizontalAlignment="Left" VerticalAlignment="Center" />
            <Path Name="Check" Width="18" Height="18" Margin="0,0,18,0" Stretch="Uniform" HorizontalAlignment="Left" VerticalAlignment="Center"
                  Data="M 1,9 L 7,15 L 18,2" Stroke="{TemplateBinding Foreground}" StrokeThickness="2" IsVisible="False" />
            <Ellipse Name="RadioMark" Width="10" Height="10" Margin="0,0,26,0" Fill="{TemplateBinding Foreground}"
                     HorizontalAlignment="Left" VerticalAlignment="Center" IsVisible="False" />
            <ContentPresenter Name="PART_HeaderPresenter" Grid.Column="1" Content="{TemplateBinding Header}"
                              ContentTemplate="{TemplateBinding HeaderTemplate}" RecognizesAccessKey="True" VerticalAlignment="Center"
                              TextBlock.LineHeight="{DynamicResource MaterialLabelLargeLineHeight}"
                              TextBlock.LetterSpacing="{DynamicResource MaterialLabelLargeLetterSpacing}" />
            <TextBlock Name="PART_InputGestureText" Grid.Column="2" Margin="16,0,0,0" VerticalAlignment="Center"
                       FontSize="{DynamicResource MaterialLabelLargeFontSize}" Foreground="{DynamicResource MaterialOnSurfaceVariantBrush}"
                       IsVisible="{Binding InputGesture, RelativeSource={RelativeSource TemplatedParent}, Converter={x:Static data:ObjectConverters.IsNotNull}}"
                       Text="{TemplateBinding InputGesture, Converter={StaticResource MaterialMenuKeyGestureConverter}}" />
            <Path Name="SubmenuArrow" Grid.Column="3" Width="6" Height="10" Margin="12,0,0,0" Stretch="Uniform"
                  HorizontalAlignment="Right" VerticalAlignment="Center" Data="M 0,0 L 5,5 L 0,10"
                  Stroke="{DynamicResource MaterialOnSurfaceVariantBrush}" StrokeThickness="1.5" />
            <Popup Name="PART_Popup" IsLightDismissEnabled="False" IsOpen="{TemplateBinding IsSubMenuOpen, Mode=TwoWay}"
                   Placement="RightEdgeAlignedTop">
              <Border Background="{DynamicResource MaterialSurfaceContainerBrush}" CornerRadius="4"
                      BoxShadow="{DynamicResource MaterialElevationLevel2Shadow}">
                <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                  <ItemsPresenter Name="PART_ItemsPresenter" Margin="4,8" Grid.IsSharedSizeScope="True"
                                  ItemsPanel="{TemplateBinding ItemsPanel}" />
                </ScrollViewer>
              </Border>
            </Popup>
          </Grid>
          </Panel>
        </Border>
      </ControlTemplate>
    </Setter>
    <Style Selector="^ /template/ Border#StateLayer">
      <Setter Property="Transitions">
        <Transitions>
          <DoubleTransition Property="Opacity" Duration="{DynamicResource MaterialDurationShort4}" Easing="0.2,0,0,1" />
        </Transitions>
      </Setter>
    </Style>
    <Style Selector="^:separator">
      <Setter Property="MinHeight" Value="1" />
      <Setter Property="Template"><ControlTemplate><Separator Margin="0,8" /></ControlTemplate></Setter>
    </Style>
    <Style Selector="^:empty /template/ Path#SubmenuArrow"><Setter Property="IsVisible" Value="False" /></Style>
    <Style Selector="^:selected /template/ Border#StateLayer, ^:pointerover /template/ Border#StateLayer, ^:open /template/ Border#StateLayer"><Setter Property="Opacity" Value="{DynamicResource MaterialHoverStateLayerOpacity}" /></Style>
    <Style Selector="^:pressed /template/ Border#StateLayer"><Setter Property="Opacity" Value="{DynamicResource MaterialPressedStateLayerOpacity}" /></Style>
    <Style Selector="^:checked"><Setter Property="Background" Value="{DynamicResource MaterialSecondaryContainerBrush}" /><Setter Property="Foreground" Value="{DynamicResource MaterialOnSecondaryContainerBrush}" /></Style>
    <Style Selector="^:checked /template/ ContentPresenter#PART_IconPresenter, ^:checked /template/ TextBlock#PART_InputGestureText"><Setter Property="TextElement.Foreground" Value="{DynamicResource MaterialOnSecondaryContainerBrush}" /></Style>
    <Style Selector="^:checked /template/ Path#SubmenuArrow"><Setter Property="Stroke" Value="{DynamicResource MaterialOnSecondaryContainerBrush}" /></Style>
    <Style Selector="^:focus-visible /template/ Border#Root">
      <Setter Property="BorderBrush" Value="{DynamicResource MaterialSecondaryBrush}" /><Setter Property="BorderThickness" Value="2" />
    </Style>
    <Style Selector="^:toggle /template/ ContentPresenter#PART_IconPresenter, ^:radio /template/ ContentPresenter#PART_IconPresenter"><Setter Property="IsVisible" Value="False" /></Style>
    <Style Selector="^:checked:toggle /template/ Path#Check"><Setter Property="IsVisible" Value="True" /></Style>
    <Style Selector="^:checked:radio /template/ Ellipse#RadioMark"><Setter Property="IsVisible" Value="True" /></Style>
    <Style Selector="^[FlowDirection=RightToLeft] /template/ Popup#PART_Popup"><Setter Property="Placement" Value="LeftEdgeAlignedTop" /></Style>
    <Style Selector="^[FlowDirection=RightToLeft] /template/ Path#SubmenuArrow"><Setter Property="Data" Value="M 5,0 L 0,5 L 5,10" /></Style>
    <Style Selector="^:disabled"><Setter Property="Foreground" Value="{DynamicResource MaterialOnSurfaceBrush}" /></Style>
    <Style Selector="^:disabled /template/ ContentPresenter#PART_HeaderPresenter, ^:disabled /template/ ContentPresenter#PART_IconPresenter, ^:disabled /template/ TextBlock#PART_InputGestureText, ^:disabled /template/ Path#Check, ^:disabled /template/ Ellipse#RadioMark, ^:disabled /template/ Path#SubmenuArrow"><Setter Property="Opacity" Value="0.38" /></Style>
    <Style Selector="^:disabled /template/ ContentPresenter#PART_IconPresenter, ^:disabled /template/ TextBlock#PART_InputGestureText"><Setter Property="TextElement.Foreground" Value="{DynamicResource MaterialOnSurfaceBrush}" /></Style>
    <Style Selector="^:disabled /template/ Path#SubmenuArrow"><Setter Property="Stroke" Value="{DynamicResource MaterialOnSurfaceBrush}" /></Style>
    <Style Selector="^:disabled /template/ Border#StateLayer"><Setter Property="Opacity" Value="0" /></Style>
  </ControlTheme>

  <ControlTheme x:Key="MaterialTopLevelMenuItem" TargetType="MenuItem" BasedOn="{StaticResource {x:Type MenuItem}}">
    <Setter Property="MinWidth" Value="48" />
    <Setter Property="Padding" Value="12,8" />
    <Setter Property="Template">
      <ControlTemplate>
        <Border Name="Root" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{TemplateBinding CornerRadius}">
          <Panel>
            <Border Name="StateLayer" Background="{DynamicResource MaterialOnSurfaceBrush}" CornerRadius="{TemplateBinding CornerRadius}" Opacity="0" IsHitTestVisible="False" />
            <ContentPresenter Name="PART_HeaderPresenter" Margin="{TemplateBinding Padding}"
                              Content="{TemplateBinding Header}" ContentTemplate="{TemplateBinding HeaderTemplate}"
                              RecognizesAccessKey="True" VerticalAlignment="Center"
                              TextBlock.LineHeight="{DynamicResource MaterialLabelLargeLineHeight}"
                              TextBlock.LetterSpacing="{DynamicResource MaterialLabelLargeLetterSpacing}" />
            <Popup Name="PART_Popup" IsLightDismissEnabled="True" IsOpen="{TemplateBinding IsSubMenuOpen, Mode=TwoWay}"
                   Placement="BottomEdgeAlignedLeft" OverlayInputPassThroughElement="{Binding $parent[Menu]}">
              <Border Background="{DynamicResource MaterialSurfaceContainerBrush}" CornerRadius="4"
                      BoxShadow="{DynamicResource MaterialElevationLevel2Shadow}">
                <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                  <ItemsPresenter Name="PART_ItemsPresenter" Margin="4,8" Grid.IsSharedSizeScope="True"
                                  ItemsPanel="{TemplateBinding ItemsPanel}" />
                </ScrollViewer>
              </Border>
            </Popup>
          </Panel>
        </Border>
      </ControlTemplate>
    </Setter>
    <Style Selector="^[FlowDirection=RightToLeft] /template/ Popup#PART_Popup"><Setter Property="Placement" Value="BottomEdgeAlignedRight" /></Style>
  </ControlTheme>

  <ControlTheme x:Key="{x:Type Menu}" TargetType="Menu">
    <Setter Property="Background" Value="{DynamicResource MaterialSurfaceBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource MaterialOnSurfaceBrush}" />
    <Setter Property="ItemContainerTheme" Value="{StaticResource MaterialTopLevelMenuItem}" />
    <Setter Property="Template">
      <ControlTemplate>
        <Border Padding="{TemplateBinding Padding}" Background="{TemplateBinding Background}"
                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                CornerRadius="{TemplateBinding CornerRadius}">
          <ItemsPresenter Name="PART_ItemsPresenter" ItemsPanel="{TemplateBinding ItemsPanel}"
                          KeyboardNavigation.TabNavigation="Continue" />
        </Border>
      </ControlTemplate>
    </Setter>
  </ControlTheme>

  <ControlTheme x:Key="{x:Type ContextMenu}" TargetType="ContextMenu">
    <Setter Property="Background" Value="{DynamicResource MaterialSurfaceContainerBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource MaterialOnSurfaceBrush}" />
    <Setter Property="CornerRadius" Value="4" />
    <Setter Property="Padding" Value="4,8" />
    <Setter Property="Focusable" Value="True" />
    <Setter Property="Template">
      <ControlTemplate>
        <Border Padding="{TemplateBinding Padding}" Background="{TemplateBinding Background}"
                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                CornerRadius="{TemplateBinding CornerRadius}" BoxShadow="{DynamicResource MaterialElevationLevel2Shadow}">
          <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
            <ItemsPresenter Name="PART_ItemsPresenter" ItemsPanel="{TemplateBinding ItemsPanel}"
                            Grid.IsSharedSizeScope="True" KeyboardNavigation.TabNavigation="Continue" />
          </ScrollViewer>
        </Border>
      </ControlTemplate>
    </Setter>
  </ControlTheme>

  <ControlTheme x:Key="{x:Type MenuFlyoutPresenter}" TargetType="MenuFlyoutPresenter">
    <Setter Property="Background" Value="{DynamicResource MaterialSurfaceContainerBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource MaterialOnSurfaceBrush}" />
    <Setter Property="CornerRadius" Value="4" />
    <Setter Property="Padding" Value="4,8" />
    <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
    <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto" />
    <Setter Property="Template">
      <ControlTemplate>
        <Border Padding="{TemplateBinding Padding}" Background="{TemplateBinding Background}"
                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                CornerRadius="{TemplateBinding CornerRadius}" BoxShadow="{DynamicResource MaterialElevationLevel2Shadow}">
          <ScrollViewer HorizontalScrollBarVisibility="{TemplateBinding (ScrollViewer.HorizontalScrollBarVisibility)}"
                        VerticalScrollBarVisibility="{TemplateBinding (ScrollViewer.VerticalScrollBarVisibility)}">
            <ItemsPresenter Name="PART_ItemsPresenter" ItemsPanel="{TemplateBinding ItemsPanel}"
                            Grid.IsSharedSizeScope="True" KeyboardNavigation.TabNavigation="Continue" />
          </ScrollViewer>
        </Border>
      </ControlTemplate>
    </Setter>
  </ControlTheme>

  <ControlTheme x:Key="{x:Type FlyoutPresenter}" TargetType="FlyoutPresenter">
    <Setter Property="Background" Value="{DynamicResource MaterialSurfaceContainerBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource MaterialOnSurfaceBrush}" />
    <Setter Property="CornerRadius" Value="12" />
    <Setter Property="Padding" Value="16" />
    <Setter Property="Template">
      <ControlTemplate>
        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{TemplateBinding CornerRadius}"
                BoxShadow="{DynamicResource MaterialElevationLevel2Shadow}">
          <ContentPresenter Name="PART_ContentPresenter" Padding="{TemplateBinding Padding}"
                            Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}"
                            HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                            VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}" />
        </Border>
      </ControlTemplate>
    </Setter>
    <Style Selector="^.material-rich-tooltip">
      <Setter Property="MinWidth" Value="40" /><Setter Property="MinHeight" Value="24" /><Setter Property="MaxWidth" Value="320" />
      <Setter Property="Padding" Value="16,12" />
      <Setter Property="FontSize" Value="{DynamicResource MaterialBodyMediumFontSize}" />
      <Setter Property="FontWeight" Value="{DynamicResource MaterialBodyMediumFontWeight}" />
      <Setter Property="Foreground" Value="{DynamicResource MaterialOnSurfaceVariantBrush}" />
      <Setter Property="Background" Value="{DynamicResource MaterialSurfaceContainerBrush}" />
      <Setter Property="CornerRadius" Value="12" />
      <Style Selector="^ ContentControl#Actions Button">
        <Setter Property="md:MaterialAssist.ButtonVariant" Value="Text" />
        <!-- RichTooltipTokens.ActionLabelTextColor = Primary, unlike the neutral text button. -->
        <Setter Property="Foreground" Value="{DynamicResource MaterialPrimaryBrush}" />
        <Setter Property="MinHeight" Value="36" />
      </Style>
      <Style Selector="^ ContentControl TextBlock"><Setter Property="TextWrapping" Value="Wrap" /></Style>
    </Style>
  </ControlTheme>

  <ControlTheme x:Key="{x:Type ToolTip}" TargetType="ToolTip">
    <Setter Property="Background" Value="{DynamicResource MaterialInverseSurfaceBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource MaterialInverseOnSurfaceBrush}" />
    <Setter Property="FontSize" Value="{DynamicResource MaterialBodySmallFontSize}" />
    <Setter Property="FontWeight" Value="{DynamicResource MaterialBodySmallFontWeight}" />
    <Setter Property="MinWidth" Value="40" /><Setter Property="MinHeight" Value="24" />
    <Setter Property="Padding" Value="8,4" />
    <Setter Property="CornerRadius" Value="4" />
    <Setter Property="MaxWidth" Value="200" />
    <Setter Property="Template">
      <ControlTemplate>
        <ContentPresenter Name="PART_ContentPresenter" Padding="{TemplateBinding Padding}"
                          Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                          BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{TemplateBinding CornerRadius}"
                          Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}"
                          TextBlock.LineHeight="{DynamicResource MaterialBodySmallLineHeight}"
                          TextBlock.LetterSpacing="{DynamicResource MaterialBodySmallLetterSpacing}"
                          TextBlock.TextWrapping="Wrap" />
      </ControlTemplate>
    </Setter>
  </ControlTheme>
</ResourceDictionary>
