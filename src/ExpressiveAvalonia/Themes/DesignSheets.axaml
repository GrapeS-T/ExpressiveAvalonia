<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:controls="using:ExpressiveAvalonia.Controls"
                    xmlns:theming="using:ExpressiveAvalonia.Theming"
                    xmlns:data="using:Avalonia.Data.Converters">
  <!-- Sheet anatomy from the Material design source:
       Side sheet  320 wide (400 max), 76 header (12/12/16/24 padding), Title Large headline on
                   OnSurfaceVariant, 48 icon-button affordances, scrolling content slot, actions
                   row above a 1-pixel OutlineVariant divider (12/24 padding, 8 gap). Modal sheets
                   use the SurfaceContainerLow fill with a 16 corner radius; standard sheets use
                   Surface with square corners.
       Bottom      28/28/0/0 corners, 36 drag-handle header (16 padding, 32x4 Outline handle),
                   scrolling content slot. Modal drops the resting elevation shadow.
       Scrim       MaterialScrim at 32% opacity in both modal presentations.
       Strings are resources so an application can localize them. -->
  <x:String x:Key="MaterialSheetCloseText">Close</x:String>
  <x:String x:Key="MaterialSheetBackText">Back</x:String>
  <x:String x:Key="MaterialSheetDragHandleText">Drag to dismiss</x:String>
  <x:String x:Key="MaterialBottomSheetText">Bottom sheet</x:String>

  <!-- Affordances reuse the implicit Material Button theme (icon button, Small, Standard,
       Round) so disabled, hover, focus and pressed states stay identical to other icon buttons. -->

  <ControlTheme x:Key="{x:Type controls:MaterialSideSheet}" TargetType="controls:MaterialSideSheet">
    <Setter Property="IsModal" Value="False" />
    <Setter Property="FontFamily" Value="{DynamicResource MaterialFontFamily}" />
    <Setter Property="FontSize" Value="{DynamicResource MaterialBodyMediumFontSize}" />
    <Setter Property="Foreground" Value="{DynamicResource MaterialOnSurfaceBrush}" />
    <Setter Property="Template">
      <ControlTemplate>
        <Panel Name="PART_Root" ClipToBounds="True">
          <Border Name="PART_Scrim" Background="{DynamicResource MaterialScrimBrush}" Opacity="0" IsVisible="False" />
          <Border Name="PART_Surface"
                  Width="{TemplateBinding SheetWidth}" MaxWidth="400"
                  HorizontalAlignment="Right" VerticalAlignment="Stretch"
                  Background="{DynamicResource MaterialSurfaceBrush}"
                  BorderBrush="{DynamicResource MaterialOutlineVariantBrush}"
                  BorderThickness="1,0,0,0">
            <Grid RowDefinitions="Auto,*,Auto">
              <Grid Name="PART_Header" ColumnDefinitions="Auto,*,Auto" Margin="24,12,12,16">
                <Button Name="PART_BackButton"
                        theming:MaterialAssist.IsIconButton="True"
                        theming:MaterialAssist.ControlSize="Small"
                        theming:MaterialAssist.ButtonVariant="Standard"
                        theming:MaterialAssist.ButtonShape="Round"
                        theming:MaterialAssist.IconButtonWidth="Narrow"
                        IsVisible="{TemplateBinding ShowBackButton}"
                        AutomationProperties.Name="{DynamicResource MaterialSheetBackText}"
                        HorizontalAlignment="Left" VerticalAlignment="Center">
                  <Grid Width="24" Height="24">
                    <Path Width="16" Height="16" Stretch="None"
                          HorizontalAlignment="Center" VerticalAlignment="Center"
                          Data="M3.825 9L9.425 14.6L8 16L0 8L8 0L9.425 1.4L3.825 7L16 7L16 9L3.825 9Z"
                          Fill="{Binding $parent[Button].Foreground}" />
                  </Grid>
                </Button>
                <TextBlock Name="PART_Headline" Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center"
                           Text="{TemplateBinding Headline}" TextWrapping="Wrap"
                           FontSize="{DynamicResource MaterialTitleLargeFontSize}"
                           FontWeight="{DynamicResource MaterialTitleLargeFontWeight}"
                           LineHeight="{DynamicResource MaterialTitleLargeLineHeight}"
                           LetterSpacing="{DynamicResource MaterialTitleLargeLetterSpacing}"
                           Foreground="{DynamicResource MaterialOnSurfaceVariantBrush}">
                  <TextBlock.IsVisible>
                    <Binding Path="Headline" RelativeSource="{RelativeSource TemplatedParent}"
                             Converter="{x:Static data:StringConverters.IsNotNullOrEmpty}" />
                  </TextBlock.IsVisible>
                </TextBlock>
                <Button Name="PART_CloseButton" Grid.Column="2"
                        theming:MaterialAssist.IsIconButton="True"
                        theming:MaterialAssist.ControlSize="Small"
                        theming:MaterialAssist.ButtonVariant="Standard"
                        theming:MaterialAssist.ButtonShape="Round"
                        IsVisible="{TemplateBinding ShowCloseButton}"
                        AutomationProperties.Name="{DynamicResource MaterialSheetCloseText}"
                        HorizontalAlignment="Right" VerticalAlignment="Center">
                  <Grid Width="24" Height="24">
                    <Path Width="14" Height="14" Stretch="None"
                          HorizontalAlignment="Center" VerticalAlignment="Center"
                          Data="M1.4 14L0 12.6L5.6 7L0 1.4L1.4 0L7 5.6L12.6 0L14 1.4L8.4 7L14 12.6L12.6 14L7 8.4L1.4 14Z"
                          Fill="{Binding $parent[Button].Foreground}" />
                  </Grid>
                </Button>
              </Grid>
              <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                <ContentPresenter Name="PART_ContentHost"
                                  Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}"
                                  HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                  VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}" />
              </ScrollViewer>
              <StackPanel Name="PART_Actions" Grid.Row="2">
                <Border Height="1" Background="{DynamicResource MaterialOutlineVariantBrush}" />
                <ContentControl Name="PART_ActionsHost" Margin="24,12,24,0"
                                Content="{TemplateBinding Actions}" ContentTemplate="{TemplateBinding ActionsTemplate}"
                                HorizontalContentAlignment="Left" VerticalContentAlignment="Center" />
              </StackPanel>
            </Grid>
          </Border>
        </Panel>
      </ControlTemplate>
    </Setter>

    <!-- Modal sheets use the surface container low fill; standard sheets sit on Surface. -->
    <Style Selector="^[IsModal=True] /template/ Border#PART_Surface">
      <Setter Property="Background" Value="{DynamicResource MaterialSurfaceContainerLowBrush}" />
    </Style>
  </ControlTheme>

  <ControlTheme x:Key="{x:Type controls:MaterialBottomSheet}" TargetType="controls:MaterialBottomSheet">
    <Setter Property="IsModal" Value="False" />
    <Setter Property="FontFamily" Value="{DynamicResource MaterialFontFamily}" />
    <Setter Property="FontSize" Value="{DynamicResource MaterialBodyMediumFontSize}" />
    <Setter Property="Foreground" Value="{DynamicResource MaterialOnSurfaceBrush}" />
    <Setter Property="Template">
      <ControlTemplate>
        <Panel Name="PART_Root" ClipToBounds="True">
          <Border Name="PART_Scrim" Background="{DynamicResource MaterialScrimBrush}" Opacity="0" IsVisible="False" />
          <Border Name="PART_Surface"
                  HorizontalAlignment="Stretch" VerticalAlignment="Bottom"
                  MaxWidth="{TemplateBinding SheetMaxWidth}"
                  Background="{DynamicResource MaterialSurfaceContainerLowBrush}">
            <Grid RowDefinitions="Auto,Auto,Auto">
              <!-- BottomSheetDefaults.DragHandle: 32x4 inverted capsule in the docked drag-handle
                   color, with 22 DIP above and below (48 DIP header). SheetDragHandle keeps this
                   Border anatomy while exposing Invoke plus gesture-gated expand/collapse/dismiss
                   through its native automation peer. -->
              <controls:SheetDragHandle Name="PART_DragHandle" Background="Transparent" Padding="0,22"
                      IsVisible="{TemplateBinding ShowDragHandle}"
                      AutomationProperties.Name="{DynamicResource MaterialSheetDragHandleText}">
                <Border Width="32" Height="4" CornerRadius="9999"
                        HorizontalAlignment="Center" VerticalAlignment="Center"
                        Background="{DynamicResource MaterialOnSurfaceVariantBrush}" />
              </controls:SheetDragHandle>
              <ScrollViewer Name="PART_ContentScroll" Grid.Row="1"
                            HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                <ContentPresenter Name="PART_ContentHost"
                                  Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}"
                                  HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                  VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}" />
              </ScrollViewer>
              <StackPanel Name="PART_Actions" Grid.Row="2">
                <Border Height="1" Background="{DynamicResource MaterialOutlineVariantBrush}" />
                <ContentControl Name="PART_ActionsHost" Margin="24,12,24,16"
                                Content="{TemplateBinding Actions}" ContentTemplate="{TemplateBinding ActionsTemplate}"
                                HorizontalContentAlignment="Left" VerticalContentAlignment="Center" />
              </StackPanel>
            </Grid>
          </Border>
        </Panel>
      </ControlTemplate>
    </Setter>

    <!-- Base surface shape and resting elevation; the modal/standard selectors below adjust them. -->
    <Style Selector="^ /template/ Border#PART_Surface">
      <Setter Property="CornerRadius" Value="28,28,0,0" />
      <Setter Property="BoxShadow" Value="{DynamicResource MaterialElevationLevel1Shadow}" />
    </Style>

    <!-- The current Material guidance shows rounded top corners for both standard and modal
         bottom sheets. ModalBottomSheet.kt supplies no resting shadow; the scrim separates it. -->
    <Style Selector="^[IsModal=True] /template/ Border#PART_Surface">
      <Setter Property="BoxShadow" Value="{DynamicResource MaterialElevationLevel0Shadow}" />
    </Style>
    <Style Selector="^[IsModal=False] /template/ Border#PART_Surface">
      <Setter Property="BoxShadow" Value="{DynamicResource MaterialElevationLevel1Shadow}" />
    </Style>
  </ControlTheme>

  <!-- Persistent scaffold from BottomSheetScaffold.kt: top bar row, body with the peek-height
       content inset, the standard bottom sheet over the body and the snackbar above the partial
       sheet. Placement order is the source z-order (body, top bar, sheet, snackbar); the body
       presenter is the only element that receives the peek padding, so it is never applied
       twice. -->
  <ControlTheme x:Key="{x:Type controls:MaterialBottomSheetScaffold}"
                TargetType="controls:MaterialBottomSheetScaffold">
    <Setter Property="Background" Value="{DynamicResource MaterialSurfaceBrush}" />
    <Setter Property="FontFamily" Value="{DynamicResource MaterialFontFamily}" />
    <Setter Property="FontSize" Value="{DynamicResource MaterialBodyMediumFontSize}" />
    <Setter Property="Foreground" Value="{DynamicResource MaterialOnSurfaceBrush}" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    <Setter Property="VerticalContentAlignment" Value="Stretch" />
    <Setter Property="Template">
      <ControlTemplate>
        <Panel Name="PART_Root" ClipToBounds="True" Background="{TemplateBinding Background}">
          <Grid RowDefinitions="Auto,*">
            <ContentControl Name="PART_TopBar"
                            Content="{TemplateBinding TopBar}"
                            ContentTemplate="{TemplateBinding TopBarTemplate}"
                            HorizontalContentAlignment="Stretch"
                            VerticalContentAlignment="Center" />
            <Panel Name="PART_Body" Grid.Row="1">
              <ContentPresenter Name="PART_ContentHost"
                                Padding="{TemplateBinding ContentPadding}"
                                Content="{TemplateBinding Content}"
                                ContentTemplate="{TemplateBinding ContentTemplate}"
                                HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}" />
              <ContentPresenter Name="PART_SheetHost"
                                HorizontalContentAlignment="Stretch"
                                VerticalContentAlignment="Stretch" />
              <ContentPresenter Name="PART_SnackbarHost"
                                HorizontalContentAlignment="Stretch"
                                VerticalContentAlignment="Stretch" />
            </Panel>
          </Grid>
        </Panel>
      </ControlTemplate>
    </Setter>
  </ControlTheme>
</ResourceDictionary>
