<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:controls="using:ExpressiveAvalonia.Controls"
                    xmlns:md="using:ExpressiveAvalonia.Theming"
                    xmlns:conv="using:Avalonia.Data.Converters">
  <!-- Lists.

       Geometry, typography, colors, selection and interaction shape are ported from AndroidX
       Material3 at 77b2199d6f056c2fe829ce25523c34a905e769c1: ListItem.kt,
       ListItemDefaults.kt and tokens/ListTokens.kt, for the interactive ListItem family.
       Source values used here:
         min heights 56 / 72 / 88 (one/two/three lines)      ListTokens.ItemOneLine/T...
         start+end padding 16                                ItemLeadingSpace / ItemTrailingSpace
         slot gap 12                                         ItemBetweenSpace
         top+bottom padding 12 for precision pointers        ListItemDefaults.ContentPadding
         extra-small -> medium (hover) -> large (selected, focus, press, drag) corner shapes
         surface / on-surface at rest; secondary-container / on-secondary-container selected;
         tertiary-container / on-tertiary-container dragged; on-surface @38% disabled
         leading and trailing slots use on-surface-variant at rest, on-secondary-container when
         selected, on-tertiary-container while dragged; ripple state layer uses the content color
         disabled state layer 0; ripple layer opacities 0.08/0.10/0.10/0.16.
       Interaction feedback is the shared theming:MaterialRipple (source RippleNode): a bounded press
       ripple from the pointer origin plus the hover/focus/drag state layer at those opacities, not a
       static layer. A row containing its own action (for example the accordion toggle) leaves that
       action's press to the action, exactly like a nested Compose clickable. The accordion toggle
       hosts the same ripple, so its press no longer fades a plain opacity border.
       Line count is derived by Theming.MaterialList from the slots and mirrored to
       md-list-1line/2line/3line classes (an explicit MaterialList.LineCount overrides it).

       The source corner morph (ListItem.kt shapeAnimationSpec = MotionScheme FastSpatial) is
       driven in code by MaterialList: the state styles only publish the target CornerRadius and
       MaterialCornerRadiusTransition springs every corner from the rendered value, retargeting
       an in-flight morph with its current velocity. The dragged shadow stays a static elevation
       setter. All functional geometry (heights, padding, thresholds, colors, selection) is
       source-exact. The swipe machinery lives in MaterialSwipeListItem; the base template only
       exposes the two layers so a plain ListBoxItem is unchanged.

       Extensions from the list design packages (not upstream Compose): monogram/image/video/
       avatar slots, leading indent, selected check, trailing badge, dividers, accordion body,
       pointer reordering, segmented list container and swipe action API. -->
  <x:String x:Key="MaterialListExpandText">Expand</x:String>
  <x:String x:Key="MaterialListCollapseText">Collapse</x:String>

  <ControlTheme x:Key="{x:Type ItemsControl}" TargetType="ItemsControl">
    <Setter Property="Template">
      <ControlTemplate>
        <ItemsPresenter Name="PART_ItemsPresenter" ItemsPanel="{TemplateBinding ItemsPanel}" />
      </ControlTemplate>
    </Setter>
  </ControlTheme>

  <ControlTheme x:Key="{x:Type ListBox}" TargetType="ListBox">
    <Setter Property="Background" Value="{DynamicResource MaterialSurfaceBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource MaterialOnSurfaceBrush}" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
    <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto" />
    <Setter Property="Template">
      <ControlTemplate>
        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{TemplateBinding CornerRadius}">
          <ScrollViewer Name="PART_ScrollViewer"
                        AllowAutoHide="{TemplateBinding (ScrollViewer.AllowAutoHide)}"
                        BringIntoViewOnFocusChange="{TemplateBinding (ScrollViewer.BringIntoViewOnFocusChange)}"
                        HorizontalScrollBarVisibility="{TemplateBinding (ScrollViewer.HorizontalScrollBarVisibility)}"
                        VerticalScrollBarVisibility="{TemplateBinding (ScrollViewer.VerticalScrollBarVisibility)}"
                        IsScrollChainingEnabled="{TemplateBinding (ScrollViewer.IsScrollChainingEnabled)}"
                        IsDeferredScrollingEnabled="{TemplateBinding (ScrollViewer.IsDeferredScrollingEnabled)}"
                        HorizontalSnapPointsType="{TemplateBinding (ScrollViewer.HorizontalSnapPointsType)}"
                        VerticalSnapPointsType="{TemplateBinding (ScrollViewer.VerticalSnapPointsType)}">
            <!-- Keep ListBox's native VirtualizingStackPanel and selection model. A custom
                 ContentTemplate is applied by the item presenter, never replaced by controls. -->
            <ItemsPresenter Name="PART_ItemsPresenter" Margin="{TemplateBinding Padding}"
                            ItemsPanel="{TemplateBinding ItemsPanel}" />
          </ScrollViewer>
        </Border>
      </ControlTemplate>
    </Setter>
    <!-- Extension: Segmented (filled) list container from the design package. -->
    <Style Selector="^[(md|MaterialList.Segmented)=True]">
      <Setter Property="Background" Value="{DynamicResource MaterialSurfaceContainerLowBrush}" />
      <Setter Property="CornerRadius" Value="{DynamicResource MaterialShapeLargeCornerRadius}" />
      <Setter Property="Padding" Value="2" />
    </Style>
    <!-- Extension: Draggable. -->
    <Style Selector="^[(md|MaterialList.AllowItemDrag)=True]">
      <Setter Property="Cursor" Value="Hand" />
    </Style>
  </ControlTheme>

  <!-- Shared list row. MaterialAccordionItem, MaterialSwipeListItem and MaterialDialogListItem
       reuse this theme through StyleKeyOverride or BasedOn, so selection and recycling are the
       native ListBoxItem ones. -->
  <ControlTheme x:Key="MaterialListItemBase" TargetType="ListBoxItem">
    <Setter Property="MinHeight" Value="56" />
    <!-- 16 start/end, 12 top/bottom (precision-pointer ListItemDefaults.ContentPadding). -->
    <Setter Property="Padding" Value="16,12" />
    <Setter Property="CornerRadius" Value="{DynamicResource MaterialShapeExtraSmallCornerRadius}" />
    <Setter Property="Background" Value="{DynamicResource MaterialSurfaceBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource MaterialOnSurfaceBrush}" />
    <Setter Property="FontSize" Value="{DynamicResource MaterialBodyLargeFontSize}" />
    <Setter Property="FontWeight" Value="{DynamicResource MaterialBodyLargeFontWeight}" />
    <!-- ListBoxItem has no LineHeight/LetterSpacing property; the headline row below applies the
         body-large typography tokens directly, and TextElement.LetterSpacing stays inherited. -->
    <Setter Property="TextElement.LetterSpacing" Value="{DynamicResource MaterialBodyLargeLetterSpacing}" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="Template">
      <ControlTemplate>
        <Panel Name="PART_Root" ClipToBounds="True">
          <!-- Swipe background layer. Empty for a plain row. -->
          <ContentPresenter Name="PART_SwipeBackground"
                            Content="{TemplateBinding (controls:MaterialSwipeListItem.BackgroundContent)}"
                            ContentTemplate="{TemplateBinding (controls:MaterialSwipeListItem.BackgroundTemplate)}"
                            HorizontalContentAlignment="Stretch"
                            VerticalContentAlignment="Stretch" />
          <!-- Swipe foreground layer; MaterialSwipeListItem translates this element. -->
          <!-- CornerRadius is applied by MaterialList's frame-driven MaterialCornerRadiusTransition
               (MotionScheme FastSpatial), so the state styles and the rendered shape stay apart:
               a style change retargets the spring instead of restarting a timed transition. -->
          <Border Name="PART_SwipeContent" Background="{TemplateBinding Background}"
                  BorderBrush="{TemplateBinding BorderBrush}"
                  BorderThickness="{TemplateBinding BorderThickness}"
                  ClipToBounds="True">
            <Grid RowDefinitions="Auto,Auto,Auto">
              <Panel Name="ContentPanel" Grid.Row="0">
                <Grid Name="ItemContent" ColumnDefinitions="Auto,*,Auto"
                      Margin="{TemplateBinding Padding}">
                  <!-- Leading building blocks: indent, monogram, image, video, avatar, content. -->
                  <StackPanel Name="LeadingColumn" Grid.Column="0" Orientation="Horizontal"
                              Margin="0,0,12,0"
                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}">
                    <Border Name="LeadingIndent" Width="{TemplateBinding (md:MaterialList.LeadingIndent)}"
                            Background="Transparent" />
                    <Border Name="LeadingMonogram" Width="40" Height="40" CornerRadius="9999"
                            Margin="0,0,12,0" VerticalAlignment="Center"
                            Background="{DynamicResource MaterialPrimaryContainerBrush}"
                            IsVisible="{Binding (md:MaterialList.LeadingMonogramText), RelativeSource={RelativeSource TemplatedParent}, Converter={x:Static conv:StringConverters.IsNotNullOrEmpty}}">
                      <TextBlock Text="{TemplateBinding (md:MaterialList.LeadingMonogramText)}"
                                 FontSize="{DynamicResource MaterialTitleSmallFontSize}"
                                 FontWeight="{DynamicResource MaterialTitleSmallFontWeight}"
                                 Foreground="{DynamicResource MaterialOnPrimaryContainerBrush}"
                                 HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <Border Name="LeadingImageHost" Width="56" Height="56" CornerRadius="4"
                            Margin="0,0,12,0" ClipToBounds="True" VerticalAlignment="Center"
                            Background="{DynamicResource MaterialSurfaceContainerHighBrush}"
                            IsVisible="{Binding (md:MaterialList.LeadingImage), RelativeSource={RelativeSource TemplatedParent}, Converter={x:Static conv:ObjectConverters.IsNotNull}}">
                      <Panel>
                        <Image Source="{TemplateBinding (md:MaterialList.LeadingImage)}" Stretch="UniformToFill" />
                        <Border Name="LeadingSelectedCheck" Width="24" Height="24" CornerRadius="9999"
                                Background="{DynamicResource MaterialSecondaryBrush}"
                                HorizontalAlignment="Center" VerticalAlignment="Center"
                                IsVisible="{TemplateBinding (md:MaterialList.IsLeadingSelected)}">
                          <Path Data="M9 16.2 4.8 12 3.4 13.4 9 19 21 7 19.6 5.6Z"
                                Fill="{DynamicResource MaterialOnSecondaryBrush}"
                                Width="14" Height="14" Stretch="Uniform" />
                        </Border>
                      </Panel>
                    </Border>
                    <Border Name="LeadingAvatarHost" Width="40" Height="40" CornerRadius="9999"
                            Margin="0,0,12,0" ClipToBounds="True" VerticalAlignment="Center"
                            Background="{DynamicResource MaterialSurfaceContainerHighBrush}"
                            IsVisible="{Binding (md:MaterialList.LeadingAvatar), RelativeSource={RelativeSource TemplatedParent}, Converter={x:Static conv:ObjectConverters.IsNotNull}}">
                      <Image Source="{TemplateBinding (md:MaterialList.LeadingAvatar)}" Stretch="UniformToFill" />
                    </Border>
                    <Border Name="LeadingVideoHost" Width="100" Height="56" CornerRadius="8"
                            Margin="0,0,12,0" ClipToBounds="True" VerticalAlignment="Center"
                            Background="{DynamicResource MaterialSurfaceContainerHighBrush}"
                            IsVisible="{Binding (md:MaterialList.LeadingVideoThumbnail), RelativeSource={RelativeSource TemplatedParent}, Converter={x:Static conv:ObjectConverters.IsNotNull}}">
                      <Image Source="{TemplateBinding (md:MaterialList.LeadingVideoThumbnail)}" Stretch="UniformToFill" />
                    </Border>
                    <ContentPresenter Name="LeadingContent"
                                      Content="{TemplateBinding (md:MaterialList.LeadingContent)}"
                                      VerticalAlignment="Center"
                                      TextElement.FontSize="{DynamicResource MaterialLabelMediumFontSize}"
                                      TextElement.FontWeight="{DynamicResource MaterialLabelMediumFontWeight}"
                                      TextElement.Foreground="{DynamicResource MaterialOnSurfaceVariantBrush}"
                                      IsVisible="{Binding (md:MaterialList.LeadingContent), RelativeSource={RelativeSource TemplatedParent}, Converter={x:Static conv:ObjectConverters.IsNotNull}}" />
                  </StackPanel>
                  <!-- Overline, headline, supporting text. -->
                  <StackPanel Name="TextContent" Grid.Column="1"
                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}">
                    <TextBlock Name="Overline" Text="{TemplateBinding (md:MaterialList.Overline)}"
                               FontSize="{DynamicResource MaterialLabelSmallFontSize}"
                               FontWeight="{DynamicResource MaterialLabelSmallFontWeight}"
                               LineHeight="{DynamicResource MaterialLabelSmallLineHeight}"
                               LetterSpacing="{DynamicResource MaterialLabelSmallLetterSpacing}"
                               Foreground="{DynamicResource MaterialOnSurfaceVariantBrush}"
                               TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"
                               IsVisible="{Binding (md:MaterialList.Overline), RelativeSource={RelativeSource TemplatedParent}, Converter={x:Static conv:StringConverters.IsNotNullOrEmpty}}" />
                    <ContentPresenter Name="ContentPresenter"
                                      Content="{TemplateBinding Content}"
                                      ContentTemplate="{TemplateBinding ContentTemplate}"
                                      TextElement.FontSize="{TemplateBinding FontSize}"
                                      TextElement.FontWeight="{TemplateBinding FontWeight}"
                                      TextElement.Foreground="{TemplateBinding Foreground}"
                                      IsVisible="{Binding (md:MaterialList.Headline), RelativeSource={RelativeSource TemplatedParent}, Converter={x:Static conv:StringConverters.IsNullOrEmpty}}" />
                    <TextBlock Name="Headline" Text="{TemplateBinding (md:MaterialList.Headline)}"
                               FontSize="{TemplateBinding FontSize}"
                               FontWeight="{TemplateBinding FontWeight}"
                               LineHeight="{DynamicResource MaterialBodyLargeLineHeight}"
                               LetterSpacing="{DynamicResource MaterialBodyLargeLetterSpacing}"
                               Foreground="{TemplateBinding Foreground}"
                               TextWrapping="Wrap"
                               IsVisible="{Binding (md:MaterialList.Headline), RelativeSource={RelativeSource TemplatedParent}, Converter={x:Static conv:StringConverters.IsNotNullOrEmpty}}" />
                    <TextBlock Name="SupportingText"
                               Text="{TemplateBinding (md:MaterialList.SupportingText)}"
                               FontSize="{DynamicResource MaterialBodyMediumFontSize}"
                               FontWeight="{DynamicResource MaterialBodyMediumFontWeight}"
                               LineHeight="{DynamicResource MaterialBodyMediumLineHeight}"
                               LetterSpacing="{DynamicResource MaterialBodyMediumLetterSpacing}"
                               Foreground="{DynamicResource MaterialOnSurfaceVariantBrush}"
                               TextWrapping="Wrap"
                               IsVisible="{Binding (md:MaterialList.SupportingText), RelativeSource={RelativeSource TemplatedParent}, Converter={x:Static conv:StringConverters.IsNotNullOrEmpty}}" />
                  </StackPanel>
                  <!-- Trailing metadata, badge, element and accordion toggle. -->
                  <StackPanel Name="TrailingColumn" Grid.Column="2" Orientation="Horizontal"
                              Margin="12,0,0,0"
                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}">
                    <TextBlock Name="TrailingSupportingText"
                               Text="{TemplateBinding (md:MaterialList.TrailingSupportingText)}"
                               VerticalAlignment="Center"
                               FontSize="{DynamicResource MaterialLabelSmallFontSize}"
                               FontWeight="{DynamicResource MaterialLabelSmallFontWeight}"
                               LineHeight="{DynamicResource MaterialLabelSmallLineHeight}"
                               LetterSpacing="{DynamicResource MaterialLabelSmallLetterSpacing}"
                               Foreground="{DynamicResource MaterialOnSurfaceVariantBrush}"
                               MaxLines="1" TextTrimming="CharacterEllipsis"
                               IsVisible="{Binding (md:MaterialList.TrailingSupportingText), RelativeSource={RelativeSource TemplatedParent}, Converter={x:Static conv:StringConverters.IsNotNullOrEmpty}}" />
                    <controls:MaterialBadge Text="{TemplateBinding (md:MaterialList.BadgeText)}"
                                            Margin="8,0,0,0" VerticalAlignment="Center"
                                            IsVisible="{Binding (md:MaterialList.BadgeText), RelativeSource={RelativeSource TemplatedParent}, Converter={x:Static conv:StringConverters.IsNotNullOrEmpty}}" />
                    <ContentPresenter Name="TrailingContent"
                                      Content="{TemplateBinding (md:MaterialList.TrailingContent)}"
                                      Margin="12,0,0,0" VerticalAlignment="Center"
                                      TextElement.FontSize="{DynamicResource MaterialLabelMediumFontSize}"
                                      TextElement.FontWeight="{DynamicResource MaterialLabelMediumFontWeight}"
                                      TextElement.Foreground="{DynamicResource MaterialOnSurfaceVariantBrush}"
                                      IsVisible="{Binding (md:MaterialList.TrailingContent), RelativeSource={RelativeSource TemplatedParent}, Converter={x:Static conv:ObjectConverters.IsNotNull}}" />
                    <ToggleButton Name="AccordionToggle" Theme="{DynamicResource MaterialAccordionButton}"
                                  Margin="8,0,0,0" VerticalAlignment="Center"
                                  IsChecked="{Binding (md:MaterialList.IsExpanded), RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"
                                  IsVisible="{Binding (md:MaterialList.ExpandedContent), RelativeSource={RelativeSource TemplatedParent}, Converter={x:Static conv:ObjectConverters.IsNotNull}}" />
                  </StackPanel>
                </Grid>
                <!-- Source RippleNode: the shared MaterialRipple draws the hover/focus/drag layer and the
                     bounded press ripple above the row content. Fill follows the content colour role
                     (including selected and dragged) and the node fades itself out when disabled. The
                     clip corner is pushed by MaterialList's FastSpatial shape motion, so the ripple
                     and the surface silhouette never disagree. -->
                <md:MaterialRipple Name="StateLayer"
                                   Fill="{TemplateBinding Foreground}"
                                   PressOpacity="{DynamicResource MaterialPressedStateLayerOpacity}"
                                   HoverOpacity="{DynamicResource MaterialHoverStateLayerOpacity}"
                                   FocusOpacity="{DynamicResource MaterialFocusStateLayerOpacity}"
                                   DraggedOpacity="{DynamicResource MaterialDraggedStateLayerOpacity}"
                                   IsDragging="{TemplateBinding (md:MaterialList.IsDragged)}"
                                   IsHitTestVisible="False" />
              </Panel>
              <!-- Extension: accordion body. Height measured by MaterialList; token duration is
                   zero under reduced motion. -->
              <Border Name="ExpandedHost" Grid.Row="1" MaxHeight="0" ClipToBounds="True"
                      IsHitTestVisible="False">
                <Border.Transitions>
                  <Transitions>
                    <DoubleTransition Property="MaxHeight"
                                      Duration="{DynamicResource MaterialDurationMedium2}"
                                      Easing="0.2,0,0,1" />
                  </Transitions>
                </Border.Transitions>
                <ContentPresenter Name="ExpandedContent" Content="{TemplateBinding (md:MaterialList.ExpandedContent)}"
                                  Margin="0,8,0,0" HorizontalContentAlignment="Stretch" />
              </Border>
              <!-- Extension: list dividers. -->
              <Border Name="Divider" Grid.Row="2" Height="1" Margin="16,0,16,0"
                      Background="{DynamicResource MaterialOutlineVariantBrush}"
                      IsVisible="False" IsHitTestVisible="False" />
            </Grid>
          </Border>
        </Panel>
      </ControlTemplate>
    </Setter>

    <!-- Source one/two/three line geometry, derived by MaterialList into classes. -->
    <Style Selector="^.md-list-1line">
      <Setter Property="MinHeight" Value="56" />
    </Style>
    <Style Selector="^.md-list-2line">
      <Setter Property="MinHeight" Value="72" />
    </Style>
    <Style Selector="^.md-list-3line">
      <Setter Property="MinHeight" Value="88" />
      <Setter Property="Padding" Value="16,12" />
      <Setter Property="VerticalContentAlignment" Value="Top" />
    </Style>

    <!-- Extension: explicit top alignment. -->
    <Style Selector="^[(md|MaterialList.IsTopAligned)=True]">
      <Setter Property="VerticalContentAlignment" Value="Top" />
    </Style>

    <!-- Extension: Segmented container. ListItemDefaults.segmentedShapes overrides only the rest
         shape's outer corners with ListTokens.ContainerShape (corner-large): the first item takes
         the top corners, the last item the bottom corners, a single item all four. MaterialList
         derives md-list-first/md-list-last/md-list-single from the live item index and count. The
         interaction shapes below still win over this rest shape, exactly like
         ListItemShapes.shapeForInteraction (pressed > dragged > selected > focused > hovered). -->
    <Style Selector="^[(md|MaterialList.Segmented)=True]">
      <Setter Property="Background" Value="{DynamicResource MaterialSurfaceContainerLowestBrush}" />
      <Setter Property="CornerRadius" Value="{DynamicResource MaterialShapeExtraSmallCornerRadius}" />
      <Setter Property="Margin" Value="0,0,0,2" />
    </Style>
    <Style Selector="^.md-list-first[(md|MaterialList.Segmented)=True]">
      <Setter Property="CornerRadius" Value="16,16,4,4" />
    </Style>
    <Style Selector="^.md-list-last[(md|MaterialList.Segmented)=True]">
      <Setter Property="CornerRadius" Value="4,4,16,16" />
    </Style>
    <Style Selector="^.md-list-single[(md|MaterialList.Segmented)=True]">
      <Setter Property="CornerRadius" Value="{DynamicResource MaterialShapeLargeCornerRadius}" />
    </Style>

    <!-- Source interaction shape: hovered 12, selected/focused/pressed/dragged 16. Later rules
         win, matching ListItemShapes.shapeForInteraction precedence
         (pressed > dragged > selected > focused > hovered > default). -->
    <Style Selector="^:pointerover">
      <Setter Property="CornerRadius" Value="{DynamicResource MaterialShapeMediumCornerRadius}" />
    </Style>
    <Style Selector="^:focus-visible">
      <Setter Property="CornerRadius" Value="{DynamicResource MaterialShapeLargeCornerRadius}" />
    </Style>

    <!-- Source selection. -->
    <Style Selector="^:selected">
      <Setter Property="Background" Value="{DynamicResource MaterialSecondaryContainerBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource MaterialOnSecondaryContainerBrush}" />
      <Setter Property="CornerRadius" Value="{DynamicResource MaterialShapeLargeCornerRadius}" />
    </Style>
    <Style Selector="^:selected /template/ TextBlock#Overline,
                       ^:selected /template/ TextBlock#SupportingText,
                       ^:selected /template/ TextBlock#TrailingSupportingText">
      <Setter Property="Foreground" Value="{DynamicResource MaterialOnSecondaryContainerBrush}" />
    </Style>
    <Style Selector="^:selected /template/ ContentPresenter#LeadingContent,
                       ^:selected /template/ ContentPresenter#TrailingContent">
      <Setter Property="TextElement.Foreground" Value="{DynamicResource MaterialOnSecondaryContainerBrush}" />
    </Style>

    <Style Selector="^[(md|MaterialList.IsDragged)=True]">
      <Setter Property="CornerRadius" Value="{DynamicResource MaterialShapeLargeCornerRadius}" />
      <Setter Property="Background" Value="{DynamicResource MaterialTertiaryContainerBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource MaterialOnTertiaryContainerBrush}" />
      <Setter Property="ZIndex" Value="100" />
    </Style>
    <Style Selector="^[(md|MaterialList.IsDragged)=True] /template/ Border#PART_SwipeContent">
      <Setter Property="BoxShadow" Value="{DynamicResource MaterialElevationLevel4Shadow}" />
    </Style>
    <Style Selector="^[(md|MaterialList.IsDragged)=True] /template/ TextBlock#Overline,
                       ^[(md|MaterialList.IsDragged)=True] /template/ TextBlock#SupportingText,
                       ^[(md|MaterialList.IsDragged)=True] /template/ TextBlock#TrailingSupportingText">
      <Setter Property="Foreground" Value="{DynamicResource MaterialOnTertiaryContainerBrush}" />
    </Style>
    <Style Selector="^[(md|MaterialList.IsDragged)=True] /template/ ContentPresenter#LeadingContent,
                       ^[(md|MaterialList.IsDragged)=True] /template/ ContentPresenter#TrailingContent">
      <Setter Property="TextElement.Foreground" Value="{DynamicResource MaterialOnTertiaryContainerBrush}" />
    </Style>
    <!-- pressed > dragged in the source precedence; both resolve to corner-large. -->
    <Style Selector="^:pressed">
      <Setter Property="CornerRadius" Value="{DynamicResource MaterialShapeLargeCornerRadius}" />
    </Style>

    <!-- Source disabled colors: container stays surface; every content role is on-surface @38%. -->
    <Style Selector="^:disabled">
      <Setter Property="Background" Value="{DynamicResource MaterialSurfaceBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource MaterialDisabledContentBrush}" />
      <Setter Property="Cursor" Value="Arrow" />
    </Style>
    <Style Selector="^:disabled /template/ TextBlock#Overline,
                       ^:disabled /template/ TextBlock#SupportingText,
                       ^:disabled /template/ TextBlock#TrailingSupportingText">
      <Setter Property="Foreground" Value="{DynamicResource MaterialDisabledContentBrush}" />
    </Style>
    <Style Selector="^:disabled /template/ ContentPresenter#LeadingContent,
                       ^:disabled /template/ ContentPresenter#TrailingContent">
      <Setter Property="TextElement.Foreground" Value="{DynamicResource MaterialDisabledContentBrush}" />
    </Style>

    <!-- Interaction is the shared MaterialRipple: it reads pointer, keyboard and drag input and
         the ListBoxItem's enabled state itself, so no style-driven layer state remains. The ripple
         fill follows Foreground (the content color role), and IsDragged drives the 16% drag layer
         through the template binding. -->

    <!-- Extension: dividers. -->
    <Style Selector="^[(md|MaterialList.ShowDividers)=True] /template/ Border#Divider">
      <Setter Property="IsVisible" Value="True" />
    </Style>
    <Style Selector="^[(md|MaterialList.ShowDivider)=True] /template/ Border#Divider">
      <Setter Property="IsVisible" Value="True" />
    </Style>
  </ControlTheme>

  <ControlTheme x:Key="{x:Type ListBoxItem}" TargetType="ListBoxItem"
                BasedOn="{StaticResource MaterialListItemBase}" />

  <!-- Extension: accordion toggle from the list design package. -->
  <ControlTheme x:Key="MaterialAccordionButton" TargetType="ToggleButton">
    <Setter Property="Width" Value="40" />
    <Setter Property="Height" Value="40" />
    <Setter Property="Padding" Value="8" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{DynamicResource MaterialOnSurfaceVariantBrush}" />
    <Setter Property="CornerRadius" Value="9999" />
    <Setter Property="Focusable" Value="True" />
    <Setter Property="Template">
      <ControlTemplate>
        <Border Background="{TemplateBinding Background}" CornerRadius="{TemplateBinding CornerRadius}">
          <Panel>
            <Path Name="Chevron" Width="20" Height="20" Stretch="Uniform"
                  HorizontalAlignment="Center" VerticalAlignment="Center"
                  Fill="{TemplateBinding Foreground}"
                  Data="M7.4 8.6 12 13.2 16.6 8.6 18 10 12 16 6 10Z" />
            <!-- The toggle is its own interactive target: the shared MaterialRipple paints its
                 press ripple and hover/focus layer, clipped to the pill, so it stays independent
                 of the row ripple and there is no plain opacity layer to fade. -->
            <md:MaterialRipple Name="StateLayer"
                               Fill="{TemplateBinding Foreground}"
                               CornerRadius="{TemplateBinding CornerRadius}"
                               PressOpacity="{DynamicResource MaterialPressedStateLayerOpacity}"
                               HoverOpacity="{DynamicResource MaterialHoverStateLayerOpacity}"
                               FocusOpacity="{DynamicResource MaterialFocusStateLayerOpacity}"
                               DraggedOpacity="{DynamicResource MaterialDraggedStateLayerOpacity}"
                               IsHitTestVisible="False" />
          </Panel>
        </Border>
      </ControlTemplate>
    </Setter>
    <Style Selector="^:checked /template/ Path#Chevron">
      <Setter Property="RenderTransform" Value="rotate(180deg)" />
    </Style>
  </ControlTheme>

  <!-- Extension: headline text block from the list design package. -->
  <ControlTheme x:Key="MaterialHeadline" TargetType="ContentControl">
    <Setter Property="FontSize" Value="{DynamicResource MaterialTitleMediumFontSize}" />
    <Setter Property="FontWeight" Value="{DynamicResource MaterialTitleMediumFontWeight}" />
    <Setter Property="Foreground" Value="{DynamicResource MaterialOnSurfaceBrush}" />
    <Setter Property="Template">
      <ControlTemplate>
        <ContentPresenter Content="{TemplateBinding Content}"
                          ContentTemplate="{TemplateBinding ContentTemplate}" />
      </ControlTemplate>
    </Setter>
  </ControlTheme>
</ResourceDictionary>