<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <PackageId>ExpressiveAvalonia</PackageId>
    <Version>0.1.0</Version>
    <Description>Material Design 3 theme and controls for Avalonia.</Description>
    <PackageLicenseExpression>MIT AND Apache-2.0 AND OFL-1.1 AND CC-BY-4.0</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <IsPackable>true</IsPackable>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.1.4" />
    <PackageReference Include="Shirasagi0012.MaterialColorUtilities" Version="0.2.0" />
    <AvaloniaResource Include="Assets/Fonts/*.ttf" />
    <AvaloniaResource Include="Assets/DesignSystem/**/*" />
    <AvaloniaResource Include="Assets/Avatars/**/*" />
    <None Include="../../README.md" Pack="true" PackagePath="/" />
    <None Include="../../NOTICE" Pack="true" PackagePath="/" />
    <None Include="../../LICENSE" Pack="true" PackagePath="/" />
    <None Include="../../licenses/*.txt" Pack="true" PackagePath="licenses/" />
  </ItemGroup>
</Project>
